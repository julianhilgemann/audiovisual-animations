    type: toptoCHOP
    parameters:
      top: glsl_stats
      rate: =me.time.rate
      autoexportroot: =parent()
    position: [3600, -2000]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: videoin_cam
    type: videodeviceinTOP
    parameters:
      active: =parent.Reactor.par.Camera
      device: V1|||\\?\usb#vid_3277&pid_0010&mi_00#7&df5034d&0&0000#{65e8773d-8f56-11d0-a3b9-00a0c9223196}\global|||0|||0|||ASUS FHD webcam
      signalformat: f1920x1080p-30.00hz
      outputresolution: half
    flags:
    - bypass
    position: [0, -1400]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: glsl_bg_info
    type: infoDAT
    parameters:
      op: glsl_bg
    position: [1525, -1320]
    dock: glsl_bg
    dat_read_only: true
  - name: blur_presence
    type: blurTOP
    parameters:
      size: 6
    position: [3200, -1600]
    inputs:
    - null_presence
  - name: feedback_prev
    type: feedbackTOP
    parameters:
      top: null_cam
    position: [1200, -1600]
    inputs:
    - null_cam
  - name: glsl_bg_pixel
    type: textDAT
    parameters:
      file: project1/musicvideo/sense/glsl_bg_pixel.glsl
      syncfile: true
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [1675, -1320]
    color: [0.9, 0.3, 0.4]
    tags:
    - glsl
    dock: glsl_bg
  - name: glsl_presence
    type: glslmultiTOP
    parameters:
      pixeldat: glsl_presence_pixel
      outputresolution: custom
      resolutionw: 128
      resolutionh: 128
      format: rgba16float
    sequences:
      vec:
      - name: uKey
        valuex: =parent.Reactor.par.Modthreshold
        valuey: =parent.Reactor.par.Modsoftness
        valuez: =parent.Reactor.par.Modkey.menuIndex
        valuew: 0.3
      - name: uMotion
        valuex: =math.exp(-1.0 / max(1.0, parent.Reactor.par.Modtrail * me.time.rate))
        valuey: 0.12
        valuew: =float(parent.Reactor.par.Modon)
    position: [2400, -1600]
    inputs:
    - null_cam
    - null_bg
    - feedback_prev
    - feedback_presence
  - name: null_features
    type: nullCHOP
    position: [4800, -400]
    inputs:
    - script_features
  - name: null_presence
    type: nullTOP
    position: [2800, -1600]
    inputs:
    - glsl_presence
  - name: audiodevin_mic
    type: audiodeviceinCHOP
    parameters:
      active: =parent.Reactor.par.Mic
      autoexportroot: =parent()
    flags:
    - bypass
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: null_trackmono
    type: nullCHOP
    position: [-400, 1200]
    inputs:
    - math_mono
  - name: glsl_stats_info
    type: infoDAT
    parameters:
      op: glsl_stats
    position: [3125, -2120]
    dock: glsl_stats
    dat_read_only: true
  - name: moviefilein_mod
    type: moviefileinTOP
    parameters:
      file: =parent.Reactor.par.Videofile.eval() or (app.samplesFolder + '/Map/Count.mov')
      play: =parent.Reactor.par.Modon
      speed: =parent.Reactor.par.Modspeed * (1.0 + parent.Reactor.par.Spinreact * min(1.0, 4.0 * float(op('lag_spin')[0] or 0)))
      index: =me.time.frame
      timecodeop: =tdu.Timecode()
    position: [-800, -1200]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: script_features
    type: scriptCHOP
    parameters:
      callbacks: script_features_callbacks
    position: [4400, -400]
    inputs:
    - merge_bands
    - topto_stats
  - name: glsl_stats_pixel
    type: textDAT
    parameters:
      file: project1/musicvideo/sense/glsl_stats_pixel.glsl
      syncfile: true
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [3275, -2120]
    color: [0.9, 0.3, 0.4]
    tags:
    - glsl
    dock: glsl_stats
  - name: null_micspectrum
    type: nullCHOP
    position: [800, -400]
    inputs:
    - audiospectrum_mic
  - name: audiodevout_track
    type: audiodeviceoutCHOP
    parameters:
      active: =parent.Reactor.par.Play
      volume: =parent.Reactor.par.Trackvolume
    position: [-800, 1600]
    inputs:
    - audiofilein_track
  - name: audiofilein_track
    type: audiofileinCHOP
    parameters:
      file: =parent.Reactor.par.Audiofile.eval() or (app.samplesFolder + '/Audio/JeremyCaulfield_www.dumb-unit.com.mp3')
      play: =parent.Reactor.par.Play
      index: =me.time.frame / root.time.rate
      timecodeop: =tdu.Timecode()
      repeat: ='on' if parent.Reactor.par.Loop else 'off'
      autoexportroot: =parent()
    position: [-1200, 1200]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: audiospectrum_mic
    type: audiospectrumCHOP
    position: [400, -400]
    inputs:
    - audiodevin_mic
  - name: feedback_presence
    type: feedbackTOP
    parameters:
      top: null_presence
    position: [1200, -2000]
    inputs:
    - const_black
  - name: glsl_presence_info
    type: infoDAT
    parameters:
      op: glsl_presence
    position: [2325, -1720]
    dock: glsl_presence
    dat_read_only: true
  - name: null_presence_soft
    type: nullTOP
    position: [3600, -1600]
    inputs:
    - blur_presence
  - name: null_trackspectrum
    type: nullCHOP
    position: [400, 1200]
    inputs:
    - audiospectrum_track
  - name: audiospectrum_track
    type: audiospectrumCHOP
    parameters:
      outlength: 8192
    position: [0, 1200]
    inputs:
    - null_trackmono
  - name: glsl_presence_pixel
    type: textDAT
    parameters:
      file: project1/musicvideo/sense/glsl_presence_pixel.glsl
      syncfile: true
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [2475, -1720]
    color: [0.9, 0.3, 0.4]
    tags:
    - glsl
    dock: glsl_presence
  - name: script_features_callbacks
    type: textDAT
    parameters:
      file: project1/musicvideo/sense/script_features_callbacks.py
      syncfile: true
      language: python
    flags:
    - viewer
    position: [4400, -520]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
    dock: script_features
  annotations:
  - name: annotate1
    mode: annotate
    title: Track bands + video spin (mic parked)
    text: 'null_trackmono -> low < 250 Hz / mid ~1 kHz / high > 4 kHz -> merge_bands for script_features. analyze_low + lag_spin: low-band RMS that speeds up the modulator video (kept outside script_features to avoid a cook loop through the video stats). audiodevin_mic + audiospectrum_mic: the installation''s room microphone, bypassed.'
    position: [-70, -470]
    size: [1400, 1130]
    color: [0.27, 0.12, 0.27]
  - name: annotate2
    mode: annotate
    title: 'Modulator video: mask + motion (128x128)'
    text: 'moviefilein_mod (Video File, speed = Video Speed x low band) -> fit_mod crops to a 128x128 square -> null_cam. glsl_presence: R mask (Key: bright parts / dark parts / difference to the learned background of glsl_bg), G motion trail, B luma. glsl_stats folds it into one pixel -> topto_stats. videoin_cam + res_cam: the installation''s webcam, bypassed.'
    position: [-870, -2190]
    size: [4670, 1250]
    color: [0.08, 0.26, 0.28]
  - name: annotate3
    mode: annotate
    title: Track + video features
    text: 'script_features: low mid high level transient energy (each normalised against the track''s own running floor and peak; energy = slow loudness, the song structure) + presence prox cx cy motion of the video mask, 0-1 each -> null_features.'
    position: [4330, -590]
    size: [670, 450]
    color: [0.28, 0.22, 0.08]
  - name: annotate4
    mode: annotate
    title: 'Track: playback + analysis'
    text: audiofilein_track (Audio File; Play, Loop, Restart) -> audiodevout_track (Volume) and math_mono (average of the channels) -> null_trackmono = the waveform (one frame of samples, read by viz/chopto_scope) -> audiospectrum_track (8192-pt FFT, one sample per Hz) -> null_trackspectrum (viz sonogram).
    position: [-1270, 1130]
    size: [1870, 730]
    color: [0.1, 0.1, 0.12]
- name: engine
  type: baseCOMP
  flags:
  - -allowCooking
  position: [595, 195]
  inputs:
  - data
  children:
  - name: math_vca
    type: mathCHOP
    parameters:
      chopop: mul
      gain: =parent.Reactor.par.Volume
    position: [3400, -2600]
    inputs:
    - audiofilter_vcf
  - name: in_series
    type: inDAT
    parameters:
      label: =me.name
    position: [200, 0]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    dat_read_only: true
  - name: lag_glide
    type: lagCHOP
    parameters:
      lag1: =parent.Reactor.par.Glide
      lag2: =parent.Reactor.par.Glide
    position: [1800, -2600]
    inputs:
    - select_pitch
  - name: limit_out
    type: limitCHOP
    parameters:
      type: clamp
      autoexportroot: =parent()
      renameto: audio
    position: [3800, -2600]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - math_vca
  - name: null_audio
    type: nullCHOP
    position: [4200, -2600]
    inputs:
    - limit_out
  - name: null_scope
    type: nullCHOP
    position: [5800, -3800]
    inputs:
    - script_scope
  - name: speed_scan
    type: speedCHOP
    parameters:
      max: 100000
    position: [600, -400]
    inputs:
    - const_scanrate
  - name: const_drift
    type: constantCHOP
    sequences:
      const:
      - name: d1
        value: =parent.Reactor.par.Driftrate
      - name: d2
        value: =parent.Reactor.par.Driftrate * 0.382
    position: [200, -2200]
  - name: lookup_wave
    type: lookupCHOP
    parameters:
      index1: -1
      cyclic: 'yes'
      autoexportroot: =parent()
    position: [2600, -2600]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - audioosc_phase
    - select_table
  - name: merge_scope
    type: mergeCHOP
    position: [4600, -3800]
    inputs:
    - null_audio
    - audioosc_phase
  - name: null_series
    type: nullCHOP
    position: [1000, 0]
    inputs:
    - datto_series
  - name: speed_drift
    type: speedCHOP
    position: [600, -2200]
    inputs:
    - const_drift
  - name: trail_scope
    type: trailCHOP
    parameters:
      wlength: 8192
      wlengthunit: samples
      rate: =me.time.rate
      autoexportroot: =parent()
    position: [5000, -3800]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - merge_scope
  - name: const_cutoff
    type: constantCHOP
    sequences:
      const:
      - name: cutofffrequency
        value: =min(18000.0, max(20.0, parent.Reactor.par.Cutoff * 2.0 ** (parent.Reactor.par.Drift * (0.7 * math.sin(6.2831853 * op('speed_drift')['d1']) + 0.3 * math.sin(6.2831853 * op('speed_drift')['d2'])) + parent.Reactor.par.Proxcutoff * op('select_features')['prox'])))
    position: [1000, -2200]
  - name: datto_series
    type: dattoCHOP
    parameters:
      dat: in_series
      rowindexend: =me.inputTable.numRows - 1
      rowexpr: =re.match('.*',me.inputCell.val) != None
      extractcols: bynames
      colindexend: =me.inputTable.numCols - 1
      colnames: t value_bn
      colexpr: =re.match('.*',me.inputCell.val) != None
      output: chanpercol
      firstrow: names
      firstcolumn: values
      autoexportroot: =parent()
    position: [600, 0]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: script_scope
    type: scriptCHOP
    parameters:
      callbacks: script_scope_callbacks
    position: [5400, -3800]
    inputs:
    - trail_scope
  - name: select_pitch
    type: selectCHOP
    parameters:
      channames: hz
    position: [1400, -2600]
    inputs:
    - script_window
  - name: select_table
    type: selectCHOP
    parameters:
      channames: shaped
    position: [2200, -400]
    inputs:
    - null_wavetable
  - name: null_spectrum
    type: nullCHOP
    position: [5000, -3400]
    inputs:
    - audiospectrum_out
  - name: script_window
    type: scriptCHOP
    parameters:
      callbacks: script_window_callbacks
    position: [1000, -400]
    inputs:
    - speed_scan
  - name: wavetable_lib
    type: textDAT
    parameters:
      file: project1/musicvideo/engine/wavetable_lib.py
      syncfile: true
      language: python
    position: [1400, 0]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
  - name: audioosc_phase
    type: audiooscillatorCHOP
    parameters:
      wavetype: ramp
      frequency: =op('lag_glide')['hz']
      autoexportroot: =parent()
      renamefrom: chan1
      renameto: phase
    position: [2200, -2600]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: const_scanrate
    type: constantCHOP
    sequences:
      const:
      - name: rate
        value: =(-1.0 if parent.Reactor.par.Scandir.eval() == 'backward' else 1.0) * (parent.Reactor.par.Scanrate * parent.Reactor.par.Scan + parent.Reactor.par.Motionscan * op('select_features')['motion'])
    position: [200, -400]
  - name: null_wavetable
    type: nullCHOP
    position: [1800, -400]
    inputs:
    - script_wavetable
  - name: audiofilter_vcf
    type: audiofilterCHOP
    parameters:
      filter: =parent.Reactor.par.Filtertype
      cutofflog: 2.69897
      cutofffrequency: =parent.Reactor.par.Cutoff
      resonance: =parent.Reactor.par.Resonance
      rolloff: =float(parent.Reactor.par.Rolloff.eval())
    position: [3000, -2600]
    inputs:
    - lookup_wave
    - const_cutoff
  - name: select_features
    type: selectCHOP
    parameters:
      chops: ../sense/null_features
    position: [200, -800]
  - name: audiodevout_main
    type: audiodeviceoutCHOP
    parameters:
      active: =parent.Reactor.par.Audio
    position: [4600, -2600]
    inputs:
    - null_audio
  - name: script_wavetable
    type: scriptCHOP
    parameters:
      callbacks: script_wavetable_callbacks
    position: [1400, -400]
    inputs:
    - script_window
  - name: audiospectrum_out
    type: audiospectrumCHOP
    parameters:
      outlength: 8192
    position: [4600, -3400]
    inputs:
    - null_audio
  - name: script_scope_callbacks
    type: textDAT
    parameters:
      file: project1/musicvideo/engine/script_scope_callbacks.py
      syncfile: true
      language: python
    flags:
    - viewer
    position: [5400, -3920]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
    dock: script_scope
  - name: script_window_callbacks
    type: textDAT
    parameters:
      file: project1/musicvideo/engine/script_window_callbacks.py
      syncfile: true
      language: python
    flags:
    - viewer
    position: [1000, -520]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
    dock: script_window
  - name: script_wavetable_callbacks
    type: textDAT
    parameters:
      file: project1/musicvideo/engine/script_wavetable_callbacks.py
      syncfile: true
      language: python
    flags:
    - viewer
    position: [1400, -520]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
    dock: script_wavetable
  annotations:
  - name: annotate1
    mode: annotate
    title: 'Wavetable: series window -> single cycle (numpy)'
    text: speed_scan slides the window (Scan, Scan Direction; camera motion adds speed via select_features). script_window resolves start / length / pitch, offset by the visitor's horizontal position. script_wavetable builds the 2048-sample cycle via wavetable_lib (detrend, loop, interpolate, shape with Drive + room level, band-limit).
    position: [130, -990]
    size: [2670, 1250]
    color: [0.08, 0.26, 0.28]
  - name: annotate2
    mode: annotate
    title: 'Voice: drone oscillator, drifting filter, audio out'
    text: 'A drone: no gate, no envelopes. lag_glide -> audioosc_phase ramp -> lookup_wave reads the table -> audiofilter_vcf -> math_vca (x Volume) -> limit_out (+/-1) -> audio device. const_cutoff = Cutoff x 2^(Drift x two de-synced sines of speed_drift + Proximity->Cutoff x prox) into the filter''s modulation input.'
    position: [130, -2670]
    size: [4670, 730]
    color: [0.27, 0.12, 0.27]
  - name: annotate3
    mode: annotate
    title: 'Analysis: spectrum + synced scope'
    text: 'audiospectrum_out: 8192-pt FFT, one sample per Hz (0-22050). script_scope cuts the last two whole cycles from trail_scope using the oscillator phase, so the trace is trigger-stable.'
    position: [4530, -3990]
    size: [1470, 850]
    color: [0.28, 0.22, 0.08]
- name: MusicVideoExt
  type: textDAT
  parameters:
    file: project1/musicvideo/MusicVideoExt.py
    syncfile: true
    language: python
  position: [200, 800]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
- name: parexec_reactor
  type: parameterexecuteDAT
  parameters:
    fromop: =parent()
    op: ..
    pars: '* ^Mon*'
    builtin: false
    file: project1/musicvideo/parexec_reactor.py
    syncfile: true
  position: [600, 800]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
annotations:
- name: annotate1
  mode: annotate
  title: Control
  text: MusicVideoExt owns the music-video parameter schema (Track, Modulator, Form, Camera, Finish; the installation's pages stay at the end), Restart and Capture Background; parexec_reactor routes pulses/changes to _on<Par> handlers (Mon* monitors excluded).
  position: [130, 730]
  size: [670, 330]
  color: [0.2, 0.2, 0.28]
- name: annotate2
  mode: annotate
  title: 'Pipeline: sense -> viz (data + engine parked)'
  text: 'sense: the audio file (playback, bands, energy, transients, spectrum, waveform) and the modulator video (mask, motion) -> null_features / null_presence_soft. viz: sonogram/waveform history -> 3D point cloud (sheet, tunnel, disc) -> square 1080x1080 -> out1. data (Bundesbank series) and engine (wavetable drone) are the installation''s, kept with cooking off.'
  position: [125, -275]
  size: [1470, 770]
  color: [0.08, 0.2, 0.28]
