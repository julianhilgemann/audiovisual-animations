    sequences:
      vec:
      - name: uLearn
        valuex: =(1.0 - math.exp(-1.0 / (parent.Reactor.par.Bglearn * me.time.rate))) if parent.Reactor.par.Bglearn > 0 else 0.0
    position: [1600, -1200]
