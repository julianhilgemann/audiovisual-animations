format: tdxn
version: '2.1'
build: 5
generator: Embody/6.2.68
td_build: 099.2025.32820
network_path: /project1/musicvideo
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  audiodeviceoutCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  audiofilterCHOP:
    parameters:
      autoexportroot: =parent()
      units: frequency
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  audiospectrumCHOP:
    parameters:
      autoexportroot: =parent()
      frequencylog: 0
      highfreqboost: 0
      outputmenu: setmanually
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  baseCOMP:
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
  blurTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  choptoTOP:
    parameters:
      format: rgba32float
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  constantCHOP:
    parameters:
      autoexportroot: =parent()
      rate: =me.time.rate
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  constantTOP:
    parameters:
      alpha: 0
      colorb: 0
      colorg: 0
      colorr: 0
      format: rgba16float
      outputresolution: custom
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  feedbackTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  glslTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  glslmultiTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  infoDAT:
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  lagCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  mathCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  mergeCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  nullCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  nullTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  outDAT:
    parameters:
      label: =me.name
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  outTOP:
    parameters:
      label: =me.name
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  renderselectTOP:
    parameters:
      bufferindex: 1
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  scriptCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  scriptDAT:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  selectCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  selectTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  speedCHOP:
    parameters:
      autoexportroot: =parent()
      limittype: loop
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  textDAT:
    size: [130, 90]
type: baseCOMP
custom_pars:
  Track:
  - name: Audiofile
    style: File
    label: Audio File
    help: 'The track (wav, aif, mp3). Empty = the TouchDesigner sample track. It is played out and analysed: bands, energy, transients, spectrum and waveform drive everything.'
  - name: Play
    style: Toggle
    default: true
    help: Play the track (and the modulator video). Off pauses both.
  - name: Restart
    style: Pulse
    help: Jump the track and the modulator video back to the start.
  - name: Loop
    style: Toggle
    default: true
    help: Start the track again when it ends.
  - name: Trackvolume
    style: Float
    label: Volume
    default: 0.8
    clampMin: true
    clampMax: true
    help: Playback volume to the default audio device (analysis is not affected).
    value: 1
  - name: Trackgain
    style: Float
    label: Analysis Gain (dB)
    startSection: true
    min: -24.0
    max: 24.0
    clampMin: true
    clampMax: true
    normMin: -12.0
    normMax: 12.0
    help: 'Gain before the band levels are measured: raise it for a quiet master, lower it for a loud one.'
    value: -6.8400001526
  - name: Specgain
    style: Float
    label: Spectrum Gain (dB)
    min: -24.0
    max: 24.0
    clampMin: true
    clampMax: true
    normMin: -12.0
    normMax: 12.0
    help: Gain of the spectrum written into the sonogram history (brightness of the frequency content).
    value: 0.8999999762
  - name: Adapt
    style: Float
    label: Floor Adapt (s)
    default: 6
    max: 60.0
    clampMin: true
    clampMax: true
    normMax: 20.0
    help: 'Time the adaptive floor needs to absorb a constant level, so a loud master still moves the image: only what rises above the floor counts. 0 = absolute levels.'
    value: 12.0600004196
  - name: Release
    style: Float
    label: Band Release (s)
    default: 0.25
    min: 0.01
    max: 4.0
    clampMin: true
    clampMax: true
    help: Release time of the band envelopes (attack is fixed and fast).
    value: 0.9879999757
  Modulator:
  - name: Videofile
    style: File
    label: Video File
    help: 'The modulator video (a spinning record, any footage). Empty = the TouchDesigner sample countdown. It is never shown directly: it keys a mask that displaces and lights the cloud.'
    value: C:/Users/Julian-SebastianHilg/Downloads/sample-4.mp4
  - name: Modon
    style: Toggle
    label: Video On
    default: true
    help: Use the modulator video. Off = no mask, no motion.
    value: false
  - name: Modspeed
    style: Float
    label: Video Speed
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Playback speed of the video.
    value: 2
  - name: Spinreact
    style: Float
    label: Low -> Video Speed
    default: 0.6
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: The low band speeds the video up (the record spins faster on the kick).
    value: 0.3459999859
  - name: Modkey
    style: Menu
    label: Key
    startSection: true
    default: luma
    menuNames:
    - luma
    - dark
    - bgdiff
    menuLabels:
    - Bright parts
    - Dark parts
    - Difference to background
    help: 'What of the video becomes the mask: its bright parts, its dark parts, or the difference to a learned background.'
  - name: Modthreshold
    style: Float
    label: Key Threshold
    default: 0.35
    clampMin: true
    clampMax: true
    help: Brightness (or difference) at the middle of the soft key.
    value: 0.2300000042
  - name: Modsoftness
    style: Float
    label: Key Softness
    default: 0.2
    min: 0.001
    max: 0.5
    clampMin: true
    clampMax: true
    help: 'Width of the soft edge of the key: wide = greyscale mask, narrow = hard silhouette.'
    value: 0.2660000026
  - name: Modtrail
    style: Float
    label: Motion Trail (s)
    default: 0.4
    min: 0.05
    max: 5.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Seconds the motion trail of the video takes to fade.
    value: 1.4149999619
  - name: Modmirror
    style: Toggle
    label: Mirror
    help: Mirror the video horizontally.
    value: true
  - name: Vidshow
    style: Float
    label: Video in Points
    startSection: true
    default: 0.5
    clampMin: true
    clampMax: true
    help: 'How much the mask lights the points: 0 = the sound alone sets brightness, 1 = the video is drawn by the points.'
    value: 0.0810000002
  - name: Ghost
    style: Float
    label: Video Ghost
    clampMin: true
    clampMax: true
    help: Faint monochrome overlay of the video itself behind the cloud.
  Form:
  - name: Form
    style: Menu
    default: tunnel
    menuNames:
    - sheet
    - tunnel
    - disc
    menuLabels:
    - Sheet (sonogram wall)
    - Tunnel (fly through)
    - Disc (record)
    help: 'Shape the history is laid out in. Sheet: time across the screen. Tunnel: time is depth, the sound comes at the camera and the frequencies wrap around. Disc: time is the angle, frequency the radius, like grooves on a record.'
  - name: Morph
    style: Float
    default: 1
    clampMin: true
    clampMax: true
    help: Blend from the sheet (0) to the chosen form (1). Animate it for transitions.
  - name: Symmetry
    style: Int
    default: 1
    min: 1.0
    max: 12.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 8.0
    help: Mirrors the frequency axis N times around the tunnel or disc (kaleidoscope). 1 = none.
    value: 8
  - name: Tunnellength
    style: Float
    label: Tunnel Length
    default: 30
    min: 4.0
    max: 80.0
    clampMin: true
    clampMax: true
    normMin: 8.0
    normMax: 60.0
    help: Depth of the tunnel in world units (the camera sits 5.4 in front of the origin).
    value: 32.5
  - name: Twist
    style: Float
    startSection: true
    default: 0.6
    min: -4.0
    max: 4.0
    clampMin: true
    clampMax: true
    normMin: -2.0
    normMax: 2.0
    help: Turns of twist along the history (tunnel, disc); the mid band adds Mid -> Twist.
    value: -0.0299999993
  - name: Twistreact
    style: Float
    label: Mid -> Twist
    default: 0.5
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Extra twist from the mid band.
    value: 0.0120000001
  - name: Lowpump
    style: Float
    label: Low -> Pump
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: The low band inflates the form (tunnel radius, disc and sheet depth).
    value: 0
  - name: Warp
    style: Float
    default: 1
    max: 6.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: 4D noise that bends the whole form; the track energy scales it up.
    value: 0
  Camera:
  - name: Distance
    style: Float
    default: 5.4
    min: 0.2
    max: 20.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 12.0
    help: Camera distance from the origin; the camera orbits the origin. Small values put it inside the cloud.
    value: 5.3699998856
  - name: Tilt
    style: Float
    label: Tilt (deg)
    default: -9
    min: -90.0
    max: 90.0
    clampMin: true
    clampMax: true
    normMin: -60.0
    normMax: 60.0
    help: Base pitch of the camera (negative = looking down onto the form).
    value: -1.6000000238
  - name: Fov
    style: Float
    label: Field of View (deg)
    default: 50
    min: 10.0
    max: 120.0
    clampMin: true
    clampMax: true
    normMin: 20.0
    normMax: 100.0
    help: 'Lens: small = long lens, flat and graphic; large = wide, deep perspective.'
    value: 90.9000015259
  - name: Push
    style: Float
    label: Energy -> Push
    startSection: true
    default: 0.5
    max: 2.0
    clampMin: true
    clampMax: true
    help: The camera dollies in when the track is loud (drops) and backs off in breakdowns.
    value: 0.003
  - name: Flyreact
    style: Float
    label: Energy -> Fly
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Track energy speeds up the flow of the history (the flight through the tunnel).
    value: 0
  - name: Shake
    style: Float
    label: Transient -> Shake
    default: 0.5
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Camera jolt on transients (kicks, snares).
    value: 0
  - name: Fovpunch
    style: Float
    label: Transient -> Zoom
    default: 0.3
    max: 2.0
    clampMin: true
    clampMax: true
    help: Short wide-angle punch of the lens on transients.
    value: 0
  - name: Roll
    style: Float
    default: 0.3
    max: 3.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Slow roll swing of the camera; the track energy speeds it up.
    value: 0.8539999723
  Visual:
  - name: Palette
    style: Menu
    label: Color Scale
    default: steel
    menuNames:
    - inferno
    - magma
    - viridis
    - turbo
    - ice
    - mono
    - steel
    - signal
    menuLabels:
    - Inferno
    - Magma
    - Viridis
    - Turbo
    - Ice
    - Mono (warm white)
    - Steel (neutral white)
    - Signal (white, red peaks)
    help: Color scale the sonogram level is mapped through (quiet -> loud). Steel and Mono are monochrome; Signal keeps one red accent on the loudest peaks.
    value: turbo
  - name: Paletteshift
    style: Float
    label: Scale Offset
    min: -1.0
    clampMin: true
    clampMax: true
    normMin: -0.5
    normMax: 0.5
    help: 'Slides the level along the color scale: positive values show quieter content brighter, negative values darken everything but the peaks.'
    value: -0.0130000003
  - name: Contrast
    style: Float
    label: Level Contrast
    default: 2
    min: 0.2
    max: 4.0
    clampMin: true
    clampMax: true
    normMin: 0.4
    normMax: 3.0
    help: Gamma on the sonogram level before the color scale (1 = linear dB; higher hides the quiet bins and isolates the strong partials).
    value: 3
  - name: Direction
    style: Menu
    label: Flow Direction
    startSection: true
    default: left
    menuNames:
    - left
    - right
    - up
    - down
    menuLabels:
    - Left
    - Right
    - Up
    - Down
    help: 'Where the history flows: new sound enters at the opposite edge and travels this way. Left/Right put frequency on the vertical axis, Up/Down on the horizontal axis.'
    value: down
  - name: Speed
    style: Float
    label: Flow Speed
    default: 1
    max: 6.0
    clampMin: true
    clampMax: true
    normMax: 4.0
    help: 'Base travel speed of the history: screen crossings (sheet), flight (tunnel) or turns (disc) per 10 s. Energy -> Fly adds to it. 0 = static, the field breathes in place.'
    value: 1.6399999857
  - name: Depth
    style: Float
    label: Waveform Depth
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: How far the waveform history displaces the form (depth on the sheet and disc, radius in the tunnel).
    value: 0
  - name: Thickness
    style: Float
    label: Cloud Thickness
    default: 0.6
    max: 3.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Depth spacing between the three layers of the cloud (0 = one flat sheet).
    value: 0.2870000005
  - name: Scatter
    style: Float
    default: 0.45
    max: 2.0
    clampMin: true
    clampMax: true
    normMax: 1.5
    help: Fixed random offset of each point, which turns the grid into a cloud.
    value: 0
  - name: Pointsize
    style: Float
    label: Point Size
    default: 1
    min: 0.1
    max: 6.0
    clampMin: true
    clampMax: true
    normMin: 0.2
    normMax: 3.0
    help: Size multiplier of the rendered points.
    value: 3
  - name: Sway
    style: Float
    label: Orbit
    startSection: true
    default: 1
    max: 3.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Amount of the slow, eased camera orbit around the origin (0 = locked camera).
    value: 2
  - name: Swayspeed
    style: Float
    label: Orbit Speed
    default: 1
    max: 5.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: Speed of the camera orbit, the roll and the idle breathing noise.
    value: 3
  - name: Glow
    style: Float
    default: 1
    max: 3.0
    clampMin: true
    clampMax: true
    help: Base strength of the bloom (the low band adds Low -> Bloom).
    value: 0.125
  - name: Dof
    style: Float
    label: Depth of Field
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: Blur of points in front of and behind the focus plane (soft bokeh discs). The mid band adds to it.
    value: 0.3759999871
  Reactivity:
  - name: Reach
    style: Float
    label: Video Displace
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: 'How far the points inside the video mask come toward the camera: the video is embossed into the form.'
    value: 2.1940000057
  - name: Imprint
    style: Float
    label: Video Imprint
    default: 0.5
    clampMin: true
    clampMax: true
    help: How strongly the video mask lifts its points up the color scale and enlarges them.
    value: 0.7699999809
  - name: Ripple
    style: Float
    label: Video Motion Ripple
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: Turbulence the motion in the video stirs into the cloud.
    value: 0.7699999809
  - name: Chaos
    style: Float
    startSection: true
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: 'Master amount of the band reactions below: higher = the track tears the image apart more.'
    value: 0
  - name: Lowbloom
    style: Float
    label: Low -> Bloom
    default: 1
    max: 3.0
    clampMin: true
    clampMax: true
    help: 'Low band (< 250 Hz): bloom and a depth pump.'
    value: 0.3670000136
  - name: Midblur
    style: Float
    label: Mid -> Blur
    default: 1
    max: 3.0
    clampMin: true
    clampMax: true
    help: 'Mid band (250 Hz - 4 kHz): defocus blur and a looser cloud.'
    value: 0.2630000114
  - name: Highjitter
    style: Float
    label: High -> Jitter
    default: 1
    max: 3.0
    clampMin: true
    clampMax: true
    help: 'High band (> 4 kHz): per-frame point jitter, grain and glitch.'
    value: 0.0240000002
  - name: Kick
    style: Float
    label: Transient -> Kick
    default: 1
    max: 3.0
    clampMin: true
    clampMax: true
    help: 'Transients (kicks, snares): a radial shock through the cloud, a colour split, strobe and invert.'
    value: 0
  - name: Micsono
    style: Float
    label: Transient Layer
    default: 0.6
    clampMin: true
    clampMax: true
    help: 'How much of the fast (instant) spectrum is written over the smoothed one: crisp hits in the history.'
    value: 0.003
  Finish:
  - name: Exposure
    style: Float
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 2.5
    help: Gain before the filmic tone map.
    value: 2.5
  - name: Crush
    style: Float
    label: Black Crush
    default: 0.06
    max: 0.5
    clampMin: true
    clampMax: true
    normMax: 0.3
    help: 'Black point after the tone map: everything below it goes to pure black (harder contrast).'
    value: 0.2372999936
  - name: Gamma
    style: Float
    label: Contrast Curve
    default: 1.25
    min: 0.3
    max: 3.0
    clampMin: true
    clampMax: true
    normMin: 0.5
    normMax: 2.5
    help: Power curve after the black crush (> 1 deepens the mids, light on dark).
    value: 0.5
  - name: Saturation
    style: Float
    clampMin: true
    clampMax: true
    help: 0 = strict monochrome (the Signal accent survives), 1 = the full color scale.
    value: 1
  - name: Trails
    style: Float
    startSection: true
    default: 0.55
    max: 0.97
    clampMin: true
    clampMax: true
    help: 'Light trails: how much of the previous frame survives (0 = none, 0.97 = long smear).'
    value: 0
  - name: Strobe
    style: Float
    default: 0.25
    clampMin: true
    clampMax: true
    help: White flash on strong transients.
    value: 0
  - name: Invert
    style: Float
    clampMin: true
    clampMax: true
    help: Negative flash on the strongest transients (dark on light for a frame).
  - name: Glitch
    style: Float
    default: 0.3
    clampMin: true
    clampMax: true
    help: Horizontal slice displacement driven by the high band and transients.
    value: 0
  - name: Grain
    style: Float
    default: 0.5
    max: 2.0
    clampMin: true
    clampMax: true
    help: Film grain amount (the high band adds to it).
    value: 0
  Monitor:
  - name: Monpresence
    style: Float
    label: Video Mask
    readOnly: true
    help: 'Read-only: 0-1, the video mask is present.'
    value: =float(me.op('sense/null_features')['presence'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Monprox
    style: Float
    label: Video Coverage
    readOnly: true
    help: 'Read-only: 0-1, how much of the frame the mask covers.'
    value: =float(me.op('sense/null_features')['prox'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Monposx
    style: Float
    label: Video Mask X
    readOnly: true
    help: 'Read-only: 0-1, horizontal center of the mask.'
    value: =float(me.op('sense/null_features')['cx'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Monmotion
    style: Float
    label: Video Motion
    readOnly: true
    help: 'Read-only: 0-1, amount of movement in the video.'
    value: =float(me.op('sense/null_features')['motion'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Monlow
    style: Float
    label: Low
    startSection: true
    readOnly: true
    help: 'Read-only: 0-1, low band above the adaptive floor.'
    value: =float(me.op('sense/null_features')['low'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Monmid
    style: Float
    label: Mid
    readOnly: true
    help: 'Read-only: 0-1, mid band above the adaptive floor.'
    value: =float(me.op('sense/null_features')['mid'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Monhigh
    style: Float
    label: High
    readOnly: true
    help: 'Read-only: 0-1, high band above the adaptive floor.'
    value: =float(me.op('sense/null_features')['high'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Montransient
    style: Float
    label: Transient
    readOnly: true
    help: 'Read-only: 0-1, onsets (fast envelope over slow envelope).'
    value: =float(me.op('sense/null_features')['transient'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Monenergy
    style: Float
    label: Energy
    readOnly: true
    help: 'Read-only: 0-1, slow loudness of the track (breakdown low, drop high).'
    value: =float(me.op('sense/null_features')['energy'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Montime
    style: Float
    label: Track Time (s)
    readOnly: true
    help: 'Read-only: playback position of the track in seconds.'
    value: =float(me.op('sense/audiofilein_track').par.index.eval()) if me.op('sense/audiofilein_track') is not None else 0.0
  Inputs:
  - name: Camera
    style: Toggle
    default: true
    help: 'Use the camera (sense/videoin_cam: pick the device there). Off = no silhouette, no motion.'
    value: false
  - name: Mirror
    style: Toggle
    default: true
    help: Mirror the camera horizontally so the cloud follows visitors like a mirror.
  - name: Keymode
    style: Menu
    label: Silhouette Key
    default: bgdiff
    menuNames:
    - bgdiff
    - dark
    menuLabels:
    - Background Difference
    - Dark on Light (white room)
    help: 'How a visitor is separated from the room: difference to a captured empty-room background, or simply anything darker than a white wall.'
    value: dark
  - name: Keythreshold
    style: Float
    label: Key Threshold
    default: 0.12
    clampMin: true
    clampMax: true
    normMax: 0.5
    help: Difference (or darkness) above which a pixel counts as visitor.
    value: 0.3869999945
  - name: Keysoftness
    style: Float
    label: Key Softness
    default: 0.08
    min: 0.001
    max: 0.5
    clampMin: true
    clampMax: true
    normMax: 0.3
    help: Width of the soft edge around the threshold.
    value: 0.0860000029
  - name: Bglearn
    style: Float
    label: Background Learn (s)
    default: 40
    max: 600.0
    clampMin: true
    clampMax: true
    normMax: 120.0
    help: Time constant in seconds with which the background slowly absorbs the room (lighting drift, moved furniture). 0 = never learn, only Capture.
    value: 10.5
  - name: Capturebg
    style: Pulse
    label: Capture Background
    help: Take the current camera image as the empty-room background. Press it with nobody in front of the camera.
  - name: Motiondecay
    style: Float
    label: Motion Trail (s)
    default: 0.8
    min: 0.05
    max: 5.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: Seconds the motion trail takes to fade.
    value: 2.5789999962
  - name: Mic
    style: Toggle
    label: Microphone
    startSection: true
    default: true
    help: 'Use the room microphone (sense/audiodevin_mic: pick the device there).'
    value: false
  - name: Micgain
    style: Float
    label: Mic Gain (dB)
    default: 12
    min: -24.0
    max: 48.0
    clampMin: true
    clampMax: true
    normMin: -12.0
    normMax: 36.0
    help: Input gain before the band levels are measured.
    value: 30.6000003815
  - name: Floortime
    style: Float
    label: Floor Adapt (s)
    default: 8
    max: 120.0
    clampMin: true
    clampMax: true
    normMax: 30.0
    help: Time the adaptive floor needs to absorb a constant sound (the drone from the speakers, air conditioning). Only sound above the floor makes noise. 0 = no floor.
    value: 8.3000001907
  - name: Micsmooth
    style: Float
    label: Mic Release (s)
    default: 0.35
    min: 0.01
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Release time of the band envelopes (attack is fixed and fast).
    value: 0.25
  Sound Mod:
  - name: Proxcutoff
    style: Float
    label: Proximity -> Cutoff (oct)
    default: 2
    min: -6.0
    max: 6.0
    clampMin: true
    clampMax: true
    normMin: -4.0
    normMax: 4.0
    help: Octaves the filter opens when a visitor fills the camera frame (negative closes it).
    value: -2.0199999809
  - name: Motionscan
    style: Float
    label: Motion -> Scan (months/s)
    default: 24
    max: 120.0
    clampMin: true
    clampMax: true
    normMax: 60.0
    help: 'Extra scan speed at full camera motion: moving makes the drone travel faster through the history.'
    value: 36.2000007629
  - name: Posstart
    style: Float
    label: Position -> Window (months)
    default: 48
    max: 240.0
    clampMin: true
    clampMax: true
    normMax: 120.0
    help: 'Window offset (in months) from walking left to right in front of the camera: the horizontal position scrubs through the years.'
    value: 46
  - name: Micdrive
    style: Float
    label: Mic -> Drive (dB)
    default: 4
    max: 24.0
    clampMin: true
    clampMax: true
    normMax: 12.0
    help: Extra shaper drive at full room loudness (the drone gets rougher when the room is loud).
    value: 6.08
  Data:
  - name: Seriesid
    style: Str
    label: Series Key
    default: BBIM1/M.DE.B.A2C.A.B.A.2250.EUR.N
    help: Bundesbank time-series key as FLOW/KEY (statistiken.bundesbank.de). Default BBIM1/M.DE.B.A2C.A.B.A.2250.EUR.N = new business volume of housing loans to households, Germany, EUR mn per month.
  - name: Fetch
    style: Pulse
    label: Fetch Series
    help: Request the series from the Bundesbank REST API (CSV, asynchronous Web Client DAT) and rebuild the cleaned numeric table.
  - name: Status
    style: Str
    readOnly: true
    help: 'Result of the last API request: months parsed and date range, or the HTTP error.'
    value: 284 months 2003-01 .. 2026-08
  Wavetable:
  - name: Start
    style: Float
    label: Window Start (months)
    startSection: true
    clampMin: true
    normMax: 280.0
    help: First month of the loop window, counted from the first observation (0 = Jan 2003). The window is played as ONE cycle of the wavetable. With Scan on, the scan offset is added to this.
    value: 35
  - name: Length
    style: Int
    label: Window Length (months)
    default: 96
    min: 4.0
    clampMin: true
    normMin: 4.0
    normMax: 300.0
    help: Months in the loop window (one oscillator cycle). Clipped to the months available after Window Start.
    value: 49
  - name: Loopmode
    style: Menu
    label: Loop Mode
    default: forward
    menuNames:
    - forward
    - pingpong
    menuLabels:
    - Forward (wrap)
    - Ping-Pong (mirror)
    help: Forward plays the window start to end and wraps; Ping-Pong plays it forward then backward, which closes the loop without a jump and keeps only odd-symmetric content.
    value: pingpong
  - name: Detrend
    style: Menu
    default: linear
    menuNames:
    - mean
    - linear
    menuLabels:
    - Mean (DC only)
    - Linear (close the loop)
    help: Mean removes only the average (DC). Linear also removes the straight line from the first to the last month, so the wrap has no step and the cycle shows the deviation from trend.
    value: mean
  - name: Interp
    style: Menu
    label: Interpolation
    default: cubic
    menuNames:
    - step
    - linear
    - cubic
    menuLabels:
    - Step (sample & hold)
    - Linear
    - Cubic (smooth)
    help: How the monthly values are resampled to the 2048-sample table. Step keeps the monthly staircase (bright, buzzy), Cubic is the smoothest.
  - name: Scan
    style: Toggle
    label: Scan History
    startSection: true
    default: true
    help: Slide the loop window through the whole history, so the timbre morphs from 2003 to today like a wavetable scan.
  - name: Scandir
    style: Menu
    label: Scan Direction
    default: pingpong
    menuNames:
    - pingpong
    - forward
    - backward
    menuLabels:
    - Ping-Pong (back and forth)
    - Forward (wrap to 2003)
    - Backward (wrap to today)
    help: 'How the window travels through history: back and forth, always forward in time (jumps back to the start at the end), or always backward.'
    value: backward
  - name: Scanrate
    style: Float
    label: Scan Rate (months/s)
    default: 4
    clampMin: true
    normMax: 24.0
    help: Months per second the window moves while Scan History is on. Camera motion adds to it (Sound Mod > Motion -> Scan).
    value: 7.6
  Shape:
  - name: Shapemode
    style: Menu
    label: Shaper
    default: soft
    menuNames:
    - soft
    - hard
    - fold
    - crush
    menuLabels:
    - Soft Clip (tanh)
    - Hard Clip
    - Wavefold (sine)
    - Bitcrush
    help: 'Waveshaper applied to the cycle after normalisation: adds upper harmonics. Bitcrush maps Drive to bit depth (0 dB = 8 bit, 36 dB = 2 bit).'
  - name: Drive
    style: Float
    label: Drive (dB)
    default: 9
    max: 48.0
    clampMin: true
    clampMax: true
    normMax: 36.0
    help: Gain into the shaper in dB; more drive means more and stronger upper harmonics. Microphone level adds to it (Sound Mod > Mic -> Drive).
    value: 5.7
  - name: Bias
    style: Float
    label: Asymmetry
    min: -1.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    help: Offset added before the shaper. Non-zero values clip one side harder and add even harmonics (DC is removed afterwards).
    value: -0.15
  - name: Mix
    style: Float
    default: 1
    clampMin: true
    clampMax: true
    help: Dry/wet between the raw cycle (0) and the shaped cycle (1).
    value: 0.884
  - name: Bandlimit
    style: Toggle
    label: Band-limit to Pitch
    default: true
    help: Remove harmonics above Nyquist for the current pitch so high notes do not alias. Off lets aliasing through for a harsher digital sound.
  Pitch:
  - name: Note
    style: Float
    label: Note (MIDI)
    default: 45
    min: 12.0
    max: 108.0
    clampMin: true
    clampMax: true
    normMin: 24.0
    normMax: 84.0
    help: Drone pitch as a MIDI note number (45 = A2 = 110 Hz, 57 = A3, 69 = A4 = 440 Hz). The wavetable shape is kept; only the playback rate changes.
    value: 25.6
  - name: Fine
    style: Float
    label: Fine (cents)
    min: -100.0
    max: 100.0
    clampMin: true
    clampMax: true
    normMin: -100.0
    normMax: 100.0
    help: Fine tuning in cents (1/100 semitone).
    value: -11
  - name: Glide
    style: Float
    label: Glide (s)
    default: 0.08
    max: 4.0
    clampMin: true
    clampMax: true
    help: 'Portamento time: seconds the frequency takes to slide to a new note.'
    value: 0.295
  Filter:
  - name: Filtertype
    style: Menu
    label: Filter Type
    default: lowpass
    menuNames:
    - lowpass
    - highpass
    - bandpass
    - bandreject
    menuLabels:
    - Low Pass
    - High Pass
    - Band Pass
    - Band Reject
    help: Response of the audio filter after the shaper.
  - name: Cutoff
    style: Float
    label: Cutoff (Hz)
    default: 1200
    min: 20.0
    max: 20000.0
    clampMin: true
    clampMax: true
    normMin: 20.0
    normMax: 6000.0
    help: Filter cutoff in Hz before drift and proximity modulation.
    value: 5738
  - name: Resonance
    style: Float
    default: 0.35
    clampMin: true
    clampMax: true
    help: Boost around the cutoff frequency (0 = none).
    value: 0.055
  - name: Rolloff
    style: Menu
    label: Roll-off
    default: '24'
    menuNames:
    - '12'
    - '24'
    menuLabels:
    - 12 dB/oct
    - 24 dB/oct
    help: Steepness of the filter slope.
  - name: Drift
    style: Float
    label: Drift (oct)
    startSection: true
    default: 0.6
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: Depth of the slow cutoff wander in octaves (0 = static filter). Two de-synced sines, so the drone keeps breathing with nobody in the room.
    value: 0.02
  - name: Driftrate
    style: Float
    label: Drift Rate (Hz)
    default: 0.05
    min: 0.001
    max: 2.0
    clampMin: true
    clampMax: true
    normMin: 0.005
    normMax: 0.5
    help: 'Speed of the cutoff wander: cycles per second of the main drift sine.'
    value: 0.141
  Output:
  - name: Audio
    style: Toggle
    label: Audio Out
    default: true
    help: Sends the drone to the default audio device.
    value: false
  - name: Volume
    style: Float
    default: 0.3
    clampMin: true
    clampMax: true
    help: Output gain (linear, 0-1) before the safety limiter.
    value: 0.459
parameters:
  parentshortcut: Reactor
sequences:
  ext:
  - object: op('./MusicVideoExt').module.MusicVideoExt(me)
    name: Reactor
    promote: true
color: [0.3, 0.5, 0.9]
tags:
- tdxn
operators:
- name: viz
  type: baseCOMP
  position: [995, 195]
  children:
  - name: out1
    type: outTOP
    position: [7300, -400]
    inputs:
    - null_out
  - name: cam_view
    type: cameraCOMP
    parameters:
      xord: trs
      tz: =parent.Reactor.par.Distance * (1.0 - 0.3 * parent.Reactor.par.Push * op('select_features')['energy'])
      rx: =parent.Reactor.par.Tilt + parent.Reactor.par.Sway * (0.2 if parent.Reactor.par.Form.eval() == 'tunnel' else 1.0) * (4.0 * math.sin(6.2831853 * op('speed_flow')['swayy']) + 1.2 * math.sin(6.2831853 * 2.0 * op('speed_flow')['swayy'] + 0.7)) + parent.Reactor.par.Shake * 3.0 * op('select_features')['transient'] * math.sin(absTime.frame * 2.399)
      ry: =parent.Reactor.par.Sway * (0.2 if parent.Reactor.par.Form.eval() == 'tunnel' else 1.0) * (8.0 * math.sin(6.2831853 * op('speed_flow')['swayx']) + 2.0 * math.sin(6.2831853 * 3.0 * op('speed_flow')['swayx'] + 1.3)) + parent.Reactor.par.Shake * 3.0 * op('select_features')['transient'] * math.sin(absTime.frame * 1.618 + 1.0)
      rz: =parent.Reactor.par.Roll * (30.0 if parent.Reactor.par.Form.eval() == 'tunnel' else 12.0) * math.sin(6.2831853 * op('speed_flow')['roll'])
      fov: =parent.Reactor.par.Fov * (1.0 + 0.35 * parent.Reactor.par.Fovpunch * op('select_features')['transient'])
      near: 0.05
      far: 60
    position: [4900, 0]
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
    children:
    - name: file1
      type: fileinPOP
      parameters:
        file: =app.samplesFolder + '/Geo/defcam.tog'
      flags:
      - display
      - viewer
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
  - name: null_out
    type: nullTOP
    position: [6900, -400]
    inputs:
    - glsl_post
  - name: geo_cloud
    type: geometryCOMP
    parameters:
      instancing: true
      instancecountmode: manual
      numinstances: =me.parent().op('null_field').width * me.parent().op('null_field').height
      material: mat_cloud
    position: [4900, -400]
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
    children:
    - name: rect
      type: rectangleSOP
      flags:
      - display
      - render
      position: [200, 0]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
  - name: glsl_post
    type: glslmultiTOP
    parameters:
      pixeldat: glsl_post_pixel
      numcolorbufs: 2
      format: rgba16float
    sequences:
      vec:
      - name: uPost
        valuex: =min(1.0, op('const_react')['mid'] * 0.8)
        valuey: =op('const_react')['kick']
        valuez: =(0.015 + 0.08 * op('const_react')['high']) * parent.Reactor.par.Grain
        valuew: =parent.Reactor.par.Exposure
      - name: uTime
        valuex: =absTime.frame % 10000
        valuey: 0
        valuez: 0
        valuew: 0
      - name: uGrade
        valuex: =parent.Reactor.par.Saturation
        valuey: =parent.Reactor.par.Crush
        valuez: =parent.Reactor.par.Gamma
        valuew: =parent.Reactor.par.Trails
      - name: uHit
        valuex: =parent.Reactor.par.Strobe * min(1.0, max(0.0, (op('const_react')['kick'] - 0.35) / 0.45))
        valuey: =parent.Reactor.par.Invert * min(1.0, max(0.0, (op('const_react')['kick'] - 0.6) / 0.3))
        valuez: =parent.Reactor.par.Glitch * min(1.0, op('const_react')['high'] + 0.7 * op('const_react')['kick'])
        valuew: =parent.Reactor.par.Ghost
    position: [6500, -400]
    inputs:
    - bloom_cloud
    - blur_defocus
    - feedback_post
    - select_video
  - name: mat_cloud
    type: glslMAT
    parameters:
      vdat: mat_cloud_vertex
      pdat: mat_cloud_pixel
      skelrootpath: =parent()
      blending: true
      destblend: one
      depthtest: false
      depthwriting: false
      cullface: neither
    sequences:
      mattr:
      - comps: 2
        cols: 2
      sampler:
      - name: sPos
        top: null_field
        filter: nearest
      - name: sCol
        top: null_color
        filter: nearest
      vec:
      - name: uFade
        valuex: =8.0 if parent.Reactor.par.Form.eval() == 'tunnel' else 5.0
        valuey: =parent.Reactor.par.Tunnellength + 6.0 if parent.Reactor.par.Form.eval() == 'tunnel' else 8.5
        valuez: 0.15
        valuew: 1.5
      - name: uDof
        valuex: =op('cam_view').par.tz + (6.0 if parent.Reactor.par.Form.eval() == 'tunnel' else 0.0)
        valuey: =(0.012 * parent.Reactor.par.Dof * (1.0 + 2.0 * op('const_react')['mid'])) * (0.35 if parent.Reactor.par.Form.eval() == 'tunnel' else 1.0)
        valuez: 0.12
        valuew: 0
    position: [4900, -800]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: const_flow
    type: constantCHOP
    sequences:
      const:
      - name: head
        value: =parent.Reactor.par.Speed * 0.1 * (1.0 + parent.Reactor.par.Flyreact * op('select_features')['energy'])
      - name: swayx
        value: =0.019 * parent.Reactor.par.Swayspeed
      - name: swayy
        value: =0.013 * parent.Reactor.par.Swayspeed
      - name: breath
        value: =0.023 * parent.Reactor.par.Swayspeed
      - name: roll
        value: =0.011 * parent.Reactor.par.Swayspeed * (1.0 + 2.0 * op('select_features')['energy'])
    position: [0, -1200]
  - name: glsl_field
    type: glslmultiTOP
    parameters:
      pixeldat: glsl_field_pixel
      numcolorbufs: 2
      outputresolution: custom
      resolutionw: 160
      resolutionh: 480
      format: rgba32float
    sequences:
      vec:
      - name: uFlow
        valuex: =op('speed_flow')['head'] * op('glsl_history').par.resolutionw
        valuey: =parent.Reactor.par.Direction.menuIndex
        valuez: =float(parent.Reactor.par.Modmirror)
        valuew: =op('speed_flow')['breath']
      - name: uShape
        valuex: =parent.Reactor.par.Depth
        valuey: =parent.Reactor.par.Thickness
        valuez: =parent.Reactor.par.Scatter
        valuew: =parent.Reactor.par.Pointsize
      - name: uReact
        valuex: =parent.Reactor.par.Reach
        valuey: =parent.Reactor.par.Imprint
        valuez: =parent.Reactor.par.Ripple
        valuew: =parent.Reactor.par.Vidshow
      - name: uNoise
        valuex: =op('const_react')['low']
        valuey: =op('const_react')['mid']
        valuez: =op('const_react')['high']
        valuew: =op('const_react')['kick']
      - name: uPal
        valuex: =parent.Reactor.par.Palette.menuIndex
        valuey: =parent.Reactor.par.Paletteshift
        valuez: =parent.Reactor.par.Contrast
        valuew: =parent.Reactor.par.Micsono
      - name: uMisc
        valuex: =absTime.frame % 10000
        valuey: =math.tan(math.radians(op("cam_view").par.fov.eval() * 0.5))
        valuez: 1.6
      - name: uForm
        valuex: =parent.Reactor.par.Form.menuIndex
        valuey: =parent.Reactor.par.Morph
        valuez: =parent.Reactor.par.Twist + parent.Reactor.par.Twistreact * op('select_features')['mid']
        valuew: =parent.Reactor.par.Lowpump * op('select_features')['low']
      - name: uForm2
        valuex: =parent.Reactor.par.Symmetry
        valuey: =parent.Reactor.par.Tunnellength
        valuez: =parent.Reactor.par.Warp * (0.4 + 1.2 * op('select_features')['energy'])
        valuew: =op('cam_view').par.tz.eval()
    position: [3200, -400]
    inputs:
    - null_history
    - select_presence
  - name: null_color
    type: nullTOP
    position: [4000, -800]
    inputs:
    - renderselect_color
  - name: null_field
    type: nullTOP
    position: [3600, -400]
    inputs:
    - glsl_field
  - name: null_trail
    type: nullTOP
    position: [7300, -800]
    inputs:
    - renderselect_trail
  - name: speed_flow
    type: speedCHOP
    position: [400, -1200]
    inputs:
    - const_flow
  - name: bloom_cloud
    type: bloomTOP
    parameters:
      bloomthreshold: 0.6
      bloomintensity: =0.35 * parent.Reactor.par.Glow + 0.6 * op('const_react')['low']
      format: rgba16float
    position: [5700, -400]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - render_cloud
  - name: const_react
    type: constantCHOP
    sequences:
      const:
      - name: low
        value: =op('select_features')['low'] * parent.Reactor.par.Lowbloom * parent.Reactor.par.Chaos
      - name: mid
        value: =op('select_features')['mid'] * parent.Reactor.par.Midblur * parent.Reactor.par.Chaos
      - name: high
        value: =op('select_features')['high'] * parent.Reactor.par.Highjitter * parent.Reactor.par.Chaos
      - name: kick
        value: =op('select_features')['transient'] * parent.Reactor.par.Kick * parent.Reactor.par.Chaos
    position: [400, -1600]
  - name: blur_defocus
    type: blurTOP
    parameters:
      size: =int(4 + 30 * min(1.0, op('const_react')['mid']))
    position: [6100, -800]
    inputs:
    - bloom_cloud
  - name: chopto_scope
    type: choptoTOP
    parameters:
      chop: ../sense/null_trackmono
    position: [1200, -800]
  - name: glsl_history
    type: glslmultiTOP
    parameters:
      pixeldat: glsl_history_pixel
      outputresolution: custom
      format: rgba16float
    sequences:
      vec:
      - name: uHead
        valuex: =op('speed_flow')['head'] * me.par.resolutionw
        valuey: =op('const_flow')['head'] * me.par.resolutionw / me.time.rate
        valuez: =1.0 if op('const_flow')['head'] < 0.0001 else 0.0
      - name: uSono
        valuex: 30
        valuey: 16000
        valuez: 22050
        valuew: 0.031
    position: [2400, -400]
    inputs:
    - null_specsmooth
    - null_micsmooth
    - chopto_scope
    - feedback_history
  - name: null_history
    type: nullTOP
    position: [2800, -400]
    inputs:
    - glsl_history
  - name: render_cloud
    type: renderTOP
    parameters:
      camera: cam_view
      geometry: geo_cloud
      lights: ''
      bgcolora: 1
      resolutionw: 1080
      resolutionh: 1080
      format: rgba16float
    position: [5300, -400]
    size: [130, 90]
