- name: out1
  type: outTOP
  flags:
  - display
  position: [1400, 0]
  inputs:
  - viz
- name: sense
  type: baseCOMP
  position: [200, -400]
  children:
  - name: glsl_bg
    type: glslTOP
    parameters:
      pixeldat: glsl_bg_pixel
      outputresolution: custom
      resolutionw: 160
      resolutionh: 90
      format: rgba16float
    sequences:
      vec:
      - name: uLearn
        valuex: =(1.0 - math.exp(-1.0 / (parent.Reactor.par.Bglearn * me.time.rate))) if parent.Reactor.par.Bglearn > 0 else 0.0
    position: [1600, -1200]
    inputs:
    - null_cam
    - feedback_bg
    - feedback_presence
  - name: null_bg
    type: nullTOP
    position: [2000, -1200]
    inputs:
    - glsl_bg
  - name: res_cam
    type: resolutionTOP
    parameters:
      highqualresize: true
      outputresolution: custom
      resolutionw: 160
      resolutionh: 90
    position: [400, -1400]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - videoin_cam
  - name: null_cam
    type: nullTOP
    position: [800, -1400]
    inputs:
    - res_cam
  - name: filter_low
    type: audiofilterCHOP
    parameters:
      cutofffrequency: 250
      rolloff: 24
    position: [400, 200]
    inputs:
    - audiodevin_mic
  - name: filter_mid
    type: audiofilterCHOP
    parameters:
      filter: bandpass
      cutofffrequency: 1000
    position: [400, 0]
    inputs:
    - audiodevin_mic
  - name: glsl_stats
    type: glslTOP
    parameters:
      pixeldat: glsl_stats_pixel
      outputresolution: custom
      resolutionw: 1
      resolutionh: 1
      format: rgba32float
    position: [3200, -2000]
    inputs:
    - null_presence
  - name: const_black
    type: constantTOP
    parameters:
      resolutionw: 160
      resolutionh: 90
    position: [800, -2000]
  - name: feedback_bg
    type: feedbackTOP
    parameters:
      top: null_bg
    position: [1200, -1200]
    inputs:
    - null_cam
  - name: filter_high
    type: audiofilterCHOP
    parameters:
      filter: highpass
      cutofffrequency: 4000
      rolloff: 24
    position: [400, -200]
    inputs:
    - audiodevin_mic
  - name: merge_bands
    type: mergeCHOP
    position: [800, 0]
    inputs:
    - filter_low
    - filter_mid
    - filter_high
  - name: topto_stats
    type: toptoCHOP
    parameters:
      top: glsl_stats
      rate: =me.time.rate
      autoexportroot: =parent()
    position: [3600, -2000]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: videoin_cam
    type: videodeviceinTOP
    parameters:
      active: =parent.Reactor.par.Camera
      device: V1|||\\?\usb#vid_3277&pid_0010&mi_00#7&df5034d&0&0000#{65e8773d-8f56-11d0-a3b9-00a0c9223196}\global|||0|||0|||ASUS FHD webcam
      signalformat: f1920x1080p-30.00hz
      outputresolution: half
    position: [0, -1400]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: glsl_bg_info
    type: infoDAT
    parameters:
      op: glsl_bg
    position: [1525, -1320]
    dock: glsl_bg
    dat_read_only: true
  - name: blur_presence
    type: blurTOP
    parameters:
      size: 6
    position: [3200, -1600]
    inputs:
    - null_presence
  - name: feedback_prev
    type: feedbackTOP
    parameters:
      top: null_cam
    position: [1200, -1600]
    inputs:
    - null_cam
  - name: glsl_bg_pixel
    type: textDAT
    parameters:
      file: project1/audioreactor/sense/glsl_bg_pixel.glsl
      syncfile: true
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [1675, -1320]
    color: [0.9, 0.3, 0.4]
    tags:
    - glsl
    dock: glsl_bg
  - name: glsl_presence
    type: glslmultiTOP
    parameters:
      pixeldat: glsl_presence_pixel
      outputresolution: custom
      resolutionw: 160
      resolutionh: 90
      format: rgba16float
    sequences:
      vec:
      - name: uKey
        valuex: =parent.Reactor.par.Keythreshold
        valuey: =parent.Reactor.par.Keysoftness
        valuez: =1.0 if parent.Reactor.par.Keymode.eval() == 'dark' else 0.0
        valuew: 0.5
      - name: uMotion
        valuex: =math.exp(-1.0 / max(1.0, parent.Reactor.par.Motiondecay * me.time.rate))
        valuey: 0.05
        valuez: 1
        valuew: =float(parent.Reactor.par.Camera)
    position: [2400, -1600]
    inputs:
    - null_cam
    - null_bg
    - feedback_prev
    - feedback_presence
  - name: null_features
    type: nullCHOP
    position: [4800, -400]
    inputs:
    - script_features
  - name: null_presence
    type: nullTOP
    position: [2800, -1600]
    inputs:
    - glsl_presence
  - name: audiodevin_mic
    type: audiodeviceinCHOP
    parameters:
      active: =parent.Reactor.par.Mic
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: glsl_stats_info
    type: infoDAT
    parameters:
      op: glsl_stats
    position: [3125, -2120]
    dock: glsl_stats
    dat_read_only: true
  - name: script_features
    type: scriptCHOP
    parameters:
      callbacks: script_features_callbacks
    position: [4400, -400]
    inputs:
    - merge_bands
    - topto_stats
  - name: glsl_stats_pixel
    type: textDAT
    parameters:
      file: project1/audioreactor/sense/glsl_stats_pixel.glsl
      syncfile: true
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [3275, -2120]
    color: [0.9, 0.3, 0.4]
    tags:
    - glsl
    dock: glsl_stats
  - name: null_micspectrum
    type: nullCHOP
    position: [800, -400]
    inputs:
    - audiospectrum_mic
  - name: audiospectrum_mic
    type: audiospectrumCHOP
    position: [400, -400]
    inputs:
    - audiodevin_mic
  - name: feedback_presence
    type: feedbackTOP
    parameters:
      top: null_presence
    position: [1200, -2000]
    inputs:
    - const_black
  - name: glsl_presence_info
    type: infoDAT
    parameters:
      op: glsl_presence
    position: [2325, -1720]
    dock: glsl_presence
    dat_read_only: true
  - name: null_presence_soft
    type: nullTOP
    position: [3600, -1600]
    inputs:
    - blur_presence
  - name: glsl_presence_pixel
    type: textDAT
    parameters:
      file: project1/audioreactor/sense/glsl_presence_pixel.glsl
      syncfile: true
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [2475, -1720]
    color: [0.9, 0.3, 0.4]
    tags:
    - glsl
    dock: glsl_presence
  - name: script_features_callbacks
    type: textDAT
    parameters:
      file: project1/audioreactor/sense/script_features_callbacks.py
      syncfile: true
      language: python
    flags:
    - viewer
    position: [4400, -520]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
    dock: script_features
  annotations:
  - name: annotate1
    mode: annotate
    title: 'Microphone: bands + spectrum'
    text: audiodevin_mic (pick the device here) -> low < 250 Hz / mid ~1 kHz / high > 4 kHz -> merge_bands for script_features; audiospectrum_mic (2048 bins) for the sonogram's room layer.
    position: [-70, -470]
    size: [1070, 930]
    color: [0.27, 0.12, 0.27]
  - name: annotate2
    mode: annotate
    title: 'Camera: silhouette + motion (160x90)'
    text: 'videoin_cam (pick the device here) -> res_cam 160x90. glsl_bg learns the empty room (Background Learn, Capture Background resets feedback_bg). glsl_presence: R silhouette (background difference or dark-on-light key), G motion trail, B luma. glsl_stats folds it into one pixel (area, centre, motion) -> topto_stats. null_presence_soft feeds the point field.'
    position: [-70, -2190]
    size: [3870, 1250]
    color: [0.08, 0.26, 0.28]
  - name: annotate3
    mode: annotate
    title: Room features
    text: 'script_features: low mid high level transient (adaptive floor, envelopes) + presence prox cx cy motion, 0-1 each -> null_features.'
    position: [4330, -590]
    size: [670, 450]
    color: [0.28, 0.22, 0.08]
- name: engine
  type: baseCOMP
  position: [600, 0]
  inputs:
  - data
  children:
  - name: math_vca
    type: mathCHOP
    parameters:
      chopop: mul
      gain: =parent.Reactor.par.Volume
      autoexportroot: =parent()
    position: [3400, -2600]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - audiofilter_vcf
  - name: in_series
    type: inDAT
    parameters:
      label: =me.name
    position: [200, 0]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    dat_read_only: true
  - name: lag_glide
    type: lagCHOP
    parameters:
      lag1: =parent.Reactor.par.Glide
      lag2: =parent.Reactor.par.Glide
      autoexportroot: =parent()
    position: [1800, -2600]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - select_pitch
  - name: limit_out
    type: limitCHOP
    parameters:
      type: clamp
      autoexportroot: =parent()
      renameto: audio
    position: [3800, -2600]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - math_vca
  - name: null_audio
    type: nullCHOP
    position: [4200, -2600]
    inputs:
    - limit_out
  - name: null_scope
    type: nullCHOP
    position: [5800, -3800]
    inputs:
    - script_scope
  - name: speed_scan
    type: speedCHOP
    parameters:
      max: 100000
    position: [600, -400]
    inputs:
    - const_scanrate
  - name: const_drift
    type: constantCHOP
    sequences:
      const:
      - name: d1
        value: =parent.Reactor.par.Driftrate
      - name: d2
        value: =parent.Reactor.par.Driftrate * 0.382
    position: [200, -2200]
  - name: lookup_wave
    type: lookupCHOP
    parameters:
      index1: -1
      cyclic: 'yes'
      autoexportroot: =parent()
    position: [2600, -2600]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - audioosc_phase
    - select_table
  - name: merge_scope
    type: mergeCHOP
    position: [4600, -3800]
    inputs:
    - null_audio
    - audioosc_phase
  - name: null_series
    type: nullCHOP
    position: [1000, 0]
    inputs:
    - datto_series
  - name: speed_drift
    type: speedCHOP
    position: [600, -2200]
    inputs:
    - const_drift
  - name: trail_scope
    type: trailCHOP
    parameters:
      wlength: 8192
      wlengthunit: samples
      rate: =me.time.rate
      autoexportroot: =parent()
    position: [5000, -3800]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - merge_scope
  - name: const_cutoff
    type: constantCHOP
    sequences:
      const:
      - name: cutofffrequency
        value: =min(18000.0, max(20.0, parent.Reactor.par.Cutoff * 2.0 ** (parent.Reactor.par.Drift * (0.7 * math.sin(6.2831853 * op('speed_drift')['d1']) + 0.3 * math.sin(6.2831853 * op('speed_drift')['d2'])) + parent.Reactor.par.Proxcutoff * op('select_features')['prox'])))
    position: [1000, -2200]
  - name: datto_series
    type: dattoCHOP
    parameters:
      dat: in_series
      rowindexend: =me.inputTable.numRows - 1
      rowexpr: =re.match('.*',me.inputCell.val) != None
      extractcols: bynames
      colindexend: =me.inputTable.numCols - 1
      colnames: t value_bn
      colexpr: =re.match('.*',me.inputCell.val) != None
      output: chanpercol
      firstrow: names
      firstcolumn: values
      autoexportroot: =parent()
    position: [600, 0]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: script_scope
    type: scriptCHOP
    parameters:
      callbacks: script_scope_callbacks
    position: [5400, -3800]
    inputs:
    - trail_scope
  - name: select_pitch
    type: selectCHOP
    parameters:
      channames: hz
    position: [1400, -2600]
    inputs:
    - script_window
  - name: select_table
    type: selectCHOP
    parameters:
      channames: shaped
    position: [2200, -400]
    inputs:
    - null_wavetable
  - name: null_spectrum
    type: nullCHOP
    position: [5000, -3400]
    inputs:
    - audiospectrum_out
  - name: script_window
    type: scriptCHOP
    parameters:
      callbacks: script_window_callbacks
    position: [1000, -400]
    inputs:
    - speed_scan
  - name: wavetable_lib
    type: textDAT
    parameters:
      file: project1/audioreactor/engine/wavetable_lib.py
      syncfile: true
      language: python
    position: [1400, 0]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
  - name: audioosc_phase
    type: audiooscillatorCHOP
    parameters:
      wavetype: ramp
      frequency: =op('lag_glide')['hz']
      autoexportroot: =parent()
      renamefrom: chan1
      renameto: phase
    position: [2200, -2600]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: const_scanrate
    type: constantCHOP
    sequences:
      const:
      - name: rate
        value: =(-1.0 if parent.Reactor.par.Scandir.eval() == 'backward' else 1.0) * (parent.Reactor.par.Scanrate * parent.Reactor.par.Scan + parent.Reactor.par.Motionscan * op('select_features')['motion'])
    position: [200, -400]
  - name: null_wavetable
    type: nullCHOP
    position: [1800, -400]
    inputs:
    - script_wavetable
  - name: audiofilter_vcf
    type: audiofilterCHOP
    parameters:
      filter: =parent.Reactor.par.Filtertype
      cutofflog: 2.69897
      cutofffrequency: =parent.Reactor.par.Cutoff
      resonance: =parent.Reactor.par.Resonance
      rolloff: =float(parent.Reactor.par.Rolloff.eval())
    position: [3000, -2600]
    inputs:
    - lookup_wave
    - const_cutoff
  - name: select_features
    type: selectCHOP
    parameters:
      chops: ../sense/null_features
    position: [200, -800]
  - name: audiodevout_main
    type: audiodeviceoutCHOP
    parameters:
      active: =parent.Reactor.par.Audio
      autoexportroot: =parent()
    position: [4600, -2600]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - null_audio
  - name: script_wavetable
    type: scriptCHOP
    parameters:
      callbacks: script_wavetable_callbacks
    position: [1400, -400]
    inputs:
    - script_window
  - name: audiospectrum_out
    type: audiospectrumCHOP
    parameters:
      outlength: 8192
    position: [4600, -3400]
    inputs:
    - null_audio
  - name: script_scope_callbacks
    type: textDAT
    parameters:
      file: project1/audioreactor/engine/script_scope_callbacks.py
      syncfile: true
      language: python
    flags:
    - viewer
    position: [5400, -3920]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
    dock: script_scope
  - name: script_window_callbacks
    type: textDAT
    parameters:
      file: project1/audioreactor/engine/script_window_callbacks.py
      syncfile: true
      language: python
    flags:
    - viewer
    position: [1000, -520]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
    dock: script_window
  - name: script_wavetable_callbacks
    type: textDAT
    parameters:
      file: project1/audioreactor/engine/script_wavetable_callbacks.py
      syncfile: true
      language: python
    flags:
    - viewer
    position: [1400, -520]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
    dock: script_wavetable
  annotations:
  - name: annotate1
    mode: annotate
    title: 'Wavetable: series window -> single cycle (numpy)'
    text: speed_scan slides the window (Scan, Scan Direction; camera motion adds speed via select_features). script_window resolves start / length / pitch, offset by the visitor's horizontal position. script_wavetable builds the 2048-sample cycle via wavetable_lib (detrend, loop, interpolate, shape with Drive + room level, band-limit).
    position: [130, -990]
    size: [2670, 1250]
    color: [0.08, 0.26, 0.28]
  - name: annotate2
    mode: annotate
    title: 'Voice: drone oscillator, drifting filter, audio out'
    text: 'A drone: no gate, no envelopes. lag_glide -> audioosc_phase ramp -> lookup_wave reads the table -> audiofilter_vcf -> math_vca (x Volume) -> limit_out (+/-1) -> audio device. const_cutoff = Cutoff x 2^(Drift x two de-synced sines of speed_drift + Proximity->Cutoff x prox) into the filter''s modulation input.'
    position: [130, -2670]
    size: [4670, 730]
    color: [0.27, 0.12, 0.27]
  - name: annotate3
    mode: annotate
    title: 'Analysis: spectrum + synced scope'
    text: 'audiospectrum_out: 8192-pt FFT, one sample per Hz (0-22050). script_scope cuts the last two whole cycles from trail_scope using the oscillator phase, so the trace is trigger-stable.'
    position: [4530, -3990]
    size: [1470, 850]
    color: [0.28, 0.22, 0.08]
- name: AudioReactorExt
  type: textDAT
  parameters:
    file: project1/audioreactor/AudioReactorExt.py
    syncfile: true
    language: python
  position: [200, 800]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
- name: parexec_reactor
  type: parameterexecuteDAT
  parameters:
    fromop: =parent()
    op: ..
    pars: '* ^Mon*'
    builtin: false
    file: project1/audioreactor/parexec_reactor.py
    syncfile: true
  position: [600, 800]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
annotations:
- name: annotate1
  mode: annotate
  title: Control
  text: AudioReactorExt owns the parameter schema, the API fetch and Capture Background; parexec_reactor routes pulses/changes to _on<Par> handlers (Mon* monitors excluded).
  position: [130, 730]
  size: [670, 330]
  color: [0.2, 0.2, 0.28]
- name: annotate2
  mode: annotate
  title: 'Pipeline: data + sense -> engine -> viz'
  text: 'data: Bundesbank series. sense: camera + microphone -> null_features / null_presence_soft. engine: the wavetable drone, modulated by the room. viz: sonogram/scope history -> 3D point cloud -> out1.'
  position: [130, -470]
  size: [1470, 770]
  color: [0.08, 0.2, 0.28]
