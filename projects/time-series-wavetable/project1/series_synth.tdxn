format: tdxn
version: '2.1'
build: 4
generator: Embody/6.2.68
td_build: 099.2025.32820
network_path: /project1/series_synth
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  baseCOMP:
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
  choptoTOP:
    parameters:
      format: rgba32float
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  constantCHOP:
    parameters:
      autoexportroot: =parent()
      rate: =me.time.rate
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  dattoCHOP:
    parameters:
      autoexportroot: =parent()
      colexpr: =re.match('.*',me.inputCell.val) != None
      colindexend: =me.inputTable.numCols - 1
      firstrow: names
      output: chanpercol
      rowexpr: =re.match('.*',me.inputCell.val) != None
      rowindexend: =me.inputTable.numRows - 1
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  expressionCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  feedbackTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  geometryCOMP:
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
  glslPOP:
    parameters:
      outputattrs: P Color LineWidth
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  glslTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  gridPOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  infoDAT:
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  lineMAT:
    parameters:
      skelrootpath: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  mergeCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  nullCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  nullPOP:
    flags:
    - display
    - render
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  nullTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  outDAT:
    parameters:
      label: =me.name
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  outTOP:
    parameters:
      label: =me.name
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  scriptCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  scriptDAT:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  selectCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  speedCHOP:
    parameters:
      autoexportroot: =parent()
      limittype: loop
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  textDAT:
    size: [130, 90]
  textTOP:
    parameters:
      alignx: left
      aligny: bottom
      outputresolution: custom
      resolutionh: =parent.Synth.op('viz/glsl_dashboard').par.resolutionh
      resolutionw: =parent.Synth.op('viz/glsl_dashboard').par.resolutionw
      text: ''
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  trailCHOP:
    parameters:
      autoexportroot: =parent()
      rate: =me.time.rate
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  triggerCHOP:
    parameters:
      ashape: linear
      autoexportroot: =parent()
      dshape: easeout
      peaklen: 0
      rate: 960
      renamefrom: gate
      rshape: easeout
      specifyrate: true
      threshup: 0.5
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
type: baseCOMP
custom_pars:
  Data:
  - name: Seriesid
    style: Str
    label: Series Key
    default: BBIM1/M.DE.B.A2C.A.B.A.2250.EUR.N
    help: Bundesbank time-series key as FLOW/KEY (statistiken.bundesbank.de). Default BBIM1/M.DE.B.A2C.A.B.A.2250.EUR.N = new business volume of housing loans to households, Germany, EUR mn per month.
  - name: Fetch
    style: Pulse
    label: Fetch Series
    help: Request the series from the Bundesbank REST API (CSV, asynchronous Web Client DAT) and rebuild the cleaned numeric table.
  - name: Status
    style: Str
    readOnly: true
    help: 'Result of the last API request: months parsed and date range, or the HTTP error.'
    value: 284 months 2003-01 .. 2026-08
  Wavetable:
  - name: Start
    style: Float
    label: Window Start (months)
    startSection: true
    clampMin: true
    normMax: 280.0
    help: First month of the loop window, counted from the first observation (0 = Jan 2003). The window is played as ONE cycle of the wavetable. With Scan on, the scan offset is added to this.
  - name: Length
    style: Int
    label: Window Length (months)
    default: 96
    min: 4.0
    clampMin: true
    normMin: 4.0
    normMax: 300.0
    help: Months in the loop window (one oscillator cycle). Clipped to the months available after Window Start.
    value: 50
  - name: Loopmode
    style: Menu
    label: Loop Mode
    default: forward
    menuNames:
    - forward
    - pingpong
    menuLabels:
    - Forward (wrap)
    - Ping-Pong (mirror)
    help: Forward plays the window start to end and wraps; Ping-Pong plays it forward then backward, which closes the loop without a jump and keeps only odd-symmetric content.
    value: pingpong
  - name: Detrend
    style: Menu
    default: linear
    menuNames:
    - mean
    - linear
    menuLabels:
    - Mean (DC only)
    - Linear (close the loop)
    help: Mean removes only the average (DC). Linear also removes the straight line from the first to the last month, so the wrap has no step and the cycle shows the deviation from trend.
  - name: Interp
    style: Menu
    label: Interpolation
    default: cubic
    menuNames:
    - step
    - linear
    - cubic
    menuLabels:
    - Step (sample & hold)
    - Linear
    - Cubic (smooth)
    help: How the monthly values are resampled to the 2048-sample table. Step keeps the monthly staircase (bright, buzzy), Cubic is the smoothest.
    value: linear
  - name: Scan
    style: Toggle
    label: Scan History
    startSection: true
    default: true
    help: Slide the loop window through the whole history (ping-pong), so the timbre morphs from 2003 to today like a wavetable scan.
  - name: Scanrate
    style: Float
    label: Scan Rate (months/s)
    default: 4
    clampMin: true
    normMax: 24.0
    help: Months per second the window moves while Scan History is on.
    value: 14.9
  Shape:
  - name: Shapemode
    style: Menu
    label: Shaper
    default: soft
    menuNames:
    - soft
    - hard
    - fold
    - crush
    menuLabels:
    - Soft Clip (tanh)
    - Hard Clip
    - Wavefold (sine)
    - Bitcrush
    help: 'Waveshaper applied to the cycle after normalisation: adds upper harmonics. Bitcrush maps Drive to bit depth (0 dB = 8 bit, 36 dB = 2 bit).'
    value: hard
  - name: Drive
    style: Float
    label: Drive (dB)
    default: 9
    max: 48.0
    clampMin: true
    clampMax: true
    normMax: 36.0
    help: Gain into the shaper in dB; more drive means more and stronger upper harmonics.
    value: 11.8
  - name: Bias
    style: Float
    label: Asymmetry
    min: -1.0
    clampMin: true
    clampMax: true
    normMin: -1.0
    help: Offset added before the shaper. Non-zero values clip one side harder and add even harmonics (DC is removed afterwards).
    value: 0.39
  - name: Mix
    style: Float
    default: 1
    clampMin: true
    clampMax: true
    help: Dry/wet between the raw cycle (0) and the shaped cycle (1).
    value: 0.409
  - name: Bandlimit
    style: Toggle
    label: Band-limit to Pitch
    default: true
    help: Remove harmonics above Nyquist for the current pitch so high notes do not alias. Off lets aliasing through for a harsher digital sound.
  Pitch:
  - name: Note
    style: Float
    label: Note (MIDI)
    default: 45
    min: 12.0
    max: 108.0
    clampMin: true
    clampMax: true
    normMin: 24.0
    normMax: 84.0
    help: Oscillator pitch as a MIDI note number (45 = A2 = 110 Hz, 57 = A3, 69 = A4 = 440 Hz). The wavetable shape is kept; only the playback rate changes.
    value: 26.6
  - name: Fine
    style: Float
    label: Fine (cents)
    min: -100.0
    max: 100.0
    clampMin: true
    clampMax: true
    normMin: -100.0
    normMax: 100.0
    help: Fine tuning in cents (1/100 semitone).
    value: -7
  - name: Glide
    style: Float
    label: Glide (s)
    default: 0.08
    max: 4.0
    clampMin: true
    clampMax: true
    help: 'Portamento time: seconds the frequency takes to slide to a new note.'
    value: 0.416
  Gate:
  - name: Gate
    style: Momentary
    label: Gate (hold to play)
    help: 'Opens the gate while held: both envelopes attack, then release when let go.'
  - name: Hold
    style: Toggle
    label: Hold (drone)
    help: Keeps the gate open permanently (drone at sustain level).
    value: true
  - name: Autogate
    style: Toggle
    label: Auto Gate
    startSection: true
    default: true
    help: Retriggers the envelopes rhythmically at Gate Rate.
    value: false
  - name: Gaterate
    style: Float
    label: Gate Rate (Hz)
    default: 1
    min: 0.05
    max: 16.0
    clampMin: true
    clampMax: true
    normMin: 0.1
    normMax: 8.0
    help: Notes per second of the Auto Gate (1.0 = 60 BPM, 2.0 = 120 BPM).
    value: 1.08
  - name: Gatelength
    style: Float
    label: Gate Length
    default: 0.55
    min: 0.02
    max: 0.98
    clampMin: true
    clampMax: true
    help: Fraction of each Auto Gate period the gate stays open.
    value: 0.277
  Amp Env:
  - name: Attack
    style: Float
    label: Attack (s)
    default: 0.01
    min: 0.001
    max: 10.0
    clampMin: true
    clampMax: true
    normMin: 0.001
    normMax: 2.0
    help: 'Loudness envelope: seconds from gate-on to full level.'
    value: 0.001
  - name: Decay
    style: Float
    label: Decay (s)
    default: 0.35
    min: 0.001
    max: 10.0
    clampMin: true
    clampMax: true
    normMin: 0.001
    normMax: 2.0
    help: 'Loudness envelope: seconds from full level down to the sustain level.'
    value: 0.25
  - name: Sustain
    style: Float
    default: 0.6
    clampMin: true
    clampMax: true
    help: 'Loudness envelope: level held while the gate stays open (0-1).'
  - name: Release
    style: Float
    label: Release (s)
    default: 0.5
    min: 0.001
    max: 10.0
    clampMin: true
    clampMax: true
    normMin: 0.001
    normMax: 3.0
    help: 'Loudness envelope: seconds to fall to silence after the gate closes.'
  Filter:
  - name: Filtertype
    style: Menu
    label: Filter Type
    default: lowpass
    menuNames:
    - lowpass
    - highpass
    - bandpass
    - bandreject
    menuLabels:
    - Low Pass
    - High Pass
    - Band Pass
    - Band Reject
    help: Response of the 4-pole audio filter after the shaper.
    value: bandreject
  - name: Cutoff
    style: Float
    label: Cutoff (Hz)
    default: 500
    min: 20.0
    max: 20000.0
    clampMin: true
    clampMax: true
    normMin: 20.0
    normMax: 6000.0
    help: Filter cutoff in Hz with the filter envelope at zero.
    value: 1504
  - name: Resonance
    style: Float
    default: 0.35
    clampMin: true
    clampMax: true
    help: Boost around the cutoff frequency (0 = none).
    value: 0.16
  - name: Rolloff
    style: Menu
    label: Roll-off
    default: '24'
    menuNames:
    - '12'
    - '24'
    menuLabels:
    - 12 dB/oct
    - 24 dB/oct
    help: Steepness of the filter slope.
    value: '12'
  - name: Envamount
    style: Float
    label: Env Amount (oct)
    startSection: true
    default: 4
    min: -8.0
    max: 8.0
    clampMin: true
    clampMax: true
    normMin: -6.0
    normMax: 6.0
    help: Octaves the filter envelope moves the cutoff at full level (cutoff x 2^(amount x env)). Negative values sweep downward.
    value: 0.04
  - name: Fattack
    style: Float
    label: Env Attack (s)
    default: 0.005
    min: 0.001
    max: 10.0
    clampMin: true
    clampMax: true
    normMin: 0.001
    normMax: 2.0
    help: 'Filter envelope: seconds from gate-on to full level.'
  - name: Fdecay
    style: Float
    label: Env Decay (s)
    default: 0.45
    min: 0.001
    max: 10.0
    clampMin: true
    clampMax: true
    normMin: 0.001
    normMax: 2.0
    help: 'Filter envelope: seconds from full level down to the sustain level.'
  - name: Fsustain
    style: Float
    label: Env Sustain
    default: 0.2
    clampMin: true
    clampMax: true
    help: 'Filter envelope: level held while the gate stays open (0-1).'
    value: 0.317
  - name: Frelease
    style: Float
    label: Env Release (s)
    default: 0.4
    min: 0.001
    max: 10.0
    clampMin: true
    clampMax: true
    normMin: 0.001
    normMax: 3.0
    help: 'Filter envelope: seconds to fall back after the gate closes.'
  Output:
  - name: Audio
    style: Toggle
    label: Audio Out
    default: true
    help: Sends the synth to the default audio device.
  - name: Volume
    style: Float
    default: 0.3
    clampMin: true
    clampMax: true
    help: Output gain (linear, 0-1) before the safety limiter.
    value: 0.547
  Visual:
  - name: Orbit
    style: Float
    label: Camera Orbit
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    help: Speed multiplier of the eased camera orbit around the 3D wavetable (0 = still).
  - name: Glow
    style: Float
    default: 1
    max: 3.0
    clampMin: true
    clampMax: true
    help: Strength of the neon bloom on lines and traces.
  - name: Slowmo
    style: Float
    label: Slow-motion Period (s)
    default: 4
    min: 0.5
    max: 30.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 12.0
    help: Seconds one visual sweep of the playhead takes. The real oscillator runs at audio rate; the playhead shows the same cycle slowed down.
parameters:
  parentshortcut: Synth
sequences:
  ext:
  - object: op('./SeriesSynthExt').module.SeriesSynthExt(me)
    name: SeriesSynth
    promote: true
flags:
- -allowCooking
color: [0.3, 0.5, 0.9]
tags:
- tdxn
operators:
- name: viz
  type: baseCOMP
  position: [1000, 0]
  children:
  - name: axes
    type: scriptDAT
    parameters:
      callbacks: axes_callbacks
    position: [200, -800]
    dat_read_only: true
  - name: out1
    type: outTOP
    flags:
    - display
    position: [6200, 0]
    inputs:
    - null_dash
  - name: labels
    type: baseCOMP
    position: [4600, 400]
    children:
    - name: out_dim
      type: outTOP
      position: [1400, -400]
      inputs:
      - text_dim
    - name: out_axis
      type: outTOP
      position: [1400, 0]
      inputs:
      - text_axis
    - name: text_dim
      type: textTOP
      parameters:
        specdat: labels_dim
        font: Consolas
        fontsizex: =12 * op('labels_lib').module.output_scale()
        fontsizey: =12 * op('labels_lib').module.output_scale()
      position: [1000, -400]
    - name: out_title
      type: outTOP
      position: [1400, -200]
      inputs:
      - text_title
    - name: out_value
      type: outTOP
      position: [1400, -600]
      inputs:
      - text_value
    - name: text_axis
      type: textTOP
      parameters:
        specdat: labels_axis
        font: Consolas
        fontsizex: =11 * op('labels_lib').module.output_scale()
        fontsizey: =11 * op('labels_lib').module.output_scale()
      position: [1000, 0]
    - name: labels_dim
      type: scriptDAT
      parameters:
        callbacks: labels_callbacks
      position: [600, -400]
      dat_read_only: true
    - name: labels_lib
      type: textDAT
      parameters:
        file: project1/series_synth/viz/labels/labels_lib.py
        syncfile: true
        language: python
      position: [200, 0]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
    - name: out_header
      type: outTOP
      position: [1400, -800]
      inputs:
      - text_header
    - name: text_title
      type: textTOP
      parameters:
        specdat: labels_title
        font: Bahnschrift
        fontsizex: =13 * op('labels_lib').module.output_scale()
        fontsizey: =13 * op('labels_lib').module.output_scale()
      position: [1000, -200]
    - name: text_value
      type: textTOP
      parameters:
        specdat: labels_value
        font: Consolas
        fontsizex: =12 * op('labels_lib').module.output_scale()
        fontsizey: =12 * op('labels_lib').module.output_scale()
      position: [1000, -600]
    - name: labels_axis
      type: scriptDAT
      parameters:
        callbacks: labels_callbacks
      position: [600, 0]
      dat_read_only: true
    - name: text_header
      type: textTOP
      parameters:
        specdat: labels_header
        font: Bahnschrift
        fontsizex: =22 * op('labels_lib').module.output_scale()
        fontsizey: =22 * op('labels_lib').module.output_scale()
      position: [1000, -800]
    - name: labels_title
      type: scriptDAT
      parameters:
        callbacks: labels_callbacks
      position: [600, -200]
      dat_read_only: true
    - name: labels_value
      type: scriptDAT
      parameters:
        callbacks: labels_callbacks
      position: [600, -600]
      dat_read_only: true
    - name: labels_header
      type: scriptDAT
      parameters:
        callbacks: labels_callbacks
      position: [600, -800]
      dat_read_only: true
    - name: labels_callbacks
      type: textDAT
      parameters:
        file: project1/series_synth/viz/labels/labels_callbacks.py
        syncfile: true
        language: python
      position: [200, -400]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
    annotations:
    - name: annotate1
      mode: annotate
      title: Text layers
      text: 'labels_lib builds every label per layer (axis, title, dim, value, header); the five Script DATs share labels_callbacks and feed one Text TOP each (spec DAT: x, y, text). Only labels_value cooks per frame (live readouts).'
      position: [130, -870]
      size: [1470, 1130]
      color: [0.2, 0.2, 0.28]
  - name: layout
    type: tableDAT
    position: [200, 0]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    dat_content:
    - - name
      - x
      - y
      - w
      - h
      - il
      - ib
      - ir
      - it
    - - header
      - '20'
      - '1012'
      - '1880'
      - '56'
      - '0'
      - '0'
      - '0'
      - '0'
    - - series
      - '20'
      - '700'
      - '1340'
      - '300'
      - '70'
      - '40'
      - '20'
      - '44'
    - - stats
      - '1376'
      - '700'
      - '524'
      - '300'
      - '0'
      - '0'
      - '0'
      - '0'
    - - scope
      - '20'
      - '284'
      - '560'
      - '400'
      - '56'
      - '40'
      - '16'
      - '44'
    - - wt3d
      - '596'
      - '284'
      - '728'
      - '400'
      - '2'
      - '2'
      - '2'
      - '36'
    - - spectrum
      - '1340'
      - '284'
      - '560'
      - '400'
      - '56'
      - '40'
      - '16'
      - '44'
    - - sonogram
      - '20'
      - '20'
      - '1180'
      - '248'
      - '70'
      - '34'
      - '20'
      - '36'
    - - env
      - '1216'
      - '20'
      - '684'
      - '248'
      - '44'
      - '34'
      - '214'
      - '36'
    dat_content_format: table
  - name: scene3d
    type: baseCOMP
    position: [4600, 0]
    children:
    - name: cam_3d
      type: cameraCOMP
      parameters:
        xord: trs
        ty: -0.32
        tz: =10.2 + 0.5 * math.sin(6.0 * math.pi * parent.Synth.op('viz/speed_vis')['orbit'] + 2.0)
        rx: =-(35.0 + 4.0 * math.sin(4.0 * math.pi * parent.Synth.op('viz/speed_vis')['orbit'] + 0.7))
        ry: =11.0 * math.sin(2.0 * math.pi * parent.Synth.op('viz/speed_vis')['orbit']) + 4.0 * math.sin(6.0 * math.pi * parent.Synth.op('viz/speed_vis')['orbit'] + 1.3)
        fov: 24
      position: [1000, -400]
      size: [160, 130]
      color: [0.67, 0.67, 0.67]
      children:
      - name: file1
        type: fileinPOP
        parameters:
          file: =app.samplesFolder + '/Geo/defcam.tog'
        flags:
        - display
        - viewer
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
    - name: geo_floor
      type: geometryCOMP
      parameters:
        material: mat_floor
      position: [200, -1200]
      children:
      - name: null_out
        type: nullPOP
        position: [600, 0]
        inputs:
        - grid_floor
      - name: grid_floor
        type: gridPOP
        parameters:
          surftype: linestrips
          sizex: 3.8
          sizey: 3.6
          sizez: 3
          cols: 17
          rows: 13
          planex: false
          planez: true
          ty: -0.442
        position: [200, 0]
      annotations:
      - name: annotate1
        mode: annotate
        title: Floor grid
        text: Reference grid under the stack (mat_floor colours).
        position: [130, -190]
        size: [670, 450]
        color: [0.08, 0.24, 0.28]
    - name: mat_floor
      type: lineMAT
      parameters:
        widthnear: 1.4
        widthfar: 0.8
        linenearcolorr: 0.1
        linenearcolorg: 0.17
        linenearcolorb: 0.32
        linefarcolorr: 0.02
        linefarcolorg: 0.04
        linefarcolorb: 0.1
        linecoloratt: ''
      position: [600, -1200]
    - name: mat_lines
      type: lineMAT
      parameters:
        widthnear: 1.7
        widthfar: 1.3
      position: [600, 0]
    - name: render_3d
      type: renderTOP
      parameters:
        camera: cam_3d
        lights: ''
        antialias: aa8
        resolutionw: =int(round(724 * parent.Synth.op('viz/labels/labels_lib').module.output_scale()))
        resolutionh: =int(round(362 * parent.Synth.op('viz/labels/labels_lib').module.output_scale()))
        format: rgba16float
      position: [1400, -400]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
    - name: geo_frames
      type: geometryCOMP
      parameters:
        material: mat_lines
      position: [200, 0]
      children:
      - name: null_out
        type: nullPOP
        position: [1000, 0]
        inputs:
        - glsl_frames
      - name: glsl_frames
        type: glslPOP
        parameters:
          computedat: glsl_frames_compute
        sequences:
          attr:
          - name: color
          - name: linewidth
          vec:
          - name: uState
            type: vec4
            valuex: =parent.Synth.op('engine/script_window')['scanfrac']
            valuey: =parent.Synth.op('engine/trigger_amp')['ampenv']
            valuez: =parent.Synth.op('viz/speed_vis')['slow']
          - name: uShape
            type: vec4
            valuex: 3.5
            valuey: 0.26
            valuez: 1.3
            valuew: =me.inputs[0].par.rows
          sampler:
          - name: sFrames
            top: =parent.Synth.op('viz/chopto_frames')
            extendu: repeat
          - name: sWave
            top: =parent.Synth.op('viz/chopto_wave')
            extendu: repeat
        position: [600, 0]
        inputs:
        - grid_frames
      - name: grid_frames
        type: gridPOP
        parameters:
          surftype: linestrips
          cols: 256
          rows: =parent.Synth.op('engine/null_frames').numChans
          liney: false
        position: [200, 0]
      - name: glsl_frames_info
        type: infoDAT
        parameters:
          op: glsl_frames
        position: [675, -120]
        dock: glsl_frames
        dat_read_only: true
      - name: glsl_frames_compute
        type: textDAT
        parameters:
          file: project1/series_synth/viz/scene3d/geo_frames/glsl_frames_compute.glsl
          syncfile: true
          language: glsl
        flags:
        - viewer
        position: [525, -120]
        color: [0.9, 0.3, 0.4]
        tags:
        - glsl
        dock: glsl_frames
      annotations:
      - name: annotate1
        mode: annotate
        title: History lines
        text: grid rows = frames in engine/null_frames; glsl_frames mode 0 owns the shared compute shader.
        position: [130, -190]
        size: [1070, 450]
        color: [0.08, 0.24, 0.28]
    - name: out_render
      type: outTOP
      position: [1800, -400]
      inputs:
      - render_3d
    - name: geo_current
      type: geometryCOMP
      parameters:
        material: mat_current
      position: [200, -800]
      children:
      - name: null_out
        type: nullPOP
        position: [1000, 0]
        inputs:
        - glsl_current
      - name: glsl_current
        type: glslPOP
        parameters:
          computedat: =parent.Synth.op('viz/scene3d/geo_frames/glsl_frames_compute')
        sequences:
          attr:
          - name: color
          - name: linewidth
          vec:
          - name: uState
            type: vec4
            valuex: =parent.Synth.op('viz/scene3d/geo_frames/glsl_frames').par.vec0valuex
            valuey: =parent.Synth.op('viz/scene3d/geo_frames/glsl_frames').par.vec0valuey
            valuez: =parent.Synth.op('viz/scene3d/geo_frames/glsl_frames').par.vec0valuez
            valuew: 2
          - name: uShape
            type: vec4
            valuex: =parent.Synth.op('viz/scene3d/geo_frames/glsl_frames').par.vec1valuex
            valuey: =parent.Synth.op('viz/scene3d/geo_frames/glsl_frames').par.vec1valuey
            valuez: =parent.Synth.op('viz/scene3d/geo_frames/glsl_frames').par.vec1valuez
            valuew: =me.inputs[0].par.rows
          sampler:
          - name: sFrames
            top: =parent.Synth.op('viz/chopto_frames')
            extendu: repeat
          - name: sWave
            top: =parent.Synth.op('viz/chopto_wave')
            extendu: repeat
        position: [600, 0]
        inputs:
        - grid_current
      - name: grid_current
        type: gridPOP
        parameters:
          surftype: linestrips
          cols: 512
          rows: 1
          liney: false
        position: [200, 0]
      - name: glsl_current_info
        type: infoDAT
        parameters:
          op: glsl_current
        position: [600, -120]
        dock: glsl_current
        dat_read_only: true
      annotations:
      - name: annotate1
        mode: annotate
        title: Live cycle
        text: One 512-point line; glsl_current mode 2 reads the playing table and adds the playhead spark.
        position: [130, -190]
        size: [1070, 450]
        color: [0.08, 0.24, 0.28]
    - name: geo_terrain
      type: geometryCOMP
      parameters:
        material: mat_terrain
      position: [200, -400]
      children:
      - name: null_out
        type: nullPOP
        position: [1000, 0]
        inputs:
        - glsl_terrain
      - name: glsl_terrain
        type: glslPOP
        parameters:
          computedat: =parent.Synth.op('viz/scene3d/geo_frames/glsl_frames_compute')
        sequences:
          attr:
          - name: color
          - name: linewidth
          vec:
          - name: uState
            type: vec4
            valuex: 0
            valuew: 1
          - name: uShape
            type: vec4
            valuex: =parent.Synth.op('viz/scene3d/geo_frames/glsl_frames').par.vec1valuex
            valuey: =parent.Synth.op('viz/scene3d/geo_frames/glsl_frames').par.vec1valuey
            valuez: =parent.Synth.op('viz/scene3d/geo_frames/glsl_frames').par.vec1valuez
            valuew: =me.inputs[0].par.rows
          sampler:
          - name: sFrames
            top: =parent.Synth.op('viz/chopto_frames')
            extendu: repeat
          - name: sWave
            top: =parent.Synth.op('viz/chopto_wave')
            extendu: repeat
        position: [600, 0]
        inputs:
        - grid_terrain
      - name: grid_terrain
        type: gridPOP
        parameters:
          cols: 256
          rows: =2 * parent.Synth.op('engine/null_frames').numChans
        position: [200, 0]
      - name: glsl_terrain_info
        type: infoDAT
        parameters:
          op: glsl_terrain
        position: [600, -120]
        dock: glsl_terrain
        dat_read_only: true
      annotations:
      - name: annotate1
        mode: annotate
        title: Ridgeline curtains
        text: Two grid rows per frame (line, floor); glsl_terrain mode 1, rendered with mat_terrain (black, polygon offset).
        position: [130, -190]
        size: [1070, 450]
        color: [0.08, 0.24, 0.28]
    - name: mat_current
      type: lineMAT
      parameters:
        widthnear: 1.7
        widthfar: 1.7
        depthtest: false
      position: [600, -800]
    - name: mat_terrain
      type: constantMAT
      parameters:
        colorr: 0.012
        colorg: 0.016
        colorb: 0.03
        skelrootpath: =parent()
        cullface: neither
        polygonoffset: true
        polygonoffsetunits: 4
      position: [600, -400]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
    annotations:
    - name: annotate1
      mode: annotate
      title: 3D wavetable scene
      text: 'Three glslPOPs share geo_frames/glsl_frames_compute: history lines (geo_frames), black curtains for ridgeline occlusion (geo_terrain), the live cycle on top (geo_current, depth test off). cam_3d orbits with eased layered sines (Orbit).'
      position: [130, -1270]
      size: [1870, 1640]
      color: [0.08, 0.24, 0.28]
  - name: glsl_sono
    type: glslTOP
    parameters:
      pixeldat: glsl_sono_pixel
      computedat: glsl_sono_compute
      outputresolution: custom
      resolutionw: 512
      format: rgba16float
    sequences:
      vec:
      - name: uSono
        valuex: 20
        valuey: 20000
        valuez: 22050
    position: [3400, -1000]
    inputs:
    - null_specsmooth
    - feedback_sono
  - name: null_dash
    type: nullTOP
    position: [5800, 0]
    inputs:
    - bloom_dash
  - name: null_sono
    type: nullTOP
    position: [3800, -1000]
    inputs:
    - glsl_sono
  - name: speed_vis
    type: speedCHOP
    position: [600, -1200]
    inputs:
    - const_visrate
  - name: bloom_dash
    type: bloomTOP
    parameters:
      bloomthreshold: 0.55
      bloomintensity: =0.9 * parent.Synth.par.Glow
      format: rgba8fixed
    position: [5400, 0]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - glsl_dashboard
  - name: chopto_env
    type: choptoTOP
    parameters:
      chop: ../engine/null_env
    position: [1800, -800]
  - name: const_sono
    type: constantTOP
    parameters:
      colorr: 0
      colorg: 0
      colorb: 0
      outputresolution: custom
      resolutionw: 512
      format: rgba16float
    position: [2600, -1000]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: chopto_harm
    type: choptoTOP
    parameters:
      chop: ../engine/null_harmonics
    position: [1800, -1000]
  - name: chopto_wave
    type: choptoTOP
    parameters:
      chop: ../engine/null_wavetable
    position: [1800, -200]
  - name: chopto_scope
    type: choptoTOP
    parameters:
      chop: ../engine/null_scope
    position: [1800, -400]
  - name: datto_layout
    type: dattoCHOP
    parameters:
      dat: layout
      firstcolumn: ignored
    position: [600, 0]
  - name: select_rects
    type: selectCHOP
    parameters:
      channames: x y w h
    position: [1000, 0]
    inputs:
    - datto_layout
  - name: chopto_frames
    type: choptoTOP
    parameters:
      chop: ../engine/null_frames
    position: [1800, -1200]
  - name: chopto_series
    type: choptoTOP
    parameters:
      chop: ../engine/null_series
    position: [1800, 0]
  - name: const_visrate
    type: constantCHOP
    sequences:
      const:
      - name: slow
        value: =1.0 / parent.Synth.par.Slowmo
      - name: orbit
        value: =parent.Synth.par.Orbit / 90.0
    position: [200, -1200]
  - name: feedback_sono
    type: feedbackTOP
    parameters:
      top: null_sono
    position: [3000, -1000]
    inputs:
    - const_sono
  - name: feedback_spec
    type: feedbackTOP
    parameters:
      top: null_specsmooth
    position: [2200, -600]
    inputs:
    - chopto_spectrum
  - name: select_insets
    type: selectCHOP
    parameters:
      channames: il ib ir it
    position: [1000, -400]
    inputs:
    - datto_layout
  - name: axes_callbacks
    type: textDAT
    parameters:
      file: project1/series_synth/viz/axes_callbacks.py
      syncfile: true
      language: python
    flags:
    - viewer
    position: [200, -920]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
    dock: axes
  - name: glsl_dashboard
    type: glslmultiTOP
    parameters:
      pixeldat: glsl_dashboard_pixel
      computedat: glsl_dashboard_compute
      outputresolution: custom
      resolutionw: 1280
      resolutionh: 720
      format: rgba16float
    sequences:
      vec:
      - name: uAxisS
        valuex: =float(op('axes')['ymin', 1])
        valuey: =float(op('axes')['ymax', 1])
        valuez: =float(op('axes')['ystep', 1])
        valuew: =float(op('axes')['tmin', 1])
      - name: uAxisT
        valuex: =float(op('axes')['tmax', 1])
        valuey: =float(op('axes')['t0', 1])
        valuez: =float(op('axes')['n', 1])
      - name: uWin
        valuex: =parent.Synth.op('engine/script_window')['start']
        valuey: =parent.Synth.op('engine/script_window')['length']
        valuez: =parent.Synth.op('engine/script_window')['scanfrac']
        valuew: =op('speed_vis')['slow']
      - name: uPitch
        valuex: =parent.Synth.op('engine/lag_glide')['hz']
        valuey: =parent.Synth.op('engine/script_window')['kmax']
        valuez: =parent.Synth.op('engine/expr_cutoff')['cutofffrequency']
        valuew: =1.0 if parent.Synth.par.Loopmode.eval() == 'pingpong' else 0.0
      - name: uEnv
        valuex: =parent.Synth.op('engine/expr_gate')['gate']
        valuey: =parent.Synth.op('engine/trigger_amp')['ampenv']
        valuez: =parent.Synth.op('engine/trigger_filt')['filtenv']
        valuew: =parent.Synth.op('engine/analyze_rms')[0]
      - name: uFilt
        valuex: =parent.Synth.par.Cutoff
        valuey: =parent.Synth.par.Resonance
        valuez: =float(parent.Synth.par.Rolloff.eval())
        valuew: =parent.Synth.par.Filtertype.menuIndex
      - name: uMisc
        valuex: =(absTime.frame % 216000) / 60.0
        valuey: =parent.Synth.par.Glow
        valuez: =parent.Synth.par.Volume
      array:
      - name: uRects
        type: vec4
        chop: select_rects
      - name: uInsets
        type: vec4
        chop: select_insets
    position: [5000, 0]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - chopto_series
    - chopto_wave
    - chopto_scope
    - null_specsmooth
    - null_sono
    - scene3d
    - chopto_env
    - chopto_harm
    - labels
    - source: labels
      out: 3
    - source: labels
      out: 1
    - source: labels
      out: 4
    - source: labels
      out: 2
  - name: glsl_sono_info
    type: infoDAT
    parameters:
      op: glsl_sono
    position: [3475, -1120]
    dock: glsl_sono
    dat_read_only: true
  - name: chopto_spectrum
    type: choptoTOP
    parameters:
      chop: ../engine/null_spectrum
    position: [1800, -600]
  - name: glsl_sono_pixel
    type: textDAT
    parameters:
      file: project1/series_synth/viz/glsl_sono_pixel.glsl
      syncfile: true
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [3325, -1120]
    color: [0.9, 0.3, 0.4]
    tags:
    - glsl
    dock: glsl_sono
  - name: glsl_specsmooth
    type: glslTOP
    parameters:
      pixeldat: glsl_specsmooth_pixel
      computedat: glsl_specsmooth_compute
      format: rgba32float
    sequences:
      vec:
      - name: uSmooth
        valuex: 0.6
        valuey: 0.12
        valuez: 0.004
        valuew: 14
    position: [2600, -600]
    inputs:
    - chopto_spectrum
    - feedback_spec
  - name: null_specsmooth
    type: nullTOP
    position: [3000, -600]
    inputs:
    - glsl_specsmooth
  - name: glsl_dashboard_info
    type: infoDAT
    parameters:
      op: glsl_dashboard
    position: [5075, -120]
    dock: glsl_dashboard
    dat_read_only: true
  - name: glsl_dashboard_pixel
    type: textDAT
    parameters:
      file: project1/series_synth/viz/glsl_dashboard_pixel.glsl
      syncfile: true
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [4925, -120]
    color: [0.9, 0.3, 0.4]
    tags:
    - glsl
    dock: glsl_dashboard
  - name: glsl_specsmooth_info
    type: infoDAT
    parameters:
      op: glsl_specsmooth
    position: [2675, -720]
    dock: glsl_specsmooth
    dat_read_only: true
  - name: glsl_specsmooth_pixel
    type: textDAT
    parameters:
      file: project1/series_synth/viz/glsl_specsmooth_pixel.glsl
      syncfile: true
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [2525, -720]
    color: [0.9, 0.3, 0.4]
    tags:
    - glsl
    dock: glsl_specsmooth
  annotations:
  - name: annotate1
    mode: annotate
    title: Layout, axes, timing
    text: layout = panel rectangles in 1920x1080 design units (shader + labels read it). axes = shared plot ranges. speed_vis integrates the slow-motion playhead (1/Slowmo) and camera orbit (Orbit/90) phases, both looping 0-1.
    position: [130, -1270]
    size: [1070, 1530]
    color: [0.2, 0.2, 0.28]
  - name: annotate2
    mode: annotate
    title: Data textures + frequency feedback
    text: 'chopto_* turn engine CHOPs into float textures (channel 0 = bottom row). glsl_specsmooth: spectrum -> dB 0-1 (smoothed, peak hold, instant) via feedback. glsl_sono: scrolling sonogram, one column per frame, log frequency rows.'
    position: [1730, -1270]
    size: [2270, 1530]
    color: [0.27, 0.1, 0.24]
  - name: annotate3
    mode: annotate
    title: 'Compose: dashboard shader + bloom'
    text: glsl_dashboard draws all eight panels from the data textures, the 3D render and five text layers (labels); resolution 1280x720 (Non-Commercial cap) with geometry in design units. bloom_dash adds the neon glow (intensity follows Glow).
    position: [4530, -190]
    size: [1870, 890]
    color: [0.08, 0.24, 0.28]
- name: data
  type: baseCOMP
  position: [200, 0]
  children:
  - name: raw_csv
    type: textDAT
    position: [600, 0]
    color: [0.67, 0.67, 0.67]
    dat_content: |
      "",BBIM1.M.DE.B.A2C.A.B.A.2250.EUR.N,BBIM1.M.DE.B.A2C.A.B.A.2250.EUR.N_FLAGS
      "",New business (volumes) of German banks / Housing loans to households / SUD231,
      Comment (in english),"The MFI interest rate statistics gathered on a harmonised basis in the euro area are collected in Germany on a sample basis (stratified sample). The reported volumes of new business are grossed up to form total results for Germany. Up to May 2010 the weighting scheme followed the Horvitz-Thomson estimator (an individual expansion factor for each reporting agent). From June 2010 for each stratum an individual expansion factor is used to gross-up the reported volumes of all reporting agents of the same stratum. Then the grossed-up volumes per stratum are added to calculate the aggregated volume of new business. Secured and unsecured loans for home purchase, including building and home improvements; including loans granted by building and loan associations and interim credits as well as transmitted loans granted by the reporting agents in their own name and for their own account. Excluding overdrafts.",
      Decimals,0,
      Time format code,P1M,
      category,ZREK,
      unit,EURO,
      unit multiplier,Millions,
