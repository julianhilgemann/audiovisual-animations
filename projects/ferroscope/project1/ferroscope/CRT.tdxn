  dat_content_format: table
- name: blur_halo
  type: blurTOP
  parameters:
    extend: mirror
    size: =parent.CRT.par.Halosize * 0.5
    outputresolution: half
  position: [800, -400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - glsl_signal
- name: glsl_tube
  type: glslTOP
  parameters:
    pixeldat: glsl_tube_pixel
  sequences:
    color:
    - name: uHalo
      rgbr: =parent.CRT.par.Halotintr
      rgbg: =parent.CRT.par.Halotintg
      rgbb: =parent.CRT.par.Halotintb
    - name: uBezel
      rgbr: =parent.CRT.par.Bezelcolorr
      rgbg: =parent.CRT.par.Bezelcolorg
      rgbb: =parent.CRT.par.Bezelcolorb
    - name: uTint
      rgbr: =parent.CRT.par.Colortintr
      rgbg: =parent.CRT.par.Colortintg
      rgbb: =parent.CRT.par.Colortintb
    vec:
    - name: uGeom
      valuex: =parent.CRT.par.Curvature
      valuey: =parent.CRT.par.Corner
      valuez: =parent.CRT.par.Vignette
      valuew: =parent.CRT.par.Screensize
    - name: uScan
      valuex: =parent.CRT.par.Lines
      valuey: =parent.CRT.par.Scandepth
      valuez: =parent.CRT.par.Beam
      valuew: =parent.CRT.par.Convergence
    - name: uMask
      valuex: =parent.CRT.par.Masktype.menuIndex
      valuey: =parent.CRT.par.Maskpitch
      valuez: =parent.CRT.par.Maskdepth
      valuew: =parent.CRT.par.Brightness
    - name: uTube
      valuex: =parent.CRT.par.Halation
      valuey: =parent.CRT.par.Blacklevel
      valuez: =parent.CRT.par.Saturation
      valuew: =absTime.frame % 2
    - name: uScan2
      valuex: =parent.CRT.par.Scandir.menuIndex
      valuey: =parent.CRT.par.Interlace
      valuez: =parent.CRT.par.Humbar
      valuew: =(absTime.seconds * parent.CRT.par.Humspeed) % 1
    - name: uMask2
      valuex: =parent.CRT.par.Masksoft
      valuey: =parent.CRT.par.Maskcurved
      valuez: =parent.CRT.par.Glare
      valuew: =parent.CRT.par.Edgesoft
    - name: uGlow
      valuex: =parent.CRT.par.Halothreshold
      valuey: =parent.CRT.par.Diffusion
      valuez: =min(parent.CRT.par.Persistence, 0.97)
      valuew: =parent.CRT.par.Phosphor.menuIndex
    - name: uGrade
      valuex: =parent.CRT.par.Contrast
      valuey: =parent.CRT.par.Gamma
  position: [1200, 0]
  inputs:
  - glsl_signal
  - blur_halo
  - feedback_persist
- name: glsl_signal
  type: glslTOP
  parameters:
    pixeldat: glsl_signal_pixel
  sequences:
    vec:
    - name: uSig
      valuex: =parent.CRT.par.Smear
      valuey: =parent.CRT.par.Ghost
      valuez: =parent.CRT.par.Jitter
      valuew: =parent.CRT.par.Tracking
    - name: uTime
      valuex: =absTime.seconds % 600
      valuey: =absTime.frame % 997
      valuez: =parent.CRT.par.Grain
      valuew: =parent.CRT.par.Lines
    - name: uSig2
      valuex: =parent.CRT.par.Pixelate
      valuey: =parent.CRT.par.Chromashift
      valuez: =parent.CRT.par.Ghostoffset
      valuew: =parent.CRT.par.Wave
    - name: uSig3
      valuex: =parent.CRT.par.Wavefreq
      valuey: =parent.CRT.par.Headswitch
      valuez: =parent.CRT.par.Trackspeed
      valuew: =parent.CRT.par.Trackheight
    - name: uSig4
      valuex: =parent.CRT.par.Roll
      valuey: =parent.CRT.par.Dropouts
      valuez: =parent.CRT.par.Chromanoise
      valuew: =parent.CRT.par.Flicker
    - name: uDir
      valuex: =parent.CRT.par.Scandir.menuIndex
  position: [400, 0]
  inputs:
  - in1
- name: switch_enable
  type: switchTOP
  parameters:
    index: =parent.CRT.par.Enable
  position: [1600, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - in1
  - glsl_tube
- name: glsl_tube_info
  type: infoDAT
  parameters:
    op: glsl_tube
  position: [1275, -120]
  dock: glsl_tube
  dat_read_only: true
- name: glsl_tube_pixel
  type: textDAT
  position: [1125, -120]
  dock: glsl_tube
  dat_content: |
    // CRT filter, tube stage: curved glass with rounded corners and glare, convergence error,
    // scanlines whose beam widens on bright colours (horizontal or vertical), interlace and a
    // hum bar, a phosphor mask, halation and diffusion, grading, monochrome phosphors and
    // phosphor persistence. Input 0: the signal stage. Input 1: the signal blurred (glow source).
    // Input 2: this stage's previous output (persistence feedback).

    uniform vec4 uGeom;   // x curvature, y corner radius, z vignette, w screen size
    uniform vec4 uScan;   // x scanline count, y scanline depth, z beam bloom, w convergence (px)
    uniform vec4 uMask;   // x mask (0 off, 1 shadow, 2 aperture grille, 3 slot), y pitch (px), z depth, w brightness
    uniform vec4 uTube;   // x halation, y black level, z saturation, w field (frame parity)
    uniform vec4 uScan2;  // x scan direction (0 horizontal, 1 vertical), y interlace, z hum bar, w hum phase 0-1
    uniform vec4 uMask2;  // x dot softness, y mask follows glass, z glare, w edge softness
    uniform vec4 uGlow;   // x halation threshold, y diffusion, z persistence, w phosphor (0 colour, 1 green, 2 amber, 3 white)
    uniform vec4 uGrade;  // x contrast, y gamma
    uniform vec4 uHalo;   // halation tint
    uniform vec4 uBezel;  // colour outside the tube
    uniform vec4 uTint;   // white point

    layout(location = 0) out vec4 fragColor;

    const vec3 LUMA = vec3(0.299, 0.587, 0.114);

    // Phosphor pattern at pixel p; each channel lights a third of the pattern.
    vec3 phosphorMask(vec2 p, float pitch, float type, float soft) {
        float inner = mix(0.5, 0.05, soft);
        if (type < 1.5) {
            // Shadow mask: round R, G, B dots; every other row shifted by half a triad.
            vec2 g = p / pitch;
            g.x += mod(floor(g.y), 2.0) * 1.5;
            float c = mod(floor(g.x), 3.0);
            float dotShape = 1.0 - smoothstep(inner * 0.6, 0.6, length(fract(g) - 0.5));
            return vec3(c < 0.5, c > 0.5 && c < 1.5, c > 1.5) * dotShape;
        }
        float c = mod(floor(p.x / pitch), 3.0);
        float across = abs(fract(p.x / pitch) - 0.5);
        vec3 stripe = vec3(c < 0.5, c > 0.5 && c < 1.5, c > 1.5) * (1.0 - smoothstep(inner, 0.55, across));
        if (type < 2.5) {
            return stripe;  // aperture grille: continuous vertical stripes
        }
        // Slot mask: stripes broken into slots, staggered every other triad.
        float slotY = fract(p.y / (pitch * 3.0) + 0.5 * mod(floor(p.x / (pitch * 3.0)), 2.0));
        float gap = mix(0.12, 0.3, soft);
        return stripe * smoothstep(0.0, gap, slotY) * smoothstep(1.0, 1.0 - gap, slotY);
    }

    vec3 phosphorColor(float mode) {
        return mode < 1.5 ? vec3(0.25, 1.0, 0.4) : mode < 2.5 ? vec3(1.0, 0.62, 0.12) : vec3(0.92, 0.95, 1.0);
    }

    void main() {
        vec2 res = uTD2DInfos[0].res.zw;
        vec2 asp = vec2(res.x / res.y, 1.0);
        bool vert = uScan2.x > 0.5;
        bool mono = uGlow.w > 0.5;

        // Curved glass: the picture bends outward toward the edges.
        vec2 c = (vUV.st * 2.0 - 1.0) / max(uGeom.w, 0.1);
        c *= 1.0 + uGeom.x * 0.3 * vec2(c.y * c.y, c.x * c.x);
        vec2 cuv = c * 0.5 + 0.5;

        // Rounded screen edge (aspect-correct), vignette, and a glare spot on the glass.
        vec2 q = abs(c) * asp - (asp - uGeom.y);
        float edge = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - uGeom.y;
        float soft = 0.004 + 0.06 * uMask2.w;
        float screen = 1.0 - smoothstep(-soft, soft, edge);
        vec2 v = clamp(cuv * (1.0 - cuv), 0.0, 1.0);
        float vig = mix(1.0, pow(16.0 * v.x * v.y, 0.3), uGeom.z);
        vec2 gp = (c - vec2(-0.45, 0.5)) * vec2(1.0, 1.8);
        float glare = uMask2.z * 0.12 * exp(-dot(gp, gp) * 3.0);

        // Scanlines in scan space: a.x runs along a line, a.y across lines. Each line shows one
        // row of the picture; red and blue land slightly off along the line.
        vec2 a = vert ? cuv.yx : cuv;
        float lines = max(uScan.x, 16.0);
        float ly = a.y * lines;
        float f = fract(ly) - 0.5;
        float row = (floor(ly) + 0.5) / lines;
        float conv = uScan.w / (vert ? res.y : res.x);
        vec2 sR = vec2(a.x + conv, row);
        vec2 sG = vec2(a.x, row);
        vec2 sB = vec2(a.x - conv, row);
        vec3 src = vec3(texture(sTD2DInputs[0], vert ? sR.yx : sR).r,
                        texture(sTD2DInputs[0], vert ? sG.yx : sG).g,
                        texture(sTD2DInputs[0], vert ? sB.yx : sB).b);
        if (mono) {
            src = vec3(dot(src, LUMA));
        }
        // Beam profile: brighter channels draw wider lines; normalised so brightness holds.
        vec3 sigma = 0.17 + 0.25 * uScan.z * clamp(src, 0.0, 1.0);
        vec3 beam = exp(-f * f / (2.0 * sigma * sigma)) / min(sigma * 2.4, vec3(1.0));
        vec3 col = src * mix(vec3(1.0), beam, uScan.y);

        // Interlace: on alternate frames every other line is dimmer. Hum bar: a soft rolling band.
        col *= 1.0 - uScan2.y * 0.6 * abs(mod(floor(ly), 2.0) - uTube.w);
        float hum = pow(0.5 + 0.5 * sin(6.2831853 * (cuv.y - uScan2.w)), 6.0);
        col *= 1.0 + uScan2.z * (hum - 0.15) * 0.6;

        // Phosphor mask, flat on the output or bent with the glass. A monochrome tube shows the
        // dot pattern without colour.
        if (uMask.x > 0.5) {
            vec2 mp = uMask2.y > 0.5 ? cuv * res : gl_FragCoord.xy;
            if (vert) {
                mp = mp.yx;
            }
            vec3 m = phosphorMask(mp, max(uMask.y, 1.0), uMask.x, uMask2.x);
            m = mono ? vec3(m.r + m.g + m.b) : 3.0 * m;
            col *= mix(vec3(1.0), m, uMask.z);
        }

        // Halation (thresholded, tinted, squared so highlights glow) and untinted glass diffusion.
        vec3 glow = texture(sTD2DInputs[1], cuv).rgb;
        if (mono) {
            glow = vec3(dot(glow, LUMA));
        }
        vec3 hot = max(glow - uGlow.x, 0.0) / max(1.0 - uGlow.x, 0.05);
        col += hot * hot * uHalo.rgb * uTube.x + glow * uGlow.y * 0.5;

        // Grade: brightness, contrast, gamma, saturation, white point, phosphor colour, black level.
        col *= uMask.w;
        col = max((col - 0.5) * uGrade.x + 0.5, 0.0);
        col = pow(col, vec3(1.0 / max(uGrade.y, 0.05)));
        col = mix(vec3(dot(col, LUMA)), col, uTube.z) * uTint.rgb;
        if (mono) {
            col = dot(col, LUMA) * phosphorColor(uGlow.w);
        }
        col = (uTube.y + col * (1.0 - uTube.y)) * vig;

        // Persistence: the phosphor keeps glowing as the beam moves on (max, so it never builds up).
        vec3 lit = max(col + vec3(0.9, 0.95, 1.0) * glare, texture(sTD2DInputs[2], vUV.st).rgb * uGlow.z);
        fragColor = TDOutputSwizzle(vec4(mix(uBezel.rgb, lit, screen), 1.0));
    }
  dat_content_format: text
- name: feedback_persist
  type: feedbackTOP
  parameters:
    top: glsl_tube
  position: [800, -600]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - glsl_signal
- name: glsl_signal_info
  type: infoDAT
  parameters:
    op: glsl_signal
  position: [475, -120]
  dock: glsl_signal
  dat_read_only: true
- name: preset_callbacks
  type: parameterexecuteDAT
  parameters:
    fromop: =parent()
    op: ..
    pars: Applypreset
    valuechange: false
    builtin: false
  position: [2000, -400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dat_content: "# Apply Preset: copy one column of the presets table onto this filter's parameters.\n# Rows are parameter names (RGB colours as their r/g/b parts); a blank cell leaves that\n# parameter alone. Add a column to the table to make your own preset, and add its name to\n# the Preset menu (Component Editor) to pick it.\n\ndef _applyPreset(comp):\n\t\"\"\"Set every parameter listed in the presets table from the chosen preset's column.\"\"\"\n\ttable = comp.op('presets')\n\tname = comp.par.Preset.eval()\n\tif table is None or table.col(name) is None:\n\t\tdebug('CRT: no preset column named', name)\n\t\treturn\n\tfor row in range(1, table.numRows):\n\t\tpar = comp.par[table[row, 0].val]\n\t\tcell = table[row, name].val\n\t\tif par is None or cell == '':\n\t\t\tcontinue\n\t\tif par.isMenu:\n\t\t\tpar.val = cell\n\t\telif par.isInt or par.isToggle:\n\t\t\tpar.val = int(float(cell))\n\t\telse:\n\t\t\tpar.val = float(cell)\n\ndef onPulse(par):\n\tif par.name == 'Applypreset':\n\t\t_applyPreset(par.owner)\n\treturn\n"
  dat_content_format: text
- name: glsl_signal_pixel
  type: textDAT
  position: [325, -120]
  dock: glsl_signal
  dat_content: |
    // CRT filter, analog signal stage: line jitter, a horizontal wave, a rolling tracking-noise
    // band, VHS head-switching tear, vertical roll, optional pixelation, smear in which colour
    // (I, Q) bleeds further and later than brightness (Y), a ghost echo, dropouts, grain,
    // colour noise and flicker. With a vertical scan direction everything runs along columns.
    // Input 0: the source image.

    uniform vec4 uSig;   // x smear 0-1, y ghost 0-1, z line jitter (px), w tracking band 0-1
    uniform vec4 uTime;  // x time (s, wraps every 600 s), y frame (wrapped), z grain, w scanline count
    uniform vec4 uSig2;  // x source columns (0 = off), y chroma delay (px), z ghost offset (px), w wave (px)
    uniform vec4 uSig3;  // x wave cycles per picture, y head switching 0-1, z tracking speed, w tracking height
    uniform vec4 uSig4;  // x vertical roll (screens/s), y dropouts 0-1, z colour noise, w flicker 0-1
    uniform vec4 uDir;   // x scan direction (0 horizontal, 1 vertical)

    layout(location = 0) out vec4 fragColor;

    const mat3 RGB2YIQ = mat3(0.299, 0.596, 0.211, 0.587, -0.274, -0.523, 0.114, -0.322, 0.312);
    const mat3 YIQ2RGB = mat3(1.0, 1.0, 1.0, 0.956, -0.272, -1.106, 0.621, -0.647, 1.703);

    bool vert;

    float hash(vec2 p) {
        vec3 p3 = fract(vec3(p.xyx) * 0.1031);
        p3 += dot(p3, p3.yzx + 33.33);
        return fract((p3.x + p3.y) * p3.z);
    }

    // Sample the source in scan space (x along a line, y across lines), optionally pixelated.
    vec3 source(vec2 s) {
        if (uSig2.x >= 2.0) {
            s.x = (floor(s.x * uSig2.x) + 0.5) / uSig2.x;
        }
        return texture(sTD2DInputs[0], vert ? s.yx : s).rgb;
    }

    void main() {
        vert = uDir.x > 0.5;
        vec2 uv = vert ? vUV.st.yx : vUV.st;
        vec2 px = vert ? uTD2DInfos[0].res.yx : uTD2DInfos[0].res.xy;
        float t = uTime.x;
        float frame = uTime.y;

        // Vertical roll: the picture slides through a dark blanking bar.
        float y = fract(uv.y + t * uSig4.x);
        float blank = abs(uSig4.x) > 1e-4 ? smoothstep(0.0, 0.025, y) * smoothstep(1.0, 0.975, y) : 1.0;
        float line = floor(y * max(uTime.w, 1.0));

        // Tracking band rolling down; head-switching tear along the bottom; wave; line jitter.
        float band = uSig.w * exp(-pow((y - (1.0 - fract(t * uSig3.z))) / max(uSig3.w, 0.002), 2.0));
        float tear = hash(vec2(line, frame)) - 0.5;
        float head = uSig3.y * pow(smoothstep(0.06, 0.0, y), 1.5);
        float wave = uSig2.w * sin(6.2831853 * (y * uSig3.x + t * 0.7));
        float shift = tear * (uSig.z + band * 40.0) + wave + head * (30.0 + 40.0 * tear);
        vec2 s = vec2(uv.x + shift * px.x, y);

        // Smear: an exponentially fading trail to the left; colour bleeds further, and later.
        float decayY = 0.6 * uSig.x;
        float decayC = mix(0.35, 0.9, uSig.x);
        float wY = 1.0, wC = 1.0, sumY = 0.0, sumC = 0.0, accY = 0.0;
        vec2 accC = vec2(0.0);
        for (int i = 0; i < 10; i++) {
            float o = float(i) * 1.5 * px.x;
            accY += (RGB2YIQ * source(s - vec2(o, 0.0))).x * wY;
            accC += (RGB2YIQ * source(s - vec2(o + uSig2.y * px.x, 0.0))).yz * wC;
            sumY += wY; wY *= decayY;
            sumC += wC; wC *= decayC;
        }
        vec3 col = YIQ2RGB * vec3(accY / sumY, accC / sumC);

        // Ghost echo.
        col += uSig.y * 0.5 * source(s - vec2(uSig2.z * px.x, 0.0));

        // Dropouts: white streaks along a few random lines.
        float x0 = hash(vec2(line, frame + 5.0));
        float len = 0.03 + 0.15 * hash(vec2(line + 3.0, frame));
        float dropLine = step(hash(vec2(line * 1.7, frame + 11.0)), uSig4.y * 0.03);
        col = mix(col, vec3(0.9), dropLine * step(x0, uv.x) * smoothstep(x0 + len, x0, uv.x));

        // Grain, colour noise, the tracking band's speckle, flicker and the blanking bar.
        vec2 np = vUV.st * uTD2DInfos[0].res.zw;
        float n = hash(np + vec2(frame * 7.13, frame * 3.71));
        col += (n - 0.5) * uTime.z * 0.12;
        col += (vec3(hash(np + frame * 1.31), hash(np + frame * 2.17 + 5.0), hash(np + frame * 3.07 + 9.0)) - 0.5) * uSig4.z * 0.15;
        float speck = step(0.75, hash(vec2(floor(uv.x * 400.0), line + frame)));
        col = mix(col, vec3(n), band * speck * 0.8);
        col *= (1.0 + uSig4.w * (hash(vec2(frame, 1.0)) - 0.5) * 0.4) * blank;
        fragColor = TDOutputSwizzle(vec4(max(col, 0.0), 1.0));
    }
  dat_content_format: text
annotations:
- name: annotate1
  mode: annotate
  title: CRT Filter
  text: 'Reusable: any TOP in, CRT look out; controls on the Tube, Scan, Mask, Signal, Glow, Color and Presets pages. glsl_signal = analog signal (jitter, wave, tracking band, head switching, roll, pixelation, smear with chroma delay, ghost, dropouts, grain, flicker). blur_halo = halation source. glsl_tube = curved glass, glare, convergence, beam scanlines (horizontal or vertical), interlace, hum bar, phosphor mask, halation, diffusion, grade, monochrome phosphors; feedback_persist feeds its last frame back for phosphor persistence. presets = one column per look (add your own); preset_callbacks applies the chosen column on Apply Preset. switch_enable passes the input through when Enable is off.'
  position: [-70, -670]
  size: [2270, 930]
  color: [0.45, 0.25, 0.2]
  opacity: 0.6
