format: tdxn
version: '2.2'
build: 2
generator: Embody/6.2.72
td_build: 099.2025.32820
network_path: /project1/ferroscope/CRT
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  glslTOP:
    parameters:
      format: rgba16float
      inputextenduv: hold
      premultrgbbyalpha: false
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  infoDAT:
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  textDAT:
    parameters:
      extension: frag
      language: glsl
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
type: baseCOMP
custom_pars:
  Tube:
  - name: Enable
    style: Toggle
    default: true
    help: Turns the CRT filter on. Off passes the input through untouched.
  - name: Curvature
    style: Float
    startSection: true
    default: 0.4
    max: 2.0
    clampMin: true
    clampMax: true
    help: 'How strongly the glass bulges: the picture bends toward the edges like a curved tube. 0 = flat screen.'
    value: 0.307
  - name: Corner
    style: Float
    label: Corner Radius
    default: 0.12
    max: 0.6
    clampMin: true
    clampMax: true
    help: Roundness of the screen corners, as a fraction of the screen height.
    value: 0.023
  - name: Edgesoft
    style: Float
    label: Edge Softness
    default: 0.1
    clampMin: true
    clampMax: true
    help: Softness of the screen edge where the picture meets the bezel.
    value: 0.05
  - name: Screensize
    style: Float
    label: Screen Size
    default: 1
    min: 0.5
    max: 1.5
    clampMin: true
    clampMax: true
    normMin: 0.8
    normMax: 1.2
    help: Size of the tube in the frame. Below 1 shows the bezel around it; above 1 overscans past the frame edges.
    value: 0.8
  - name: Vignette
    style: Float
    startSection: true
    default: 0.35
    clampMin: true
    clampMax: true
    help: Darkening toward the edges of the tube.
    value: 0.881
  - name: Glare
    style: Float
    label: Glass Glare
    default: 0.25
    clampMin: true
    clampMax: true
    help: Soft reflection of a room light on the curved glass, upper left.
    value: 0
  - name: Bezelcolor
    style: RGBA
    label: Bezel Color
    size: 3
    help: Colour around the tube, outside the picture.
  Scan:
  - name: Lines
    style: Int
    label: Scanlines
    default: 240
    min: 32.0
    max: 1080.0
    clampMin: true
    clampMax: true
    normMin: 120.0
    normMax: 720.0
    help: Number of scanlines across the picture. Fewer lines = a coarser, older-looking tube.
    value: 706
  - name: Scandir
    style: Menu
    label: Scan Direction
    default: horizontal
    menuNames:
    - horizontal
    - vertical
    menuLabels:
    - Horizontal
    - Vertical (rotated monitor)
    help: Horizontal lines like a TV, or vertical lines like a rotated arcade monitor.
  - name: Scandepth
    style: Float
    label: Scanline Depth
    startSection: true
    default: 0.55
    clampMin: true
    clampMax: true
    help: How dark the gaps between scanlines are. 0 = no scanlines.
    value: 0.831
  - name: Beam
    style: Float
    label: Beam Bloom
    default: 0.7
    clampMin: true
    clampMax: true
    help: How much bright colours widen their scanline, filling the gaps like a real electron beam.
    value: 0
  - name: Convergence
    style: Float
    label: Convergence Error
    default: 1.5
    min: -10.0
    max: 10.0
    clampMin: true
    clampMax: true
    normMin: -4.0
    normMax: 4.0
    help: 'Misalignment of the red and blue beams along the scanlines, in pixels: colour fringes on edges.'
    value: 2.82
  - name: Interlace
    style: Float
    label: Interlace Flicker
    startSection: true
    clampMin: true
    clampMax: true
    help: Alternate frames dim every other scanline, like an interlaced picture.
    value: 0.056
  - name: Humbar
    style: Float
    label: Hum Bar
    clampMin: true
    clampMax: true
    help: A soft bright band rolling slowly through the picture, like mains hum.
    value: 0.989
  - name: Humspeed
    style: Float
    label: Hum Speed
    default: 0.15
    min: -2.0
    max: 2.0
    clampMin: true
    clampMax: true
    normMin: -0.5
    normMax: 0.5
    help: How fast the hum bar rolls, in screens per second. Negative rolls the other way.
    value: -0.5
  Mask:
  - name: Masktype
    style: Menu
    label: Phosphor Mask
    default: shadow
    menuNames:
    - 'off'
    - shadow
    - grille
    - slot
    menuLabels:
    - 'Off'
    - Shadow Mask (dots)
    - Aperture Grille
    - Slot Mask
    help: 'Pattern of the phosphors: round RGB dots (shadow mask, as on most TVs), continuous stripes (aperture grille, Trinitron) or broken stripes (slot mask).'
    value: grille
  - name: Maskpitch
    style: Float
    label: Mask Pitch (px)
    default: 5
    min: 1.0
    max: 16.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 8.0
    help: Size of one phosphor dot or stripe in output pixels. Larger = a bigger, more visible mask.
    value: 1.79
  - name: Maskdepth
    style: Float
    label: Mask Depth
    default: 0.6
    clampMin: true
    clampMax: true
    help: How strongly the phosphor pattern shows. 0 = no mask.
    value: 0.237
  - name: Masksoft
    style: Float
    label: Dot Softness
    default: 0.3
    clampMin: true
    clampMax: true
    help: Softness of the phosphor dots and stripes. 0 = crisp, 1 = blurred.
    value: 0.503
  - name: Maskcurved
    style: Toggle
    label: Mask Follows Glass
    help: Bend the phosphor pattern with the curved glass instead of keeping it flat on the output.
  Signal:
  - name: Pixelate
    style: Int
    label: Source Columns
    max: 1920.0
    clampMin: true
    clampMax: true
    normMax: 640.0
    help: Pixelate the feed to this many columns, like a low-resolution source (320 for an 8-bit console). 0 = off.
  - name: Smear
    style: Float
    startSection: true
    default: 0.35
    clampMin: true
    clampMax: true
    help: Horizontal smear of the analog signal; colour bleeds further to the right than brightness.
    value: 0
  - name: Chromashift
    style: Float
    label: Chroma Delay (px)
    min: -20.0
    max: 20.0
    clampMin: true
    clampMax: true
    normMin: -8.0
    normMax: 8.0
    help: Colour lags behind brightness by this many pixels, like composite video.
    value: -8
  - name: Ghost
    style: Float
    default: 0.12
    clampMin: true
    clampMax: true
    help: Faint echo of the picture to the right.
    value: 0.61
  - name: Ghostoffset
    style: Float
    label: Ghost Offset (px)
    default: 9
    min: 1.0
    max: 80.0
    clampMin: true
    clampMax: true
    normMin: 2.0
    normMax: 40.0
    help: Distance of the ghost echo, in pixels.
    value: 2.6
  - name: Jitter
    style: Float
    label: Line Jitter (px)
    startSection: true
    default: 0.6
    max: 20.0
    clampMin: true
    clampMax: true
    normMax: 4.0
    help: Random horizontal wobble of each line, in pixels.
    value: 0
  - name: Wave
    style: Float
    label: Wave (px)
    max: 40.0
    clampMin: true
    clampMax: true
    normMax: 10.0
    help: A horizontal wave bending the picture, in pixels.
    value: 3.16
  - name: Wavefreq
    style: Float
    label: Wave Frequency
    default: 3
    min: 0.1
    max: 40.0
    clampMin: true
    clampMax: true
    normMin: 0.5
    normMax: 12.0
    help: Number of wave cycles over the picture height.
    value: 0.5
  - name: Headswitch
    style: Float
    label: Head Switching
    clampMin: true
    clampMax: true
    help: VHS-style torn, skewed strip along the bottom of the picture.
    value: 0.034
  - name: Tracking
    style: Float
    label: Tracking Noise
    startSection: true
    default: 0.3
    clampMin: true
    clampMax: true
    help: Strength of the torn, noisy band rolling down the picture.
    value: 0.13
  - name: Trackspeed
    style: Float
    label: Tracking Speed
    default: 0.045
    clampMin: true
    clampMax: true
    normMax: 0.3
    help: How fast the tracking band rolls down, in screens per second.
    value: 0.3
  - name: Trackheight
    style: Float
    label: Tracking Height
    default: 0.02
    min: 0.002
    max: 0.3
    clampMin: true
    clampMax: true
    normMin: 0.005
    normMax: 0.1
    help: Height of the tracking band as a fraction of the picture.
    value: 0.0415
  - name: Roll
    style: Float
    label: Vertical Roll
    min: -2.0
    max: 2.0
    clampMin: true
    clampMax: true
    normMin: -0.5
    normMax: 0.5
    help: The picture rolls through a dark blanking bar, in screens per second, like a TV that lost vertical hold. 0 = stable.
  - name: Dropouts
    style: Float
    clampMin: true
    clampMax: true
    help: Random white streaks, like worn tape.
    value: 0.548
  - name: Grain
    style: Float
    startSection: true
    default: 0.35
    max: 2.0
    clampMin: true
    clampMax: true
    help: Analog noise over the picture.
    value: 0.186
  - name: Chromanoise
    style: Float
    label: Colour Noise
    max: 2.0
    clampMin: true
    clampMax: true
    help: Coloured (chroma) noise on top of the grain.
    value: 0.119
  - name: Flicker
    style: Float
    clampMin: true
    clampMax: true
    help: Frame-to-frame brightness flicker.
  Glow:
  - name: Halation
    style: Float
    default: 0.6
    max: 3.0
    clampMin: true
    clampMax: true
    normMax: 1.5
    help: Glow that bright areas spread inside the glass.
    value: 0
  - name: Halotint
    style: RGBA
    label: Halation Tint
    size: 3
    default: [1, 0.35, 0.22]
    help: Colour of the halation glow. Warm red-orange matches old tubes.
    values: [1, 0.498039, 0.501961]
  - name: Halosize
    style: Float
    label: Halation Size (px)
    default: 24
    min: 2.0
    max: 120.0
    clampMin: true
    clampMax: true
    normMin: 4.0
    normMax: 60.0
    help: Radius of the halation glow, in output pixels.
    value: 4
  - name: Halothreshold
    style: Float
    label: Halation Threshold
    clampMin: true
    clampMax: true
    help: Only light above this level glows. Raise it to keep the glow on the highlights.
    value: 0.842
  - name: Diffusion
    style: Float
    label: Glass Diffusion
    startSection: true
    clampMin: true
    clampMax: true
    help: Soft untinted haze from light scattering in the glass.
    value: 0.61
  - name: Persistence
    style: Float
    label: Phosphor Persistence
    max: 0.97
    clampMin: true
    clampMax: true
    help: 'Afterglow: moving bright things leave fading trails. 0 = none.'
    value: 0.774
  Color:
  - name: Phosphor
    style: Menu
    default: color
    menuNames:
    - color
    - green
    - amber
    - white
    menuLabels:
    - Colour (RGB)
    - Green (P1)
    - Amber (P3)
    - White (P4)
    help: 'Colour: an RGB tube. Green, Amber, White: a monochrome monitor; the picture becomes one colour and the mask turns colourless.'
  - name: Brightness
    style: Float
    startSection: true
    default: 1.5
    max: 4.0
    clampMin: true
    clampMax: true
    normMin: 0.5
    normMax: 3.0
    help: Overall gain after scanlines and mask, which both darken the picture.
    value: 0.6
  - name: Contrast
    style: Float
    default: 1
    max: 3.0
    clampMin: true
    clampMax: true
    normMin: 0.5
    normMax: 2.0
    help: Contrast around mid grey. 1 = unchanged.
    value: 1.212
  - name: Gamma
    style: Float
    default: 1
    min: 0.2
    max: 3.0
    clampMin: true
    clampMax: true
    normMin: 0.5
    normMax: 2.0
    help: Midtone brightness. Above 1 lifts the midtones, below 1 darkens them.
    value: 1.992
  - name: Saturation
    style: Float
    default: 1.1
    max: 3.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Colour saturation of the tube. 1 = unchanged.
    value: 0.37
  - name: Colortint
    style: RGBA
    label: Colour Tint
    size: 3
    default: 1
    help: 'White point of the tube: multiplies the picture. Slightly blue reads as a TV, slightly warm as an old monitor.'
  - name: Blacklevel
    style: Float
    label: Black Level
    default: 0.02
    max: 0.3
    clampMin: true
    clampMax: true
    help: 'The glass never reaches pure black: this lifts the darkest tones.'
    value: 0.3
  Presets:
  - name: Preset
    style: Menu
    default: default
    menuNames:
    - default
    - arcade
    - pcmonitor
    - brokenvhs
    - greenterminal
    - amberterminal
    menuLabels:
    - Default (consumer TV)
    - Arcade Monitor
    - PC Monitor (Trinitron)
    - Broken VHS
    - Green Terminal
    - Amber Terminal
    help: A ready-made look. Choose one, then press Apply Preset. The values live in the presets table inside this COMP; add a column there to make your own.
    value: arcade
  - name: Applypreset
    style: Pulse
    label: Apply Preset
    help: Copy the chosen preset onto every setting of this filter. This overwrites your current values.
parameters:
  parentshortcut: CRT
color: [0.3, 0.5, 0.9]
tags:
- tdxn
comment: 'Reusable CRT filter: TOP in -> analog signal + tube emulation -> TOP out. Portable copy: components/CRT.tox'
operators:
- name: in1
  type: inTOP
  parameters:
    label: =me.name
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: out1
  type: outTOP
  parameters:
    label: =me.name
  position: [2000, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - switch_enable
