format: tdxn
version: '2.1'
build: 7
generator: Embody/6.2.68
td_build: 099.2025.32820
network_path: /project1/caleidoscopic_sonogram_video
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  audiofilterCHOP:
    parameters:
      autoexportroot: =parent()
      units: frequency
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  audiospectrumCHOP:
    parameters:
      autoexportroot: =parent()
      frequencylog: 0
      highfreqboost: 0
      outputmenu: setmanually
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  baseCOMP:
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
  blurTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  choptoTOP:
    parameters:
      format: rgba32float
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  constantCHOP:
    parameters:
      autoexportroot: =parent()
      rate: =me.time.rate
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  constantTOP:
    parameters:
      alpha: 0
      colorb: 0
      colorg: 0
      colorr: 0
      format: rgba16float
      outputresolution: custom
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  feedbackTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  glslTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  glslmultiTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  infoDAT:
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  nullCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  nullTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  outTOP:
    parameters:
      label: =me.name
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  renderselectTOP:
    parameters:
      bufferindex: 1
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  selectTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  textDAT:
    parameters:
      syncfile: true
    size: [130, 90]
    color: [0.9, 0.3, 0.4]
type: baseCOMP
custom_pars:
  Track:
  - name: Audiofile
    style: File
    label: Audio File
    help: 'The track (wav, aif, mp3). Empty = the TouchDesigner sample track. It is played out and analysed: bands, energy, transients, spectrum and waveform drive everything.'
  - name: Play
    style: Toggle
    default: true
    help: Play the track (and the modulator video). Off pauses both.
  - name: Restart
    style: Pulse
    help: Jump the track and the modulator video back to the start.
  - name: Loop
    style: Toggle
    default: true
    help: Start the track again when it ends.
  - name: Trackvolume
    style: Float
    label: Volume
    default: 0.8
    clampMin: true
    clampMax: true
    help: Playback volume to the default audio device (analysis is not affected).
    value: 1
  - name: Trackgain
    style: Float
    label: Analysis Gain (dB)
    startSection: true
    min: -24.0
    max: 24.0
    clampMin: true
    clampMax: true
    normMin: -12.0
    normMax: 12.0
    help: 'Gain before the band levels are measured: raise it for a quiet master, lower it for a loud one.'
    value: -6.84
  - name: Specgain
    style: Float
    label: Spectrum Gain (dB)
    min: -24.0
    max: 24.0
    clampMin: true
    clampMax: true
    normMin: -12.0
    normMax: 12.0
    help: Gain of the spectrum written into the sonogram history (brightness of the frequency content).
    value: 0.9
  - name: Adapt
    style: Float
    label: Floor Adapt (s)
    default: 6
    max: 60.0
    clampMin: true
    clampMax: true
    normMax: 20.0
    help: 'Time the adaptive floor needs to absorb a constant level, so a loud master still moves the image: only what rises above the floor counts. 0 = absolute levels.'
    value: 12.06
  - name: Release
    style: Float
    label: Band Release (s)
    default: 0.25
    min: 0.01
    max: 4.0
    clampMin: true
    clampMax: true
    help: Release time of the band envelopes (attack is fixed and fast).
    value: 0.988
  Modulator:
  - name: Videofile
    style: File
    label: Video File
    help: 'The modulator video (a spinning record, any footage). Empty = the TouchDesigner sample countdown. It is never shown directly: it keys a mask that displaces and lights the cloud.'
    value: C:/Users/Julian-SebastianHilg/Downloads/sample-4.mp4
  - name: Modon
    style: Toggle
    label: Video On
    default: true
    help: Use the modulator video. Off = no mask, no motion.
    value: false
  - name: Modspeed
    style: Float
    label: Video Speed
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Playback speed of the video.
    value: 2
  - name: Spinreact
    style: Float
    label: Low -> Video Speed
    default: 0.6
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: The low band speeds the video up (the record spins faster on the kick).
    value: 0.346
  - name: Modkey
    style: Menu
    label: Key
    startSection: true
    default: luma
    menuNames:
    - luma
    - dark
    - bgdiff
    menuLabels:
    - Bright parts
    - Dark parts
    - Difference to background
    help: 'What of the video becomes the mask: its bright parts, its dark parts, or the difference to a learned background.'
  - name: Modthreshold
    style: Float
    label: Key Threshold
    default: 0.35
    clampMin: true
    clampMax: true
    help: Brightness (or difference) at the middle of the soft key.
    value: 0.23
  - name: Modsoftness
    style: Float
    label: Key Softness
    default: 0.2
    min: 0.001
    max: 0.5
    clampMin: true
    clampMax: true
    help: 'Width of the soft edge of the key: wide = greyscale mask, narrow = hard silhouette.'
    value: 0.266
  - name: Modtrail
    style: Float
    label: Motion Trail (s)
    default: 0.4
    min: 0.05
    max: 5.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Seconds the motion trail of the video takes to fade.
    value: 1.415
  - name: Modmirror
    style: Toggle
    label: Mirror
    help: Mirror the video horizontally.
    value: true
  - name: Vidshow
    style: Float
    label: Video in Points
    startSection: true
    default: 0.5
    clampMin: true
    clampMax: true
    help: 'How much the mask lights the points: 0 = the sound alone sets brightness, 1 = the video is drawn by the points.'
    value: 0.081
  - name: Ghost
    style: Float
    label: Video Ghost
    clampMin: true
    clampMax: true
    help: Faint monochrome overlay of the video itself behind the cloud.
  Form:
  - name: Form
    style: Menu
    default: tunnel
    menuNames:
    - sheet
    - tunnel
    - disc
    menuLabels:
    - Sheet (sonogram wall)
    - Tunnel (fly through)
    - Disc (record)
    help: 'Shape the history is laid out in. Sheet: time across the screen. Tunnel: time is depth, the sound comes at the camera and the frequencies wrap around. Disc: time is the angle, frequency the radius, like grooves on a record.'
  - name: Morph
    style: Float
    default: 1
    clampMin: true
    clampMax: true
    help: Blend from the sheet (0) to the chosen form (1). Animate it for transitions.
  - name: Symmetry
    style: Int
    default: 1
    min: 1.0
    max: 12.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 8.0
    help: Mirrors the frequency axis N times around the tunnel or disc (kaleidoscope). 1 = none.
    value: 8
  - name: Tunnellength
    style: Float
    label: Tunnel Length
    default: 30
    min: 4.0
    max: 80.0
    clampMin: true
    clampMax: true
    normMin: 8.0
    normMax: 60.0
    help: Depth of the tunnel in world units (the camera sits 5.4 in front of the origin).
    value: 32.5
  - name: Twist
    style: Float
    startSection: true
    default: 0.6
    min: -4.0
    max: 4.0
    clampMin: true
    clampMax: true
    normMin: -2.0
    normMax: 2.0
    help: Turns of twist along the history (tunnel, disc); the mid band adds Mid -> Twist.
    value: -0.03
  - name: Twistreact
    style: Float
    label: Mid -> Twist
    default: 0.5
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Extra twist from the mid band.
    value: 0.012
  - name: Lowpump
    style: Float
    label: Low -> Pump
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: The low band inflates the form (tunnel radius, disc and sheet depth).
    value: 0
  - name: Warp
    style: Float
    default: 1
    max: 6.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: 4D noise that bends the whole form; the track energy scales it up.
    value: 0
  Camera:
  - name: Distance
    style: Float
    default: 5.4
    min: 0.2
    max: 20.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 12.0
    help: Camera distance from the origin; the camera orbits the origin. Small values put it inside the cloud.
    value: 5.37
  - name: Tilt
    style: Float
    label: Tilt (deg)
    default: -9
    min: -90.0
    max: 90.0
    clampMin: true
    clampMax: true
    normMin: -60.0
    normMax: 60.0
    help: Base pitch of the camera (negative = looking down onto the form).
    value: -1.6
  - name: Fov
    style: Float
    label: Field of View (deg)
    default: 50
    min: 10.0
    max: 120.0
    clampMin: true
    clampMax: true
    normMin: 20.0
    normMax: 100.0
    help: 'Lens: small = long lens, flat and graphic; large = wide, deep perspective.'
    value: 90.9
  - name: Push
    style: Float
    label: Energy -> Push
    startSection: true
    default: 0.5
    max: 2.0
    clampMin: true
    clampMax: true
    help: The camera dollies in when the track is loud (drops) and backs off in breakdowns.
    value: 0.003
  - name: Flyreact
    style: Float
    label: Energy -> Fly
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Track energy speeds up the flow of the history (the flight through the tunnel).
    value: 0
  - name: Shake
    style: Float
    label: Transient -> Shake
    default: 0.5
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Camera jolt on transients (kicks, snares).
    value: 0
  - name: Fovpunch
    style: Float
    label: Transient -> Zoom
    default: 0.3
    max: 2.0
    clampMin: true
    clampMax: true
    help: Short wide-angle punch of the lens on transients.
    value: 0
  - name: Roll
    style: Float
    default: 0.3
    max: 3.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Slow roll swing of the camera; the track energy speeds it up.
    value: 0.854
  Visual:
  - name: Palette
    style: Menu
    label: Color Scale
    default: steel
    menuNames:
    - inferno
    - magma
    - viridis
    - turbo
    - ice
    - mono
    - steel
    - signal
    menuLabels:
    - Inferno
    - Magma
    - Viridis
    - Turbo
    - Ice
    - Mono (warm white)
    - Steel (neutral white)
    - Signal (white, red peaks)
    help: Color scale the sonogram level is mapped through (quiet -> loud). Steel and Mono are monochrome; Signal keeps one red accent on the loudest peaks.
    value: turbo
  - name: Paletteshift
    style: Float
    label: Scale Offset
    min: -1.0
    clampMin: true
    clampMax: true
    normMin: -0.5
    normMax: 0.5
    help: 'Slides the level along the color scale: positive values show quieter content brighter, negative values darken everything but the peaks.'
    value: -0.013
  - name: Contrast
    style: Float
    label: Level Contrast
    default: 2
    min: 0.2
    max: 4.0
    clampMin: true
    clampMax: true
    normMin: 0.4
    normMax: 3.0
    help: Gamma on the sonogram level before the color scale (1 = linear dB; higher hides the quiet bins and isolates the strong partials).
    value: 3
  - name: Direction
    style: Menu
    label: Flow Direction
    startSection: true
    default: left
    menuNames:
    - left
    - right
    - up
    - down
    menuLabels:
    - Left
    - Right
    - Up
    - Down
    help: 'Where the history flows: new sound enters at the opposite edge and travels this way. Left/Right put frequency on the vertical axis, Up/Down on the horizontal axis.'
    value: down
  - name: Speed
    style: Float
    label: Flow Speed
    default: 1
    max: 6.0
    clampMin: true
    clampMax: true
    normMax: 4.0
    help: 'Base travel speed of the history: screen crossings (sheet), flight (tunnel) or turns (disc) per 10 s. Energy -> Fly adds to it. 0 = static, the field breathes in place.'
    value: 1.64
  - name: Depth
    style: Float
    label: Waveform Depth
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: How far the waveform history displaces the form (depth on the sheet and disc, radius in the tunnel).
    value: 0
  - name: Thickness
    style: Float
    label: Cloud Thickness
    default: 0.6
    max: 3.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Depth spacing between the three layers of the cloud (0 = one flat sheet).
    value: 0.287
  - name: Scatter
    style: Float
    default: 0.45
    max: 2.0
    clampMin: true
    clampMax: true
    normMax: 1.5
    help: Fixed random offset of each point, which turns the grid into a cloud.
    value: 0
  - name: Pointsize
    style: Float
    label: Point Size
    default: 1
    min: 0.1
    max: 6.0
    clampMin: true
    clampMax: true
    normMin: 0.2
    normMax: 3.0
    help: Size multiplier of the rendered points.
    value: 3
  - name: Sway
    style: Float
    label: Orbit
    startSection: true
    default: 1
    max: 3.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Amount of the slow, eased camera orbit around the origin (0 = locked camera).
    value: 2
  - name: Swayspeed
    style: Float
    label: Orbit Speed
    default: 1
    max: 5.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: Speed of the camera orbit, the roll and the idle breathing noise.
    value: 3
  - name: Glow
    style: Float
    default: 1
    max: 3.0
    clampMin: true
    clampMax: true
    help: Base strength of the bloom (the low band adds Low -> Bloom).
    value: 0.125
  - name: Dof
    style: Float
    label: Depth of Field
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: Blur of points in front of and behind the focus plane (soft bokeh discs). The mid band adds to it.
    value: 0.376
  Reactivity:
  - name: Reach
    style: Float
    label: Video Displace
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: 'How far the points inside the video mask come toward the camera: the video is embossed into the form.'
    value: 2.194
  - name: Imprint
    style: Float
    label: Video Imprint
    default: 0.5
    clampMin: true
    clampMax: true
    help: How strongly the video mask lifts its points up the color scale and enlarges them.
    value: 0.77
  - name: Ripple
    style: Float
    label: Video Motion Ripple
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: Turbulence the motion in the video stirs into the cloud.
    value: 0.77
  - name: Chaos
    style: Float
    startSection: true
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: 'Master amount of the band reactions below: higher = the track tears the image apart more.'
    value: 0
  - name: Lowbloom
    style: Float
    label: Low -> Bloom
    default: 1
    max: 3.0
    clampMin: true
    clampMax: true
    help: 'Low band (< 250 Hz): bloom and a depth pump.'
    value: 0.367
  - name: Midblur
    style: Float
    label: Mid -> Blur
    default: 1
    max: 3.0
    clampMin: true
    clampMax: true
    help: 'Mid band (250 Hz - 4 kHz): defocus blur and a looser cloud.'
    value: 0.263
  - name: Highjitter
    style: Float
    label: High -> Jitter
    default: 1
    max: 3.0
    clampMin: true
    clampMax: true
    help: 'High band (> 4 kHz): per-frame point jitter, grain and glitch.'
    value: 0.024
  - name: Kick
    style: Float
    label: Transient -> Kick
    default: 1
    max: 3.0
    clampMin: true
    clampMax: true
    help: 'Transients (kicks, snares): a radial shock through the cloud, a colour split, strobe and invert.'
    value: 0
  - name: Micsono
    style: Float
    label: Transient Layer
    default: 0.6
    clampMin: true
    clampMax: true
    help: 'How much of the fast (instant) spectrum is written over the smoothed one: crisp hits in the history.'
    value: 0.003
  Finish:
  - name: Exposure
    style: Float
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 2.5
    help: Gain before the filmic tone map.
    value: 2.5
  - name: Crush
    style: Float
    label: Black Crush
    default: 0.06
    max: 0.5
    clampMin: true
    clampMax: true
    normMax: 0.3
    help: 'Black point after the tone map: everything below it goes to pure black (harder contrast).'
    value: 0.2373
  - name: Gamma
    style: Float
    label: Contrast Curve
    default: 1.25
    min: 0.3
    max: 3.0
    clampMin: true
    clampMax: true
    normMin: 0.5
    normMax: 2.5
    help: Power curve after the black crush (> 1 deepens the mids, light on dark).
    value: 0.5
  - name: Saturation
    style: Float
    clampMin: true
    clampMax: true
    help: 0 = strict monochrome (the Signal accent survives), 1 = the full color scale.
    value: 1
  - name: Trails
    style: Float
    startSection: true
    default: 0.55
    max: 0.97
    clampMin: true
    clampMax: true
    help: 'Light trails: how much of the previous frame survives (0 = none, 0.97 = long smear).'
    value: 0
  - name: Strobe
    style: Float
    default: 0.25
    clampMin: true
    clampMax: true
    help: White flash on strong transients.
    value: 0
  - name: Invert
    style: Float
    clampMin: true
    clampMax: true
    help: Negative flash on the strongest transients (dark on light for a frame).
  - name: Glitch
    style: Float
    default: 0.3
    clampMin: true
    clampMax: true
    help: Horizontal slice displacement driven by the high band and transients.
    value: 0
  - name: Grain
    style: Float
    default: 0.5
    max: 2.0
    clampMin: true
    clampMax: true
    help: Film grain amount (the high band adds to it).
    value: 0
  Monitor:
  - name: Monpresence
    style: Float
    label: Video Mask
    readOnly: true
    help: 'Read-only: 0-1, the video mask is present.'
    value: =float(me.op('sense/null_features')['presence'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Monprox
    style: Float
    label: Video Coverage
    readOnly: true
    help: 'Read-only: 0-1, how much of the frame the mask covers.'
    value: =float(me.op('sense/null_features')['prox'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Monposx
    style: Float
    label: Video Mask X
    readOnly: true
    help: 'Read-only: 0-1, horizontal center of the mask.'
    value: =float(me.op('sense/null_features')['cx'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Monmotion
    style: Float
    label: Video Motion
    readOnly: true
    help: 'Read-only: 0-1, amount of movement in the video.'
    value: =float(me.op('sense/null_features')['motion'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Monlow
    style: Float
    label: Low
    startSection: true
    readOnly: true
    help: 'Read-only: 0-1, low band above the adaptive floor.'
    value: =float(me.op('sense/null_features')['low'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Monmid
    style: Float
    label: Mid
    readOnly: true
    help: 'Read-only: 0-1, mid band above the adaptive floor.'
    value: =float(me.op('sense/null_features')['mid'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Monhigh
    style: Float
    label: High
    readOnly: true
    help: 'Read-only: 0-1, high band above the adaptive floor.'
    value: =float(me.op('sense/null_features')['high'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Montransient
    style: Float
    label: Transient
    readOnly: true
    help: 'Read-only: 0-1, onsets (fast envelope over slow envelope).'
    value: =float(me.op('sense/null_features')['transient'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Monenergy
    style: Float
    label: Energy
    readOnly: true
    help: 'Read-only: 0-1, slow loudness of the track (breakdown low, drop high).'
    value: =float(me.op('sense/null_features')['energy'] or 0) if me.op('sense/null_features') is not None else 0.0
  - name: Montime
    style: Float
    label: Track Time (s)
    readOnly: true
    help: 'Read-only: playback position of the track in seconds.'
    value: =float(me.op('sense/audiofilein_track').par.index.eval()) if me.op('sense/audiofilein_track') is not None else 0.0
  Inputs:
  - name: Camera
    style: Toggle
    default: true
    help: 'Use the camera (sense/videoin_cam: pick the device there). Off = no silhouette, no motion.'
    value: false
  - name: Mirror
    style: Toggle
    default: true
    help: Mirror the camera horizontally so the cloud follows visitors like a mirror.
  - name: Keymode
    style: Menu
    label: Silhouette Key
    default: bgdiff
    menuNames:
    - bgdiff
    - dark
    menuLabels:
    - Background Difference
    - Dark on Light (white room)
    help: 'How a visitor is separated from the room: difference to a captured empty-room background, or simply anything darker than a white wall.'
    value: dark
  - name: Keythreshold
    style: Float
    label: Key Threshold
    default: 0.12
    clampMin: true
    clampMax: true
    normMax: 0.5
    help: Difference (or darkness) above which a pixel counts as visitor.
    value: 0.387
  - name: Keysoftness
    style: Float
    label: Key Softness
    default: 0.08
    min: 0.001
    max: 0.5
    clampMin: true
    clampMax: true
    normMax: 0.3
    help: Width of the soft edge around the threshold.
    value: 0.086
  - name: Bglearn
    style: Float
    label: Background Learn (s)
    default: 40
    max: 600.0
    clampMin: true
    clampMax: true
    normMax: 120.0
    help: Time constant in seconds with which the background slowly absorbs the room (lighting drift, moved furniture). 0 = never learn, only Capture.
    value: 10.5
  - name: Capturebg
    style: Pulse
    label: Capture Background
    help: Take the current camera image as the empty-room background. Press it with nobody in front of the camera.
  - name: Motiondecay
    style: Float
    label: Motion Trail (s)
    default: 0.8
    min: 0.05
    max: 5.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: Seconds the motion trail takes to fade.
    value: 2.579
  - name: Mic
    style: Toggle
    label: Microphone
    startSection: true
    default: true
    help: 'Use the room microphone (sense/audiodevin_mic: pick the device there).'
    value: false
  - name: Micgain
    style: Float
    label: Mic Gain (dB)
    default: 12
    min: -24.0
    max: 48.0
    clampMin: true
    clampMax: true
    normMin: -12.0
    normMax: 36.0
    help: Input gain before the band levels are measured.
    value: 30.6
  - name: Floortime
    style: Float
    label: Floor Adapt (s)
    default: 8
    max: 120.0
    clampMin: true
    clampMax: true
    normMax: 30.0
    help: Time the adaptive floor needs to absorb a constant sound (the drone from the speakers, air conditioning). Only sound above the floor makes noise. 0 = no floor.
    value: 8.3
  - name: Micsmooth
    style: Float
    label: Mic Release (s)
    default: 0.35
    min: 0.01
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Release time of the band envelopes (attack is fixed and fast).
    value: 0.25
parameters:
  parentshortcut: Caleido
sequences:
  ext:
  - object: op('./CaleidoscopicSonogramVideoExt').module.CaleidoscopicSonogramVideoExt(me)
    name: Caleido
    promote: true
color: [0.3, 0.5, 0.9]
tags:
- tdxn
operators:
- name: viz
  type: baseCOMP
  position: [995, 195]
  children:
  - name: out1
    type: outTOP
    position: [7300, -400]
    inputs:
    - null_out
  - name: cam_view
    type: cameraCOMP
    parameters:
      xord: trs
      tz: =parent.Caleido.par.Distance * (1.0 - 0.3 * parent.Caleido.par.Push * op('select_features')['energy'])
      rx: =parent.Caleido.par.Tilt + parent.Caleido.par.Sway * (0.2 if parent.Caleido.par.Form.eval() == 'tunnel' else 1.0) * (4.0 * math.sin(6.2831853 * op('speed_flow')['swayy']) + 1.2 * math.sin(6.2831853 * 2.0 * op('speed_flow')['swayy'] + 0.7)) + parent.Caleido.par.Shake * 3.0 * op('select_features')['transient'] * math.sin(absTime.frame * 2.399)
      ry: =parent.Caleido.par.Sway * (0.2 if parent.Caleido.par.Form.eval() == 'tunnel' else 1.0) * (8.0 * math.sin(6.2831853 * op('speed_flow')['swayx']) + 2.0 * math.sin(6.2831853 * 3.0 * op('speed_flow')['swayx'] + 1.3)) + parent.Caleido.par.Shake * 3.0 * op('select_features')['transient'] * math.sin(absTime.frame * 1.618 + 1.0)
      rz: =parent.Caleido.par.Roll * (30.0 if parent.Caleido.par.Form.eval() == 'tunnel' else 12.0) * math.sin(6.2831853 * op('speed_flow')['roll'])
      fov: =parent.Caleido.par.Fov * (1.0 + 0.35 * parent.Caleido.par.Fovpunch * op('select_features')['transient'])
      near: 0.05
      far: 60
    position: [4900, 0]
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
    children:
    - name: file1
      type: fileinPOP
      parameters:
        file: =app.samplesFolder + '/Geo/defcam.tog'
      flags:
      - display
      - viewer
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
  - name: null_out
    type: nullTOP
    position: [6900, -400]
    inputs:
    - glsl_post
  - name: geo_cloud
    type: geometryCOMP
    parameters:
      instancing: true
      instancecountmode: manual
      numinstances: =me.parent().op('null_field').width * me.parent().op('null_field').height
      material: mat_cloud
    position: [4900, -400]
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
    children:
    - name: rect
      type: rectangleSOP
      flags:
      - display
      - render
      position: [200, 0]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
  - name: glsl_post
    type: glslmultiTOP
    parameters:
      pixeldat: glsl_post_pixel
      numcolorbufs: 2
      format: rgba16float
    sequences:
      vec:
      - name: uPost
        valuex: =min(1.0, op('const_react')['mid'] * 0.8)
        valuey: =op('const_react')['kick']
        valuez: =(0.015 + 0.08 * op('const_react')['high']) * parent.Caleido.par.Grain
        valuew: =parent.Caleido.par.Exposure
      - name: uTime
        valuex: =absTime.frame % 10000
      - name: uGrade
        valuex: =parent.Caleido.par.Saturation
        valuey: =parent.Caleido.par.Crush
        valuez: =parent.Caleido.par.Gamma
        valuew: =parent.Caleido.par.Trails
      - name: uHit
        valuex: =parent.Caleido.par.Strobe * min(1.0, max(0.0, (op('const_react')['kick'] - 0.35) / 0.45))
        valuey: =parent.Caleido.par.Invert * min(1.0, max(0.0, (op('const_react')['kick'] - 0.6) / 0.3))
        valuez: =parent.Caleido.par.Glitch * min(1.0, op('const_react')['high'] + 0.7 * op('const_react')['kick'])
        valuew: =parent.Caleido.par.Ghost
    position: [6500, -400]
    inputs:
    - bloom_cloud
    - blur_defocus
    - feedback_post
    - select_video
  - name: mat_cloud
    type: glslMAT
    parameters:
      vdat: mat_cloud_vertex
      pdat: mat_cloud_pixel
      skelrootpath: =parent()
      blending: true
      destblend: one
      depthtest: false
      depthwriting: false
      cullface: neither
    sequences:
      mattr:
      - comps: 2
        cols: 2
      sampler:
      - name: sPos
        top: null_field
        filter: nearest
      - name: sCol
        top: null_color
        filter: nearest
      vec:
      - name: uFade
        valuex: =8.0 if parent.Caleido.par.Form.eval() == 'tunnel' else 5.0
        valuey: =parent.Caleido.par.Tunnellength + 6.0 if parent.Caleido.par.Form.eval() == 'tunnel' else 8.5
        valuez: 0.15
        valuew: 1.5
      - name: uDof
        valuex: =op('cam_view').par.tz + (6.0 if parent.Caleido.par.Form.eval() == 'tunnel' else 0.0)
        valuey: =(0.012 * parent.Caleido.par.Dof * (1.0 + 2.0 * op('const_react')['mid'])) * (0.35 if parent.Caleido.par.Form.eval() == 'tunnel' else 1.0)
        valuez: 0.12
        valuew: 0
    position: [4900, -800]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: const_flow
    type: constantCHOP
    sequences:
      const:
      - name: head
        value: =parent.Caleido.par.Speed * 0.1 * (1.0 + parent.Caleido.par.Flyreact * op('select_features')['energy'])
      - name: swayx
        value: =0.019 * parent.Caleido.par.Swayspeed
      - name: swayy
        value: =0.013 * parent.Caleido.par.Swayspeed
      - name: breath
        value: =0.023 * parent.Caleido.par.Swayspeed
      - name: roll
        value: =0.011 * parent.Caleido.par.Swayspeed * (1.0 + 2.0 * op('select_features')['energy'])
    position: [0, -1200]
  - name: glsl_field
    type: glslmultiTOP
    parameters:
      pixeldat: glsl_field_pixel
      numcolorbufs: 2
      outputresolution: custom
      resolutionw: 160
      resolutionh: 480
      format: rgba32float
    sequences:
      vec:
      - name: uFlow
        valuex: =op('speed_flow')['head'] * op('glsl_history').par.resolutionw
        valuey: =parent.Caleido.par.Direction.menuIndex
        valuez: =float(parent.Caleido.par.Modmirror)
        valuew: =op('speed_flow')['breath']
      - name: uShape
        valuex: =parent.Caleido.par.Depth
        valuey: =parent.Caleido.par.Thickness
        valuez: =parent.Caleido.par.Scatter
        valuew: =parent.Caleido.par.Pointsize
      - name: uReact
        valuex: =parent.Caleido.par.Reach
        valuey: =parent.Caleido.par.Imprint
        valuez: =parent.Caleido.par.Ripple
        valuew: =parent.Caleido.par.Vidshow
      - name: uNoise
        valuex: =op('const_react')['low']
        valuey: =op('const_react')['mid']
        valuez: =op('const_react')['high']
        valuew: =op('const_react')['kick']
      - name: uPal
        valuex: =parent.Caleido.par.Palette.menuIndex
        valuey: =parent.Caleido.par.Paletteshift
        valuez: =parent.Caleido.par.Contrast
        valuew: =parent.Caleido.par.Micsono
      - name: uMisc
        valuex: =absTime.frame % 10000
        valuey: =math.tan(math.radians(op("cam_view").par.fov.eval() * 0.5))
        valuez: 1.6
        valuew: 1
      - name: uForm
        valuex: =parent.Caleido.par.Form.menuIndex
        valuey: =parent.Caleido.par.Morph
        valuez: =parent.Caleido.par.Twist + parent.Caleido.par.Twistreact * op('select_features')['mid']
        valuew: =parent.Caleido.par.Lowpump * op('select_features')['low']
      - name: uForm2
        valuex: =parent.Caleido.par.Symmetry
        valuey: =parent.Caleido.par.Tunnellength
        valuez: =parent.Caleido.par.Warp * (0.4 + 1.2 * op('select_features')['energy'])
        valuew: =op('cam_view').par.tz.eval()
    position: [3200, -400]
    inputs:
    - null_history
    - select_presence
  - name: null_color
    type: nullTOP
    position: [4000, -800]
    inputs:
    - renderselect_color
  - name: null_field
    type: nullTOP
    position: [3600, -400]
    inputs:
    - glsl_field
  - name: null_trail
    type: nullTOP
    position: [7300, -800]
    inputs:
    - renderselect_trail
  - name: speed_flow
    type: speedCHOP
    parameters:
      limittype: loop
      autoexportroot: =parent()
    position: [400, -1200]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - const_flow
  - name: bloom_cloud
    type: bloomTOP
    parameters:
      bloomthreshold: 0.6
      bloomintensity: =0.35 * parent.Caleido.par.Glow + 0.6 * op('const_react')['low']
      format: rgba16float
    position: [5700, -400]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - render_cloud
  - name: const_react
    type: constantCHOP
    sequences:
      const:
      - name: low
        value: =op('select_features')['low'] * parent.Caleido.par.Lowbloom * parent.Caleido.par.Chaos
      - name: mid
        value: =op('select_features')['mid'] * parent.Caleido.par.Midblur * parent.Caleido.par.Chaos
      - name: high
        value: =op('select_features')['high'] * parent.Caleido.par.Highjitter * parent.Caleido.par.Chaos
      - name: kick
        value: =op('select_features')['transient'] * parent.Caleido.par.Kick * parent.Caleido.par.Chaos
    position: [400, -1600]
  - name: blur_defocus
    type: blurTOP
    parameters:
      size: =int(4 + 30 * min(1.0, op('const_react')['mid']))
    position: [6100, -800]
    inputs:
    - bloom_cloud
  - name: chopto_scope
    type: choptoTOP
    parameters:
      chop: ../sense/null_trackmono
    position: [1200, -800]
  - name: glsl_history
    type: glslmultiTOP
    parameters:
      pixeldat: glsl_history_pixel
      outputresolution: custom
      format: rgba16float
    sequences:
      vec:
      - name: uHead
        valuex: =op('speed_flow')['head'] * me.par.resolutionw
        valuey: =op('const_flow')['head'] * me.par.resolutionw / me.time.rate
        valuez: =1.0 if op('const_flow')['head'] < 0.0001 else 0.0
      - name: uSono
        valuex: 30
        valuey: 16000
        valuez: 22050
        valuew: 0.031
    position: [2400, -400]
    inputs:
    - null_specsmooth
    - null_micsmooth
    - chopto_scope
    - feedback_history
  - name: null_history
    type: nullTOP
    position: [2800, -400]
    inputs:
    - glsl_history
  - name: render_cloud
    type: renderTOP
    parameters:
      camera: cam_view
      geometry: geo_cloud
      lights: ''
      bgcolora: 1
      resolutionw: 1080
      resolutionh: 1080
      format: rgba16float
    position: [5300, -400]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: select_video
    type: selectTOP
    parameters:
      top: ../sense/null_cam
    position: [6100, -1600]
  - name: const_history
    type: constantTOP
    position: [1200, -1200]
  - name: feedback_post
    type: feedbackTOP
    parameters:
      top: null_trail
    position: [6100, -1200]
    inputs:
    - bloom_cloud
  - name: feedback_spec
    type: feedbackTOP
    parameters:
      top: null_specsmooth
    position: [400, 0]
    inputs:
    - chopto_spectrum
  - name: chopto_micspec
    type: choptoTOP
    parameters:
      chop: ../sense/null_trackspectrum
    position: [0, -400]
  - name: glsl_micsmooth
    type: glslTOP
    parameters:
      pixeldat: glsl_specsmooth_pixel
      format: rgba32float
    sequences:
      vec:
      - name: uSmooth
        valuex: 1
        valuey: 0.5
        valuez: 0.004
        valuew: =14.0 + parent.Caleido.par.Specgain
    position: [800, -400]
    inputs:
    - chopto_micspec
    - feedback_micspec
  - name: glsl_post_info
    type: infoDAT
    parameters:
      op: glsl_post
    position: [6425, -520]
    dock: glsl_post
    dat_read_only: true
  - name: mat_cloud_info
    type: infoDAT
    parameters:
      op: mat_cloud
    position: [4750, -920]
    dock: mat_cloud
    dat_read_only: true
  - name: null_micsmooth
    type: nullTOP
    position: [1200, -400]
    inputs:
    - glsl_micsmooth
  - name: chopto_spectrum
    type: choptoTOP
    parameters:
      chop: ../sense/null_trackspectrum
  - name: glsl_field_info
    type: infoDAT
    parameters:
      op: glsl_field
    position: [3125, -520]
    dock: glsl_field
    dat_read_only: true
  - name: glsl_post_pixel
    type: textDAT
    parameters:
      file: project1/caleidoscopic_sonogram_video/viz/glsl_post_pixel.glsl
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [6575, -520]
    tags:
    - glsl
    dock: glsl_post
  - name: glsl_specsmooth
    type: glslTOP
    parameters:
      pixeldat: glsl_specsmooth_pixel
      format: rgba32float
    sequences:
      vec:
      - name: uSmooth
        valuex: 0.6
        valuey: 0.12
        valuez: 0.004
        valuew: =14.0 + parent.Caleido.par.Specgain
    position: [800, 0]
    inputs:
    - chopto_spectrum
    - feedback_spec
  - name: mat_cloud_pixel
    type: textDAT
    parameters:
      file: project1/caleidoscopic_sonogram_video/viz/mat_cloud_pixel.glsl
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [4900, -920]
    tags:
    - glsl
    dock: mat_cloud
  - name: null_specsmooth
    type: nullTOP
    position: [1200, 0]
    inputs:
    - glsl_specsmooth
  - name: select_features
    type: selectCHOP
    parameters:
      chops: ../sense/null_features
      autoexportroot: =parent()
    position: [0, -1600]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: select_presence
    type: selectTOP
    parameters:
      top: ../sense/null_presence_soft
    position: [2800, -800]
  - name: feedback_history
    type: feedbackTOP
    parameters:
      top: null_history
    position: [2000, -1200]
    inputs:
    - const_history
  - name: feedback_micspec
    type: feedbackTOP
    parameters:
      top: null_micsmooth
    position: [400, -400]
    inputs:
    - chopto_micspec
  - name: glsl_field_pixel
    type: textDAT
    parameters:
      file: project1/caleidoscopic_sonogram_video/viz/glsl_field_pixel.glsl
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [3275, -520]
    tags:
    - glsl
    dock: glsl_field
  - name: mat_cloud_vertex
    type: textDAT
    parameters:
      file: project1/caleidoscopic_sonogram_video/viz/mat_cloud_vertex.glsl
      language: glsl
      extension: vert
    flags:
    - viewer
    position: [5050, -920]
    tags:
    - glsl
    dock: mat_cloud
  - name: glsl_history_info
    type: infoDAT
    parameters:
      op: glsl_history
    position: [2325, -520]
    dock: glsl_history
    dat_read_only: true
  - name: glsl_history_pixel
    type: textDAT
    parameters:
      file: project1/caleidoscopic_sonogram_video/viz/glsl_history_pixel.glsl
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [2475, -520]
    tags:
    - glsl
    dock: glsl_history
  - name: renderselect_color
    type: renderselectTOP
    parameters:
      top: glsl_field
      format: rgba32float
    position: [3600, -800]
  - name: renderselect_trail
    type: renderselectTOP
    parameters:
      top: glsl_post
      format: rgba16float
    position: [6900, -800]
  - name: glsl_micsmooth_info
    type: infoDAT
    parameters:
      op: glsl_micsmooth
    position: [800, -520]
    dock: glsl_micsmooth
    dat_read_only: true
  - name: glsl_specsmooth_info
    type: infoDAT
    parameters:
      op: glsl_specsmooth
    position: [725, -120]
    dock: glsl_specsmooth
    dat_read_only: true
  - name: glsl_specsmooth_pixel
    type: textDAT
    parameters:
      file: project1/caleidoscopic_sonogram_video/viz/glsl_specsmooth_pixel.glsl
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [875, -120]
    tags:
    - glsl
    dock: glsl_specsmooth
  annotations:
  - name: annotate1
    mode: annotate
    title: 'Inputs: spectra, waveform, flow + camera phases, reactivity'
    text: Track spectrum -> glsl_specsmooth (smoothed, R of the history) and glsl_micsmooth (instant, the transient layer, G); both share one shader DAT, gain = Spectrum Gain. chopto_scope = this frame's waveform. const_flow/speed_flow integrate Flow Speed x (1 + Energy -> Fly) into head, plus the orbit, roll and breath phases. const_react = bands x their amounts x Chaos.
    position: [-70, -1670]
    size: [1470, 1930]
    color: [0.2, 0.2, 0.28]
  - name: annotate2
    mode: annotate
    title: History ring buffer -> point field (sheet / tunnel / disc)
    text: 'glsl_history writes the sonogram (R smoothed, G instant, log 30 Hz-16 kHz) and waveform (B) into column `head` of a 256x256 ring. glsl_field turns it into 160x160x3 points: each owns (age, content), laid out as Form (sheet, tunnel = age is depth flowing at the camera, disc = age is the angle like a record), Morph, Symmetry, Twist, Low -> Pump, Warp; the video is projected from the camera onto the form (Displace, Imprint, Video in Points). Buffer 0 position+radius (null_field), buffer 1 colour (null_color).'
    position: [1930, -1270]
    size: [2340, 1130]
    color: [0.27, 0.1, 0.24]
  - name: annotate3
    mode: annotate
    title: Render 1080x1080 + finish
    text: 'geo_cloud = 76.8k instances of one quad; mat_cloud billboards them (additive, depth-of-field bokeh, distance fade; fade and focus follow the Form). cam_view: Distance, Tilt, Orbit (damped in the tunnel), Roll, Energy -> Push, Transient -> Shake / Zoom. bloom -> blur_defocus -> glsl_post: glitch slices, defocus, colour split, tone map, monochrome, black crush + curve, trails (buffer 1 -> renderselect_trail -> null_trail -> feedback_post), strobe, invert, vignette, grain -> out1. select_video feeds the optional ghost.'
    position: [4680, -1670]
    size: [2820, 1970]
    color: [0.08, 0.24, 0.28]
- name: out1
  type: outTOP
  flags:
  - display
  position: [1395, 195]
  inputs:
  - viz
- name: sense
  type: baseCOMP
  position: [195, -205]
  children:
  - name: fit_mod
    type: fitTOP
    parameters:
      fit: fitoutside
      resolutionw: 128
      resolutionh: 128
    position: [-400, -1200]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - moviefilein_mod
  - name: glsl_bg
    type: glslTOP
    parameters:
      pixeldat: glsl_bg_pixel
      outputresolution: custom
      resolutionw: 128
      resolutionh: 128
      format: rgba16float
    sequences:
      vec:
      - name: uLearn
        valuex: =(1.0 - math.exp(-1.0 / (parent.Caleido.par.Bglearn * me.time.rate))) if parent.Caleido.par.Bglearn > 0 else 0.0
    position: [1600, -1200]
    inputs:
    - null_cam
    - feedback_bg
    - feedback_presence
  - name: null_bg
    type: nullTOP
    position: [2000, -1200]
    inputs:
    - glsl_bg
  - name: res_cam
    type: resolutionTOP
    parameters:
      highqualresize: true
      outputresolution: custom
      resolutionw: 160
      resolutionh: 90
    position: [400, -1400]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - videoin_cam
  - name: lag_spin
    type: lagCHOP
    parameters:
      lag1: 0.03
      lag2: 0.4
      autoexportroot: =parent()
    position: [1200, 400]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - analyze_low
  - name: null_cam
    type: nullTOP
    position: [800, -1400]
    inputs:
    - fit_mod
  - name: math_mono
    type: mathCHOP
    parameters:
      chanop: avg
      autoexportroot: =parent()
      renameto: mono
    position: [-800, 1200]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - audiofilein_track
  - name: filter_low
    type: audiofilterCHOP
    parameters:
      cutofffrequency: 250
      rolloff: 24
    position: [400, 200]
    inputs:
    - null_trackmono
  - name: filter_mid
    type: audiofilterCHOP
    parameters:
      filter: bandpass
      cutofffrequency: 1000
    position: [400, 0]
    inputs:
    - null_trackmono
  - name: glsl_stats
    type: glslTOP
    parameters:
      pixeldat: glsl_stats_pixel
      outputresolution: custom
      resolutionw: 1
      resolutionh: 1
      format: rgba32float
    position: [3200, -2000]
    inputs:
    - null_presence
  - name: analyze_low
    type: analyzeCHOP
    parameters:
      function: rmspower
      autoexportroot: =parent()
    position: [800, 400]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - filter_low
  - name: const_black
    type: constantTOP
    parameters:
      resolutionw: 128
      resolutionh: 128
    position: [800, -2000]
  - name: feedback_bg
    type: feedbackTOP
    parameters:
      top: null_bg
    position: [1200, -1200]
    inputs:
    - null_cam
  - name: filter_high
    type: audiofilterCHOP
    parameters:
      filter: highpass
      cutofffrequency: 4000
      rolloff: 24
    position: [400, -200]
    inputs:
    - null_trackmono
  - name: merge_bands
    type: mergeCHOP
    parameters:
      autoexportroot: =parent()
    position: [800, 0]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - filter_low
    - filter_mid
    - filter_high
  - name: topto_stats
    type: toptoCHOP
    parameters:
      top: glsl_stats
      rate: =me.time.rate
      autoexportroot: =parent()
    position: [3600, -2000]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: videoin_cam
    type: videodeviceinTOP
    parameters:
      active: =parent.Caleido.par.Camera
      device: V1|||\\?\usb#vid_3277&pid_0010&mi_00#7&df5034d&0&0000#{65e8773d-8f56-11d0-a3b9-00a0c9223196}\global|||0|||0|||ASUS FHD webcam
      signalformat: f1920x1080p-30.00hz
      outputresolution: half
    flags:
    - bypass
    position: [0, -1400]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: glsl_bg_info
    type: infoDAT
    parameters:
      op: glsl_bg
    position: [1525, -1320]
    dock: glsl_bg
    dat_read_only: true
  - name: blur_presence
    type: blurTOP
    parameters:
      size: 6
    position: [3200, -1600]
    inputs:
    - null_presence
  - name: feedback_prev
    type: feedbackTOP
    parameters:
      top: null_cam
    position: [1200, -1600]
    inputs:
    - null_cam
  - name: glsl_bg_pixel
    type: textDAT
    parameters:
      file: project1/caleidoscopic_sonogram_video/sense/glsl_bg_pixel.glsl
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [1675, -1320]
    tags:
    - glsl
    dock: glsl_bg
  - name: glsl_presence
    type: glslmultiTOP
    parameters:
      pixeldat: glsl_presence_pixel
      outputresolution: custom
      resolutionw: 128
      resolutionh: 128
      format: rgba16float
    sequences:
      vec:
      - name: uKey
        valuex: =parent.Caleido.par.Modthreshold
        valuey: =parent.Caleido.par.Modsoftness
        valuez: =parent.Caleido.par.Modkey.menuIndex
        valuew: 0.3
      - name: uMotion
        valuex: =math.exp(-1.0 / max(1.0, parent.Caleido.par.Modtrail * me.time.rate))
        valuey: 0.12
        valuez: 1
        valuew: =float(parent.Caleido.par.Modon)
    position: [2400, -1600]
    inputs:
    - null_cam
    - null_bg
    - feedback_prev
    - feedback_presence
  - name: null_features
    type: nullCHOP
    position: [4800, -400]
    inputs:
    - script_features
  - name: null_presence
    type: nullTOP
    position: [2800, -1600]
    inputs:
    - glsl_presence
  - name: audiodevin_mic
    type: audiodeviceinCHOP
    parameters:
      active: =parent.Caleido.par.Mic
      autoexportroot: =parent()
    flags:
    - bypass
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: null_trackmono
    type: nullCHOP
    position: [-400, 1200]
    inputs:
    - math_mono
  - name: glsl_stats_info
    type: infoDAT
    parameters:
      op: glsl_stats
    position: [3125, -2120]
    dock: glsl_stats
    dat_read_only: true
  - name: moviefilein_mod
    type: moviefileinTOP
    parameters:
      file: =parent.Caleido.par.Videofile.eval() or (app.samplesFolder + '/Map/Count.mov')
      play: =parent.Caleido.par.Modon
      speed: =parent.Caleido.par.Modspeed * (1.0 + parent.Caleido.par.Spinreact * min(1.0, 4.0 * float(op('lag_spin')[0] or 0)))
      index: =me.time.frame
      timecodeop: =tdu.Timecode()
    position: [-800, -1200]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: script_features
    type: scriptCHOP
    parameters:
      callbacks: script_features_callbacks
      autoexportroot: =parent()
    position: [4400, -400]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - merge_bands
    - topto_stats
  - name: glsl_stats_pixel
    type: textDAT
    parameters:
      file: project1/caleidoscopic_sonogram_video/sense/glsl_stats_pixel.glsl
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [3275, -2120]
    tags:
    - glsl
    dock: glsl_stats
  - name: null_micspectrum
    type: nullCHOP
    position: [800, -400]
    inputs:
    - audiospectrum_mic
  - name: audiodevout_track
    type: audiodeviceoutCHOP
    parameters:
      active: =parent.Caleido.par.Play
      volume: =parent.Caleido.par.Trackvolume
      autoexportroot: =parent()
    position: [-800, 1600]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - audiofilein_track
  - name: audiofilein_track
    type: audiofileinCHOP
    parameters:
      file: =parent.Caleido.par.Audiofile.eval() or (app.samplesFolder + '/Audio/JeremyCaulfield_www.dumb-unit.com.mp3')
      play: =parent.Caleido.par.Play
      index: =me.time.frame / root.time.rate
      timecodeop: =tdu.Timecode()
      repeat: ='on' if parent.Caleido.par.Loop else 'off'
      autoexportroot: =parent()
    position: [-1200, 1200]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  - name: audiospectrum_mic
    type: audiospectrumCHOP
    position: [400, -400]
    inputs:
    - audiodevin_mic
  - name: feedback_presence
    type: feedbackTOP
    parameters:
      top: null_presence
    position: [1200, -2000]
    inputs:
    - const_black
  - name: glsl_presence_info
    type: infoDAT
    parameters:
      op: glsl_presence
    position: [2325, -1720]
    dock: glsl_presence
    dat_read_only: true
  - name: null_presence_soft
    type: nullTOP
    position: [3600, -1600]
    inputs:
    - blur_presence
  - name: null_trackspectrum
    type: nullCHOP
    position: [400, 1200]
    inputs:
    - audiospectrum_track
  - name: audiospectrum_track
    type: audiospectrumCHOP
    parameters:
      outlength: 8192
    position: [0, 1200]
    inputs:
    - null_trackmono
  - name: glsl_presence_pixel
    type: textDAT
    parameters:
      file: project1/caleidoscopic_sonogram_video/sense/glsl_presence_pixel.glsl
      language: glsl
      extension: frag
    flags:
    - viewer
    position: [2475, -1720]
    tags:
    - glsl
    dock: glsl_presence
  - name: script_features_callbacks
    type: textDAT
    parameters:
      file: project1/caleidoscopic_sonogram_video/sense/script_features_callbacks.py
      language: python
    flags:
    - viewer
    position: [4400, -520]
    tags:
    - py
    dock: script_features
  annotations:
  - name: annotate1
    mode: annotate
    title: Track bands + video spin (mic parked)
    text: 'null_trackmono -> low < 250 Hz / mid ~1 kHz / high > 4 kHz -> merge_bands for script_features. analyze_low + lag_spin: low-band RMS that speeds up the modulator video (kept outside script_features to avoid a cook loop through the video stats). audiodevin_mic + audiospectrum_mic: the installation''s room microphone, bypassed.'
    position: [-70, -470]
    size: [1400, 1130]
    color: [0.27, 0.12, 0.27]
  - name: annotate2
    mode: annotate
    title: 'Modulator video: mask + motion (128x128)'
    text: 'moviefilein_mod (Video File, speed = Video Speed x low band) -> fit_mod crops to a 128x128 square -> null_cam. glsl_presence: R mask (Key: bright parts / dark parts / difference to the learned background of glsl_bg), G motion trail, B luma. glsl_stats folds it into one pixel -> topto_stats. videoin_cam + res_cam: the installation''s webcam, bypassed.'
    position: [-870, -2190]
    size: [4670, 1250]
    color: [0.08, 0.26, 0.28]
  - name: annotate3
    mode: annotate
    title: Track + video features
    text: 'script_features: low mid high level transient energy (each normalised against the track''s own running floor and peak; energy = slow loudness, the song structure) + presence prox cx cy motion of the video mask, 0-1 each -> null_features.'
    position: [4330, -590]
    size: [670, 450]
    color: [0.28, 0.22, 0.08]
  - name: annotate4
    mode: annotate
    title: 'Track: playback + analysis'
    text: audiofilein_track (Audio File; Play, Loop, Restart) -> audiodevout_track (Volume) and math_mono (average of the channels) -> null_trackmono = the waveform (one frame of samples, read by viz/chopto_scope) -> audiospectrum_track (8192-pt FFT, one sample per Hz) -> null_trackspectrum (viz sonogram).
    position: [-1270, 1130]
    size: [1870, 730]
    color: [0.1, 0.1, 0.12]
- name: parexec_caleido
  type: parameterexecuteDAT
  parameters:
    fromop: =parent()
    op: ..
    pars: '* ^Mon*'
    builtin: false
    file: project1/caleidoscopic_sonogram_video/parexec_caleido.py
    syncfile: true
  position: [600, 800]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
- name: CaleidoscopicSonogramVideoExt
  type: textDAT
  parameters:
    file: project1/caleidoscopic_sonogram_video/CaleidoscopicSonogramVideoExt.py
    language: python
  position: [200, 800]
  tags:
  - py
annotations:
- name: annotate1
  mode: annotate
  title: Control
  text: CaleidoscopicSonogramVideoExt owns the music-video parameter schema (Track, Modulator, Form, Camera, Finish; the installation's pages stay at the end), Restart and Capture Background; parexec_caleido routes pulses/changes to _on<Par> handlers (Mon* monitors excluded).
  position: [130, 730]
  size: [670, 330]
  color: [0.2, 0.2, 0.28]
- name: annotate2
  mode: annotate
  title: 'Pipeline: sense -> viz'
  text: 'sense: the audio file (playback, bands, energy, transients, spectrum, waveform) and the modulator video (mask, motion) -> null_features / null_presence_soft. viz: sonogram/waveform history -> 3D point cloud (sheet, tunnel, disc) -> square 1080x1080 -> out1. The installation''s webcam and microphone stay in sense, bypassed.'
  position: [125, -275]
  size: [1470, 770]
  color: [0.08, 0.2, 0.28]
