/mxGeometry></mxCell><mxCell id="p1-c65" value="Tuning by hand" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5B6875;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="933.3600000000001" y="908" width="106.08000000000001" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p1-c66" value="" style="rounded=1;html=1;fillColor=#F2F7FC;strokeColor=#9CC3E4;" vertex="1" parent="1"><mxGeometry x="1057.44" y="908" width="26" height="16" as="geometry"/></mxCell><mxCell id="p1-c67" value="Python venv" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5B6875;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1091.44" y="908" width="85.92" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p1-c68" value="" style="rounded=1;html=1;fillColor=#FDF6EE;strokeColor=#EBC79E;" vertex="1" parent="1"><mxGeometry x="1195.3600000000001" y="908" width="26" height="16" as="geometry"/></mxCell><mxCell id="p1-c69" value="Blender" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5B6875;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1229.3600000000001" y="908" width="59.040000000000006" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p1-c70" value="1" style="ellipse;html=1;fillColor=#2B7BB9;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="41" y="943" width="18" height="18" as="geometry"/></mxCell><mxCell id="p1-c71" value="Drop a master, stems or MIDI into inbox/&lt;method&gt;/; the method decides how the audio is read." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#18212B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="66" y="944" width="630.24" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p1-c72" value="2" style="ellipse;html=1;fillColor=#2B7BB9;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="41" y="967" width="18" height="18" as="geometry"/></mxCell><mxCell id="p1-c73" value="song/ decodes every file to 48 kHz, checks they line up, and finds hits, tempo and sections." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#18212B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="66" y="968" width="630.24" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p1-c74" value="3" style="ellipse;html=1;fillColor=#6B4FBB;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="41" y="991" width="18" height="18" as="geometry"/></mxCell><mxCell id="p1-c75" value="Method A needs no file: gen/ composes a score and renders an 8-second loop with DawDreamer." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#18212B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="66" y="992" width="623.5200000000001" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p1-c76" value="4" style="ellipse;html=1;fillColor=#2B7BB9;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="41" y="1015" width="18" height="18" as="geometry"/></mxCell><mxCell id="p1-c77" value="Every method writes the same run folder: mix.wav plus controls.json, one schema for all six." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#18212B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="66" y="1016" width="630.24" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p1-c78" value="5" style="ellipse;html=1;fillColor=#0E7A6D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="41" y="1039" width="18" height="18" as="geometry"/></mxCell><mxCell id="p1-c79" value="Headless Blender reads controls.json; mapping.py bakes it into per-frame look signals." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#18212B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="66" y="1040" width="589.9200000000001" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p1-c80" value="6" style="ellipse;html=1;fillColor=#4A5868;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="921.0" y="943" width="18" height="18" as="geometry"/></mxCell><mxCell id="p1-c81" value="The method&#x27;s mapping says which sound drives what; the style sets the tunnel&#x27;s shape and look." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#18212B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="946.0" y="944" width="643.6800000000001" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p1-c82" value="7" style="ellipse;html=1;fillColor=#0E7A6D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="921.0" y="967" width="18" height="18" as="geometry"/></mxCell><mxCell id="p1-c83" value="EEVEE renders the neon tunnel to PNG frames, 1080×1920 at 60 fps (S5)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#18212B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="946.0" y="968" width="482.40000000000003" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p1-c84" value="8" style="ellipse;html=1;fillColor=#0E7A6D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="921.0" y="991" width="18" height="18" as="geometry"/></mxCell><mxCell id="p1-c85" value="PyAV encodes the frames and mix.wav to H.264 and AAC for YouTube (S6)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#18212B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="946.0" y="992" width="482.40000000000003" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p1-c86" value="9" style="ellipse;html=1;fillColor=#0E7A6D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="921.0" y="1015" width="18" height="18" as="geometry"/></mxCell><mxCell id="p1-c87" value="S7 checks format, length, loudness, sync, the loop seam and flashes, then fills output/&lt;method&gt;/." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#18212B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="946.0" y="1016" width="663.84" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p1-c88" value="10" style="ellipse;html=1;fillColor=#C05A1F;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="921.0" y="1039" width="18" height="18" as="geometry"/></mxCell><mxCell id="p1-c89" value="Optional: datapipe tune opens a run in Blender; save it to the run, or as the method&#x27;s default." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#18212B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="946.0" y="1040" width="650.4000000000001" height="16.799999999999997" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Input methods" id="p2"><mxGraphModel dx="1800" dy="1020" grid="1" gridSize="10" guides="1" page="1" pageWidth="1800" pageHeight="1020" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2-lane_gen" value="" style="rounded=1;arcSize=10;html=1;fillColor=#F8FAFC;strokeColor=#E1E6EB;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="192" width="1300" height="96" as="geometry"/></mxCell><mxCell id="p2-lane_master" value="" style="rounded=1;arcSize=10;html=1;fillColor=#F8FAFC;strokeColor=#E1E6EB;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1300" height="96" as="geometry"/></mxCell><mxCell id="p2-lane_stems" value="" style="rounded=1;arcSize=10;html=1;fillColor=#F8FAFC;strokeColor=#E1E6EB;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="408" width="1300" height="96" as="geometry"/></mxCell><mxCell id="p2-lane_midi" value="" style="rounded=1;arcS