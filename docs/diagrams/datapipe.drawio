endArrow=none;html=1;strokeColor=#6B4FBB;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="886" as="sourcePoint"/><mxPoint x="246" y="886" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-c143" value="Timing from notes: exact" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5B6875;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="254" y="878" width="173.28000000000003" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p2-c144" value="" style="endArrow=none;html=1;strokeColor=#2B7BB9;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="445.28000000000003" y="886" as="sourcePoint"/><mxPoint x="471.28000000000003" y="886" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-c145" value="Timing detected in the audio" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5B6875;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="479.28000000000003" y="878" width="200.16000000000003" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p2-c146" value="" style="endArrow=none;html=1;strokeColor=#0E7A6D;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="697.44" y="886" as="sourcePoint"/><mxPoint x="723.44" y="886" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-c147" value="Shared back end" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5B6875;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="731.44" y="878" width="112.80000000000001" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p2-c148" value="1" style="ellipse;html=1;fillColor=#2B7BB9;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="41" y="913" width="18" height="18" as="geometry"/></mxCell><mxCell id="p2-c149" value="The master is what you hear. Stems and MIDI only steer the picture; E without a master plays the stems&#x27; sum." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#18212B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="66" y="914" width="737.7600000000001" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p2-c150" value="2" style="ellipse;html=1;fillColor=#4A5868;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="41" y="937" width="18" height="18" as="geometry"/></mxCell><mxCell id="p2-c151" value="Each method has its own inbox and run folders; datapipe example master|stems|midi shows the layout." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#18212B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="66" y="938" width="677.2800000000001" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p2-c152" value="3" style="ellipse;html=1;fillColor=#6B4FBB;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="41" y="961" width="18" height="18" as="geometry"/></mxCell><mxCell id="p2-c153" value="Purple rows take their timing from notes (the score or MIDI), exact to the frame; blue rows detect it." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#18212B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="66" y="962" width="697.44" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p2-c154" value="4" style="ellipse;html=1;fillColor=#0E7A6D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="921.0" y="913" width="18" height="18" as="geometry"/></mxCell><mxCell id="p2-c155" value="Each method has its own mapping onto the look; the S7 sync gate checks the track the light ring follows." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#18212B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="946.0" y="914" width="710.8800000000001" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p2-c156" value="5" style="ellipse;html=1;fillColor=#4A5868;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="921.0" y="937" width="18" height="18" as="geometry"/></mxCell><mxCell id="p2-c157" value="Songs keep their length: a warning over 60 s, refused over 180 s. A is an 8-second seamless loop." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#18212B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="946.0" y="938" width="663.84" height="16.799999999999997" as="geometry"/></mxCell><mxCell id="p2-c158" value="6" style="ellipse;html=1;fillColor=#0E7A6D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="921.0" y="961" width="18" height="18" as="geometry"/></mxCell><mxCell id="p2-c159" value="Everything after controls.json is one back end: the same Blender look, encode and checks for all six." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#18212B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="946.0" y="962" width="690.72" height="16.799999999999997" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>