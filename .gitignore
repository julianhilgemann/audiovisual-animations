# Pipeline state and media stay local
/inbox/*
!/inbox/.gitkeep
/work/*
!/work/.gitkeep
/cache/*
!/cache/.gitkeep
/output/*
!/output/.gitkeep
/archive/*
!/archive/.gitkeep
/reference/*
!/reference/.gitkeep
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.flac
*.m4a
*.zip

# Blender backups
*.blend1
*.blend2
*.blend@

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Claude Code personal settings
.claude/settings.local.json

# One machine's tool paths (config/machine.example.toml shows the format)
/config/machine.toml

# DawDreamer: VST3 plugins fetched by `datapipe plugins fetch` (dawdreamer/plugins.toml lists them)
/dawdreamer/plugins/
