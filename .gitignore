# Pipeline state and media stay local
/inbox/*
!/inbox/.gitkeep
/work/*
!/work/.gitkeep
/cache/*
!/cache/.gitkeep
/output/*
!/output/.gitkeep
/archive/*
!/archive/.gitkeep
/reference/*
!/reference/.gitkeep
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.flac
*.m4a

# Blender and TouchDesigner backups
*.blend1
*.blend2
*.blend@
touchdesigner/Backup/
CrashAutoSave*

# TouchDesigner, all projects: numbered incremental saves (name.17.toe) and the import cache
*.[0-9]*.toe
TDImportCache/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# OS
Thumbs.db
desktop.ini

# Claude Code personal settings
.claude/settings.local.json

# Embody / Envoy (auto-managed)
Backup/
logs/
.mcp.json
.embody_backup/
.tdn_backup/
opencode.json
.cursor/mcp.json
.vscode/mcp.json
.gemini/settings.json
.codex/config.toml
.agents/mcp_config.json
**/.embody/*
!**/.embody/project.json
.claude/projects/
briefs/
.DS_Store
